---
// 氛围旋钮：拖动旋转全站色相（移植自 params.yml injector.sidebar_end）
// localStorage 键 yzrt-mood-hue，与旧站共享同一持久化
---

<div class="mood-knob-widget widget-wrap card">
  <h3 class="widget-title">氛围旋钮</h3>
  <div class="mk-stage" id="mood-knob" role="slider" tabindex="0"
       aria-label="站点氛围色相" aria-valuemin="0" aria-valuemax="360" aria-valuenow="214">
    <div class="mk-lamp-box" id="mk-lamp-box" aria-hidden="true"></div>
    <div class="mk-ring" aria-hidden="true">
      <div class="mk-ring-inner">
        <div class="mk-knob">
          <div class="mk-pointer-box" id="mk-pointer-box"><div class="mk-pointer" id="mk-pointer"></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="mk-readout"><span class="mk-dot"></span><span id="mk-name">墨蓝 · 214°</span></div>
  <p class="mk-hint">拖动旋转全站色调 · 滚轮微调 · 双击复位</p>
</div>

<style>
  .mood-knob-widget {
    text-align: center;
    padding: 8px 8px 4px;
    background: transparent;
    border: 0;
    box-shadow: none;
  }
  .widget-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: .12em;
    color: var(--color-text-strong);
  }
  .mk-stage {
    --mk-hue: 214;
    position: relative;
    width: 148px;
    height: 148px;
    margin: 18px auto 12px;
    border-radius: 50%;
    touch-action: none;
    cursor: grab;
    background: transparent;
    outline: none;
  }
  .mk-stage:active { cursor: grabbing; }
  .mk-stage:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 6px; }
  .mk-lamp-box { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .mk-lamp-box > div {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 14px;
    height: 132px;
    transform: translateX(-50%) translateY(-50%) rotate(calc(-125deg + 12.6deg * var(--i)));
  }
  .mk-lamp-box span {
    width: 1px;
    height: 7px;
    border-radius: 0;
    background: var(--color-text-faint);
    transition: background .25s ease, height .25s ease;
  }
  .mk-lamp-box span.act {
    height: 12px;
    background: var(--color-accent);
    box-shadow: none;
  }
  .mk-lamp-box span.act::after { content: none; }
  .mk-ring {
    position: absolute;
    inset: 22px;
    border-radius: 50%;
    border: 1px solid var(--color-card-border);
    background: transparent;
  }
  .mk-ring-inner { display: none; }
  .mk-knob { position: absolute; inset: 0; border-radius: 50%; background: transparent; }
  .mk-pointer-box { position: absolute; inset: 0; border-radius: 50%; }
  .mk-pointer {
    position: absolute;
    left: 50%;
    top: 22px;
    width: 1px;
    height: 28px;
    border-radius: 0;
    background: var(--color-accent);
    transform: translateX(-50%);
    box-shadow: none;
  }
  .mk-pointer::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    transform: translate(-50%, 0) rotate(45deg);
  }
  .mk-pointer.off { background: var(--color-text-faint); }
  .mk-pointer.off::after { background: var(--color-text-faint); }
  .mk-readout {
    color: var(--color-text-strong);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: .06em;
  }
  .mk-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    background: var(--color-accent);
    transform: rotate(45deg);
    vertical-align: 1px;
  }
  .mk-hint {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .mk-lamp-box span { transition: none; }
  }
</style>

<script>
  (function () {
    'use strict';
    var stage = document.getElementById('mood-knob');
    if (!stage) return;
    var mkWidget = stage.closest('.mood-knob-widget');
    var lampBox = document.getElementById('mk-lamp-box');
    var pointerBox = document.getElementById('mk-pointer-box');
    var pointer = document.getElementById('mk-pointer');
    var nameEl = document.getElementById('mk-name');
    var MIN = -112.5, MAX = 112.5, TOTAL = 19, DEFAULT_HUE = 214;
    var angle = 0, moodHue = null;
    var lamps = [];
    var i;
    for (i = 0; i < TOTAL; i++) {
      var d = document.createElement('div');
      d.style.setProperty('--i', String(i));
      var s = document.createElement('span');
      d.appendChild(s);
      lampBox.appendChild(d);
      lamps.push(s);
    }
    var VARS = ['--red-0', '--red-1', '--red-2', '--red-3', '--red-4', '--red-5', '--red-5-5', '--red-6', '--color-red-6-shadow', '--color-red-3-shadow'];
    var cs = getComputedStyle(document.documentElement);
    var snapshot = {};
    VARS.forEach(function (v) { snapshot[v] = cs.getPropertyValue(v).trim(); });
    function hsl(h, sa, l) { return 'hsl(' + h + ', ' + sa + '%, ' + l + '%)'; }
    // 感知曲线：黄绿段（≈100°）天然显荧光，压低饱和；红/蓝两端可加浓到 66%
    function satCap(h) {
      var d = Math.abs(h - 100);
      if (d > 180) d = 360 - d;
      return 44 + Math.round((d / 180) * 22);
    }
    function applyHue(hue) {
      var root = document.documentElement;
      var dark = root.dataset.theme === 'dark';
      mkWidget.style.setProperty('--mk-hue', String(hue));
      var sat = satCap(hue);
      if (dark) {
        root.style.setProperty('--red-0', hsl(hue, Math.min(sat, 54), 70));
        root.style.setProperty('--red-1', hsl(hue, Math.min(sat, 54), 70));
        root.style.setProperty('--red-2', hsl(hue, Math.min(sat, 50), 78));
        root.style.setProperty('--red-3', hsl(hue, 34, 58));
        root.style.setProperty('--red-4', 'hsla(' + hue + ', 46%, 72%, 0.5)');
        root.style.setProperty('--red-5', 'hsla(' + hue + ', 46%, 72%, 0.16)');
        root.style.setProperty('--red-5-5', 'hsla(' + hue + ', 46%, 72%, 0.06)');
        root.style.setProperty('--red-6', 'hsla(' + hue + ', 46%, 72%, 0.22)');
      } else {
        root.style.setProperty('--red-0', hsl(hue, sat, 23));
        root.style.setProperty('--red-1', hsl(hue, Math.min(sat + 2, 68), 32));
        root.style.setProperty('--red-2', hsl(hue, Math.min(sat, 62), 44));
        root.style.setProperty('--red-3', hsl(hue, Math.max(sat - 10, 30), 60));
        root.style.setProperty('--red-4', hsl(hue, 50, 88));
        root.style.setProperty('--red-5', hsl(hue, 46, 94));
        root.style.setProperty('--red-5-5', hsl(hue, 38, 96.5));
        root.style.setProperty('--red-6', hsl(hue, 30, 98));
        root.style.setProperty('--color-red-6-shadow', 'hsla(' + hue + ', 55%, 32%, 0.45)');
        root.style.setProperty('--color-red-3-shadow', 'hsla(' + hue + ', 55%, 32%, 0.22)');
      }
    }
    function nameOf(h) {
      if (h >= 340) return '胭脂';
      var names = ['朱砂', '橘红', '琥珀', '缃色', '苔色', '竹青', '青翠', '豆绿', '湖绿', '沧浪', '墨蓝', '黛蓝', '绀青', '绀紫', '雪青', '紫檀', '葡萄紫'];
      return names[Math.min(16, Math.floor(h / 20))];
    }
    function update(a, save) {
      if (a < MIN) a = MIN;
      if (a > MAX) a = MAX;
      angle = a;
      var p = (a - MIN) / (MAX - MIN);
      var n = Math.round(p * TOTAL);
      lamps.forEach(function (sp, idx) { sp.classList.toggle('act', idx < n); });
      pointerBox.style.rotate = a + 'deg';
      pointer.classList.toggle('off', a <= MIN);
      moodHue = Math.round(p * 360);
      applyHue(moodHue);
      stage.setAttribute('aria-valuenow', String(moodHue));
      stage.setAttribute('aria-valuetext', nameOf(moodHue) + ' ' + moodHue + ' 度');
      nameEl.textContent = nameOf(moodHue) + ' · ' + moodHue + '°';
      if (save !== false) {
        try { localStorage.setItem('yzrt-mood-hue', String(moodHue)); } catch (e) {}
      }
    }
    function reset() {
      var root = document.documentElement;
      VARS.forEach(function (v) { root.style.setProperty(v, snapshot[v]); });
      moodHue = null;
      try { localStorage.removeItem('yzrt-mood-hue'); } catch (e) {}
      angle = MIN + (DEFAULT_HUE / 360) * (MAX - MIN);
      var p = (angle - MIN) / (MAX - MIN);
      var n = Math.round(p * TOTAL);
      lamps.forEach(function (sp, idx) { sp.classList.toggle('act', idx < n); });
      pointerBox.style.rotate = angle + 'deg';
      pointer.classList.remove('off');
      mkWidget.style.setProperty('--mk-hue', String(DEFAULT_HUE));
      stage.setAttribute('aria-valuenow', String(DEFAULT_HUE));
      stage.setAttribute('aria-valuetext', '墨蓝 默认 214 度');
      nameEl.textContent = '墨蓝 · 默认';
    }
    var dragging = false, startY = 0, startA = 0;
    stage.addEventListener('pointerdown', function (e) {
      dragging = true;
      startY = e.clientY;
      startA = angle;
      if (stage.setPointerCapture) stage.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    stage.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      update(startA + (startY - e.clientY) / 2);
    });
    stage.addEventListener('pointerup', function () { dragging = false; });
    stage.addEventListener('pointercancel', function () { dragging = false; });
    stage.addEventListener('wheel', function (e) {
      e.preventDefault();
      update(angle + (e.deltaY > 0 ? -5 : 5));
    }, { passive: false });
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowUp' || e.key === 'ArrowRight') { e.preventDefault(); update(angle + 4.5); }
      else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') { e.preventDefault(); update(angle - 4.5); }
      else if (e.key === 'PageUp') { e.preventDefault(); update(angle + 22.5); }
      else if (e.key === 'PageDown') { e.preventDefault(); update(angle - 22.5); }
      else if (e.key === 'Home') { e.preventDefault(); update(MIN); }
      else if (e.key === 'End') { e.preventDefault(); update(MAX); }
    });
    stage.addEventListener('dblclick', reset);
    function restore() {
      var saved = null;
      try { saved = localStorage.getItem('yzrt-mood-hue'); } catch (e) {}
      var hue = saved === null ? NaN : parseInt(saved, 10);
      if (!isNaN(hue) && hue > 0 && hue <= 360) {
        update(MIN + (hue / 360) * (MAX - MIN), false);
      } else {
        reset();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { setTimeout(restore, 0); });
    } else {
      setTimeout(restore, 0);
    }
    window.addEventListener('load', function () {
      setTimeout(function () { if (moodHue !== null) applyHue(moodHue); }, 0);
    });
    new MutationObserver(function () {
      if (moodHue !== null) applyHue(moodHue);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
