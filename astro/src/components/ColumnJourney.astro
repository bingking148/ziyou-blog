---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '../utils/columns.ts';

interface Props {
  posts: CollectionEntry<'post'>[];
  total: number;
}
const { posts } = Astro.props;
const num = (w?: number) => String(w ?? 0).padStart(2, '0');
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<section class="journey" data-journey aria-label="阅读顺序">
  <div class="journey-rule" aria-hidden="true">
    <svg viewBox="0 0 2 100" preserveAspectRatio="none">
      <line class="journey-line" data-journey-line x1="1" y1="0" x2="1" y2="100" pathLength="1" />
    </svg>
  </div>
  <ol class="journey-list">
    {posts.map((p) => (
      <li class="journey-item" data-journey-item>
        <a class="journey-card" href={postUrl(p)}>
          <span class="journey-number">{num(p.data.weight)}</span>
          <span class="journey-title">{p.data.title}</span>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-journey]');
    if (!root) return;
    root.classList.add('is-enhanced');
    var line = root.querySelector('[data-journey-line]');
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-journey-item]'));
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    function paint(progress) {
      if (line) line.style.strokeDashoffset = String(1 - progress);
      var gate = window.innerHeight * 0.72;
      items.forEach(function (el) {
        el.classList.toggle('is-reached', el.getBoundingClientRect().top < gate);
      });
    }
    function update() {
      if (reduced.matches) { paint(1); return; }
      var rect = root.getBoundingClientRect();
      var total = root.offsetHeight || 1;
      var seen = Math.max(0, Math.min(total, gateSeen(rect, total)));
      paint(seen / total);
    }
    function gateSeen(rect, total) {
      return Math.min(total, Math.max(0, window.innerHeight * 0.72 - rect.top));
    }
    if (reduced.matches) {
      paint(1);
      return;
    }
    var ticking = false;
    function schedule() {
      if (!ticking) ticking = true, requestAnimationFrame(function () { ticking = false; update(); });
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  })();
</script>

<style>
  .journey { position: relative; margin: 48px 0 24px; padding-left: 28px; }
  .journey-rule { position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; }
  .journey-rule svg { width: 2px; height: 100%; display: block; }
  .journey-line {
    stroke: var(--color-accent); stroke-width: 2; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1;
  }
  .journey-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .journey-card {
    display: grid; grid-template-columns: 42px minmax(0, 1fr) auto; gap: 16px; align-items: baseline;
    padding: 16px 4px; border-bottom: 1px solid var(--color-card-border); color: var(--color-text-strong);
  }
  .journey-number { color: var(--color-accent); font-size: 13px; }
  .journey-title { font-family: var(--font-serif); font-size: 18px; line-height: 1.5; }
  .journey-card time { color: var(--color-text-muted); font-size: 13px; }
  .journey-card:hover .journey-title { color: var(--color-accent); }
  @media (max-width: 640px) {
    .journey-card { grid-template-columns: 36px minmax(0, 1fr); }
    .journey-card time { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey-line { stroke-dashoffset: 0; }
    .journey-item { opacity: 1; }
  }
</style>
