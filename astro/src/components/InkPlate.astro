---
interface Props {
  seed: string;
}
const { seed } = Astro.props;
function hash(input: string) {
  let h = 2166136261;
  for (let i = 0; i < input.length; i++) h = Math.imul(h ^ input.charCodeAt(i), 16777619);
  return h >>> 0;
}
const h = hash(seed || 'ziyou');
const unit = (i: number) => ((h >>> ((i * 5) % 24)) & 255) / 255;
const strokes = [0, 1, 2].map((i) => {
  const y = 22 + unit(i) * 56;
  const x1 = 10 + unit(i + 3) * 16;
  const x2 = 58 + unit(i + 5) * 30;
  const bend = (unit(i + 1) - 0.5) * 28;
  return `M ${x1.toFixed(1)} ${y.toFixed(1)} Q ${(30 + bend).toFixed(1)} ${(y + bend * 0.4).toFixed(1)} ${x2.toFixed(1)} ${(y + bend * 0.15).toFixed(1)}`;
});
const accent = strokes[unit(7) > 0.5 ? 0 : 2];
---

<svg class="ink-plate-svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <rect width="100" height="100" fill="var(--plate-paper, var(--color-surface-muted))" />
  <rect x="6" y="6" width="88" height="88" fill="none" stroke="var(--color-card-border)" />
  {strokes.map((d) => <path d={d} fill="none" stroke="var(--color-text-strong)" stroke-width="1.15" stroke-linecap="round" />)}
  <path d={accent} fill="none" stroke="var(--color-accent)" stroke-width="1.7" stroke-linecap="round" />
  <circle cx={14 + unit(8) * 8} cy={78 + unit(9) * 8} r="1.3" fill="var(--color-accent)" />
</svg>

<style>
  .ink-plate-svg { display: block; width: 100%; height: 100%; }
</style>
