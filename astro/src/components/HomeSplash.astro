<script is:inline>
  (function () {
    var root = document.getElementById('home-splash');
    if (!root) return;
    var html = document.documentElement;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!html.classList.contains('splash-pending') || reduce) {
      html.classList.remove('splash-pending');
      root.remove();
      return;
    }
    var done = false;
    function onKey(e) {
      if (e.key === 'Escape') finish();
    }
    function finish() {
      if (done) return;
      done = true;
      window.removeEventListener('keydown', onKey);
      html.classList.remove('splash-pending');
      root.remove();
    }
    root.addEventListener('animationend', function (e) {
      if (e.target !== root) return;
      if (String(e.animationName).indexOf('yz-splash-out') === -1) return;
      finish();
    });
    window.addEventListener('keydown', onKey);
    window.setTimeout(finish, 2400);
  })();
</script>

<style is:global>
  html.splash-pending,
  html.splash-pending body {
    overflow: hidden;
  }
  .yz-splash {
    --splash-ink: #1e1e1e;
    --splash-paper: #fffcf7;
    --splash-blush: #f6d7d3;
    --splash-red: #c41e3a;
    position: fixed;
    inset: 0;
    z-index: 620;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    overflow: hidden;
    animation: yz-splash-out 2s linear forwards;
  }
  html:not(.splash-pending) .yz-splash { display: none; }
  [data-theme="dark"] .yz-splash {
    --splash-ink: #f4f1ea;
    --splash-paper: #171717;
    --splash-blush: #5c2e36;
    --splash-red: #c41e3a;
  }
  .yz-splash-stage {
    width: min(88%, 560px);
    animation: yz-splash-in .42s cubic-bezier(.2, .8, .2, 1) both;
  }
  .yz-splash-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .yz-splash-card { fill: var(--splash-paper); }
  .yz-splash-blush { fill: var(--splash-blush); }
  .yz-splash-line {
    fill: none;
    stroke: var(--splash-ink);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .yz-splash-word { fill: var(--splash-ink); }
  .yz-splash-kicker {
    fill: none;
    stroke: var(--splash-red);
    stroke-width: 5;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    animation: yz-splash-kicker .24s cubic-bezier(.2, .8, .2, 1) 1.08s both;
  }
  .yz-splash-kicker path:last-child { stroke-width: 3.2; }
  .yz-splash-dot {
    fill: var(--splash-red);
    transform-box: fill-box;
    transform-origin: center;
    animation: yz-splash-dot .88s linear .24s both;
  }
  @keyframes yz-splash-in {
    from { opacity: 0; transform: translate3d(0, 14px, 0) rotate(-1.4deg) scale(.97); }
    to { opacity: 1; transform: translate3d(0, 0, 0) rotate(-.6deg) scale(1); }
  }
  @keyframes yz-splash-dot {
    0% { opacity: 0; transform: translate3d(0, -30vh, 0) scale(.42); }
    14% { opacity: 1; }
