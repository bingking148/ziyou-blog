    animation: yz-rule .32s cubic-bezier(.2, .8, .2, 1) .62s forwards;
  }
  @keyframes yz-rule { to { transform: scaleX(1); } }
  @keyframes yz-fade { to { opacity: 1; } }
  .yz-lock {
