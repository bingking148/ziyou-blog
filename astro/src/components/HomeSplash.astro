<div id="home-splash" class="yz-splash" aria-hidden="true" inert data-splash-ms="2700">
  <div class="yz-splash-paper"></div>
  <div class="yz-splash-plate">
    <i class="yz-c yz-c-tl"></i>
    <i class="yz-c yz-c-tr"></i>
    <i class="yz-c yz-c-bl"></i>
    <i class="yz-c yz-c-br"></i>
    <div class="yz-ticks" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <span class="yz-chip">N°01</span>
    <i class="yz-rule"></i>
    <div class="yz-lock">
      <svg class="yz-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path d="M14 2v24M2 14h24M5.5 5.5l17 17M5.5 22.5l17-17" stroke="currentColor" stroke-width="1.2" />
        <circle cx="14" cy="14" r="4" stroke="currentColor" stroke-width="1.2" />
      </svg>
      <div class="yz-word">
        <span class="yz-ghost" aria-hidden="true">ZIYOU</span>
        <span class="yz-set">ZIYOU</span>
        <i class="yz-bar"></i>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var root = document.getElementById('home-splash');
    if (!root) return;
    var html = document.documentElement;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!html.classList.contains('splash-pending') || reduce) {
      html.classList.remove('splash-pending');
      root.remove();
      return;
    }
    var paper = root.querySelector('.yz-splash-paper');
    var plate = root.querySelector('.yz-splash-plate');
    var lock = root.querySelector('.yz-lock');
    var done = false;
    var backup = setTimeout(finish, 3200);
    var flyTimer = setTimeout(fly, 2000);
    var endTimer = setTimeout(finish, 2700);

    function fly() {
      var brand = document.querySelector('.site-brand');
      if (!brand || !lock) return;
      var lr = lock.getBoundingClientRect();
      var br = brand.getBoundingClientRect();
      if (!lr.width || !br.width) return;
      var dx = (br.left + br.width / 2) - (lr.left + lr.width / 2);
      var dy = (br.top + br.height / 2) - (lr.top + lr.height / 2);
      var s = Math.max(0.12, Math.min(0.85, br.width / lr.width));
      lock.style.transition = 'transform .64s cubic-bezier(.16, .84, .3, 1)';
      paper.style.animation = 'yz-paper .68s linear forwards';
      plate.classList.add('is-leaving');
      requestAnimationFrame(function () {
        lock.style.transform = 'translate(calc(-50% + ' + dx.toFixed(1) + 'px), calc(-50% + ' + dy.toFixed(1) + 'px)) scale(' + s.toFixed(3) + ')';
        paper.style.opacity = '0';
      });
    }
    function onKey(e) { if (e.key === 'Escape') finish(); }
    function finish() {
      if (done) return;
      done = true;
      clearTimeout(backup);
      clearTimeout(flyTimer);
      clearTimeout(endTimer);
      window.removeEventListener('keydown', onKey);
      html.classList.remove('splash-pending');
      root.remove();
    }
    window.addEventListener('keydown', onKey);
  })();
</script>
<style is:global>
  html.splash-pending,
  html.splash-pending body { overflow: hidden; }
  .yz-splash {
