    gap: 14px;
    transform: translate(-50%, -50%);
    transform-origin: center center;
  }
  .yz-mark {
    width: 64px;
    height: 64px;
    flex: none;
    color: var(--color-text-strong);
    transform: scale(.15);
    opacity: 0;
    animation: yz-mark .34s cubic-bezier(.2, 1.35, .35, 1) both;
  }
  @keyframes yz-mark { to { transform: none; opacity: 1; } }
  .yz-word { position: relative; min-width: 0; }
  .yz-ghost {
    position: absolute;
    left: 50%;
    top: 46%;
    z-index: 0;
    margin: 0;
