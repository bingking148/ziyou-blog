    visibility: hidden;
    animation: yz-ghost .32s cubic-bezier(.2, .7, .2, 1) .9s forwards;
  }
  @keyframes yz-ghost {
    0% { opacity: 0; visibility: hidden; -webkit-text-stroke-width: 2px; transform: translate(-50%, -50%) scale(1.12); }
    18% { opacity: 1; visibility: visible; -webkit-text-stroke-width: 2px; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; visibility: visible; -webkit-text-stroke-width: 2px; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; visibility: hidden; -webkit-text-stroke-width: 0; transform: translate(-50%, -50%) scale(.92); }
  }
  .yz-set {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1;
    letter-spacing: .2em;
