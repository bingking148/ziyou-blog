<style is:global>
  html.splash-pending,
  html.splash-pending body { overflow: hidden; }
  .yz-splash {
    --splash-ink: #1e1e1e;
    --splash-red: #c41e3a;
    --splash-blush: #f6d7d3;
    position: fixed;
    inset: 0;
    z-index: 620;
    pointer-events: auto;
    background: transparent;
  }
  html:not(.splash-pending) .yz-splash { display: none; }
  [data-theme="dark"] .yz-splash {
    --splash-ink: #f4f1ea;
    --splash-blush: #5c2e36;
    --splash-red: #c41e3a;
  }
  .yz-splash-paper {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
  }
  #yz-splash-canvas {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(92vw, 680px);
    height: auto;
    aspect-ratio: 760 / 420;
    transform: translate(-50%, -50%);
    transform-origin: 50% 48%;
  }
  @media (prefers-reduced-motion: reduce) {
    html.splash-pending,
    html.splash-pending body { overflow: visible; }
    .yz-splash { display: none !important; }
  }
</style>
