    transform: scaleX(0);
    transform-origin: left center;
    animation: yz-bar .2s cubic-bezier(.2, .9, .3, 1.15) 1.5s forwards;
  }
  @keyframes yz-bar { to { transform: scaleX(1); } }
  .yz-splash-plate.is-leaving .yz-c,
  .yz-splash-plate.is-leaving .yz-ticks,
  .yz-splash-plate.is-leaving .yz-chip,
  .yz-splash-plate.is-leaving .yz-rule,
  .yz-splash-plate.is-leaving .yz-bar {
    animation: none;
    transition: opacity .2s ease;
    opacity: 0;
  }
  .yz-splash-plate.is-leaving .yz-ghost {
    animation: none;
    opacity: 0;
    visibility: hidden;
    -webkit-text-stroke-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    html.splash-pending,
    html.splash-pending body { overflow: visible; }
    .yz-splash { display: none !important; }
    .yz-mark, .yz-set, .yz-ghost, .yz-bar, .yz-c, .yz-ticks, .yz-chip, .yz-rule { animation: none !important; }
  }
</style>
