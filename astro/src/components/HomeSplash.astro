    white-space: nowrap;
    padding-right: .15em;
    animation: yz-set .28s cubic-bezier(.2, .8, .2, 1) 1.26s forwards;
  }
  @keyframes yz-set { to { max-width: 9em; opacity: 1; } }
  .yz-bar {
    display: block;
    width: 64px;
    height: 8px;
    margin-top: 12px;
