  }
  .yz-c-tl { left: 0; top: 0; border-top-width: 3px; border-left-width: 3px; animation: yz-in-tl .38s cubic-bezier(.2, .8, .2, 1) .35s forwards; }
  .yz-c-tr { right: 0; top: 0; border-top-width: 3px; border-right-width: 3px; animation: yz-in-tr .38s cubic-bezier(.2, .8, .2, 1) .42s forwards; }
  .yz-c-bl { left: 0; bottom: 0; border-bottom-width: 3px; border-left-width: 3px; animation: yz-in-bl .38s cubic-bezier(.2, .8, .2, 1) .48s forwards; }
  .yz-c-br { right: 0; bottom: 0; border-bottom-width: 3px; border-right-width: 3px; border-color: #c41e3a; animation: yz-in-br .38s cubic-bezier(.2, .8, .2, 1) .54s forwards; }
  @keyframes yz-in-tl { from { opacity: 0; transform: translate(-16px, -16px); } to { opacity: 1; transform: none; } }
  @keyframes yz-in-tr { from { opacity: 0; transform: translate(16px, -16px); } to { opacity: 1; transform: none; } }
  @keyframes yz-in-bl { from { opacity: 0; transform: translate(-16px, 16px); } to { opacity: 1; transform: none; } }
