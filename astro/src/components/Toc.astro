---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// Hugo 配置 startLevel=1, endLevel=2 → 只保留 h1/h2；文章内一般是 h2/h3，兼容两种
const minDepth = Math.min(...headings.map((h) => h.depth));
const items = headings.filter((h) => h.depth <= Math.max(2, minDepth + 1));
---

{items.length > 0 && (
  <nav class="toc-widget widget-wrap card" aria-label="文章目录">
    <h3 class="widget-title">目录</h3>
    <ul class="toc-list">
      {items.map((h) => (
        <li class:list={['toc-item', `toc-depth-${h.depth}`]}>
          <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-widget { padding: 18px 16px; }
  .widget-title {
    margin: 0 0 10px;
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--color-text-strong);
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 60vh;
    overflow-y: auto;
  }
  .toc-item { margin: 2px 0; }
  .toc-item[class*="depth-3"] .toc-link { padding-left: 16px; font-size: 13px; }
  .toc-link {
    display: block;
    padding: 5px 10px;
    border-left: 2px solid transparent;
    border-radius: 0 8px 8px 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toc-link:hover { color: var(--red-1); background: var(--red-5); }
  .toc-link.is-active {
    color: var(--red-1);
    border-left-color: var(--red-1);
    background: var(--red-5);
    font-weight: 600;
  }
</style>

<script>
  (function () {
    'use strict';
    var nav = document.querySelector('.toc-widget');
    if (!nav) return;
    // 只管理当前侧栏；移动端的 details 目录有自己的独立链接。
    var links = nav.querySelectorAll('.toc-link');
    if (!nav || !links.length) return;
    var map = {};
    var slugs = [];
    Array.prototype.forEach.call(links, function (l) {
      var slug = l.getAttribute('data-toc-slug');
      if (slug) { map[slug] = l; slugs.push(slug); }
    });
    var headings = [];
    slugs.forEach(function (slug) {
      var el = document.getElementById(slug);
      if (el) headings.push(el);
    });
    if (!headings.length) return;
    var list = nav.querySelector('.toc-list');
    var active = null;
    // 阅读线：视口顶部往下 25% 处；取线上方最后一个标题作为当前章节。
    // IntersectionObserver 方案在长文里会漏掉「刚读完的章节」，尤其手机端 rootMargin 计算误差大。
    function readLine() { return (window.innerHeight || 800) * 0.25 + 80; }
    function update() {
      var line = readLine();
      var current = headings[0];
      for (var i = 0; i < headings.length; i++) {
        var top = headings[i].getBoundingClientRect().top;
        if (top <= line) current = headings[i];
        else break;
      }
      var link = map[current.id];
      if (link === active) return;
      if (active) {
        active.classList.remove('is-active');
        active.removeAttribute('aria-current');
      }
      active = link;
      if (link) {
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'true');
        // 长目录内部跟随：把激活项滚进可视区，但不让目录抢走页面滚动
        if (list && list.scrollHeight > list.clientHeight) {
          var lr = link.getBoundingClientRect();
          var vr = list.getBoundingClientRect();
          if (lr.top < vr.top || lr.bottom > vr.bottom) {
            list.scrollTop += lr.top - vr.top - vr.height / 2 + lr.height / 2;
          }
        }
      }
    }
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', onScroll);
    update();
  })();
</script>
