---
/**
 * UDL 小节渲染：配对块流
 * - body/note：桌面左英右中同高对照；移动端英文在上中文在下
 * - figure/equation：跨全栏渲染一次（图注中英合并显示）
 */
import { publicImageSize } from '../utils/imgSize.ts';

interface Props {
  pairs: any[];
  dropcap?: boolean; // 本节第一个中文 body 段应用首字下沉
}
const { pairs, dropcap = false } = Astro.props;

let zhBodySeen = false;
const rows = pairs.map((p) => {
  const row = { ...p };
  if (p.kind === 'body' && p.zh?.length && !zhBodySeen) {
    zhBodySeen = true;
    row.drop = dropcap;
  }
  return row;
});

const FUSE = ['figure', 'equation', 'eqimg'];
const isAnchor = (b: any) => !!b && FUSE.includes(b.type);
// 配对组里常把图/公式和前后正文捆在一起。按锚点拆开，图和公式仍单独跨栏，正文对齐保持原样。
const flat = rows.flatMap((p) => {
  if (FUSE.includes(p.kind)) return [p];
  const en = p.en || [];
  const zh = p.zh || [];
  const out: any[] = [];
  let i = 0;
  let j = 0;
  let dropLeft = !!p.drop;
  while (i < en.length || j < zh.length) {
    const eb = en[i];
    const zb = zh[j];
    if (isAnchor(eb) && isAnchor(zb) && eb.type === zb.type) {
      out.push({ kind: eb.type, en: [eb], zh: [zb] });
      i++; j++;
      continue;
    }
    if (isAnchor(eb) && (!zb || !isAnchor(zb) || eb.type !== zb.type)) {
      out.push({ kind: eb.type, en: [eb] });
      i++;
      continue;
    }
    if (isAnchor(zb)) {
      out.push({ kind: zb.type, zh: [zb] });
      j++;
      continue;
    }
    const er: any[] = [];
    const zr: any[] = [];
    while (i < en.length && !isAnchor(en[i])) er.push(en[i++]);
    while (j < zh.length && !isAnchor(zh[j])) zr.push(zh[j++]);
    if (!er.length && !zr.length) break;
    const row: any = { kind: 'body', en: er, zh: zr };
    if (dropLeft && zr.some((b) => b.type !== 'note')) { row.drop = true; dropLeft = false; }
    out.push(row);
  }
  return out;
});
---

{flat.map((p) => {
  const cleanTex = (raw: string, hasImg = false) => {
    let t = (raw || '').trim();
    const blank = t.search(/\n\s*\n/);
    if (blank > 0) t = t.slice(0, blank).trim();
    t = t.replace(/\n?\*\*Note:[\s\S]*$/, '').trim();
    t = t.replace(/\$\$\s*$/, '').replace(/^\$\$/, '').trim();
    // 残片公式（如只剩 “h_1^T, h_2^T]”）改走原书裁图，避免 KaTeX 失败后把图盖掉。
    if (hasImg && t.length < 80 && !t.includes('=') && !t.includes('\\begin')) return '';
    return t;
  };
  if (FUSE.includes(p.kind)) {
    const b = (p.en ?? p.zh ?? [])[0];
    if (!b) return null;
    if (p.kind === 'figure') {
      return (
        <figure class="udl-fig">
          <img src={b.img} alt={(p.zh?.[0]?.text ?? p.en?.[0]?.text ?? '').replace(/<[^>]+>/g, '').slice(0, 80)} loading="lazy" {...publicImageSize(b.img)} />
          {(p.zh?.[0]?.text || p.en?.[0]?.text) && (
            <figcaption>
              {p.zh?.[0]?.text && <span class="cap-zh" set:html={p.zh[0].text} />}
              {p.en?.[0]?.text && <span class="cap-en" set:html={p.en[0].text} />}
            </figcaption>
          )}
        </figure>
      );
    }
    const img = (p.en?.[0]?.img || p.zh?.[0]?.img) as string | undefined;
    const tex = cleanTex((p.en?.[0]?.latex || p.zh?.[0]?.latex || '') as string, !!img);
    if (tex) return <div class="udl-eq" data-tex={tex} />;
    if (img) return <div class="udl-eqimg"><img src={img} alt="公式" loading="lazy" {...publicImageSize(img)} /></div>;
    return null;
  }
  const block = (b: any, lang: 'en' | 'zh', dropcapOn: boolean) => {
    if (b.type === 'figure' && b.img) {
      return (
        <figure class="udl-fig">
          <img src={b.img} alt={(b.text || '').replace(/<[^>]+>/g, '').slice(0, 80)} loading="lazy" {...publicImageSize(b.img)} />
          {b.text && <figcaption><span class={lang === 'zh' ? 'cap-zh' : 'cap-en'} set:html={b.text} /></figcaption>}
        </figure>
      );
    }
    if (b.type === 'equation' || b.type === 'eqimg') {
      const tex = cleanTex(b.latex || '', !!b.img);
      if (tex) return <div class="udl-eq" data-tex={tex} />;
      if (b.img) return <div class="udl-eqimg"><img src={b.img} alt="公式" loading="lazy" {...publicImageSize(b.img)} /></div>;
      return null;
    }
    if (!b.text) return null;
    if (b.type === 'note') return <aside class="udl-note" set:html={b.text} />;
    return <p class:list={['udl-p', lang === 'zh' ? 'udl-zh' : 'udl-en', { 'udl-drop': dropcapOn }]} set:html={b.text} />;
  };
  return (
    <div class="udl-row" data-kind={p.kind}>
      <div class="cell cell-en">{p.en?.map((b) => block(b, 'en', false))}</div>
      <div class="cell cell-zh">{p.zh?.map((b, bi) => block(b, 'zh', !!(p.drop && bi === 0 && b.type !== 'note')))}</div>
    </div>
  );
})}

<style>
  .udl-row { display: grid; grid-template-columns: 1fr 1fr; column-gap: 46px; align-items: start; }
  .cell { min-width: 0; }
  .udl-p { margin: 0 0 16px; text-align: justify; }
  .udl-p.udl-en { font-size: 13px; line-height: 1.85; color: var(--color-text-muted); }
  .udl-p.udl-zh { font-size: 15px; line-height: 2; text-indent: 2em; }
  /* 行内数学：数学斜体 + 上下标 */
  .udl-p :global(.imath), .udl-note :global(.imath) {
    font-family: 'Latin Modern Math', 'Cambria Math', Georgia, serif;
    font-style: italic;
  }
  .udl-p :global(.imath sub), .udl-p :global(.imath sup),
  .udl-note :global(.imath sub), .udl-note :global(.imath sup) {
    font-size: .72em; font-style: normal;
  }
  .udl-p.udl-drop::first-letter {
    float: left; font-size: 2.9em; line-height: .95; padding: 4px 8px 0 0;
    color: var(--color-accent); font-weight: 700;
  }
  .udl-note {
    font-size: 11.5px; color: var(--color-text-faint); line-height: 1.8;
    border-top: 1px solid var(--color-card-border); padding-top: 8px; margin: 14px 0 16px;
  }
  .udl-fig { margin: 18px 0 22px; text-align: center; }
  .udl-fig img {
    display: block; width: min(100%, 760px); height: auto; margin: 0 auto;
    max-width: 100%; border: 1px solid var(--color-card-border); background: var(--color-surface);
    padding: 6px; border-radius: 2px;
  }
  .udl-fig figcaption { margin-top: 9px; line-height: 1.75; }
  .cap-zh { display: block; font-size: 11.5px; color: var(--color-text-faint); font-style: italic; }
  .cap-en { display: block; font-size: 11px; color: var(--color-text-faint); font-style: italic; margin-top: 4px; }
  .udl-eq { text-align: center; margin: 16px 0 20px; overflow-x: auto; }
  /* 父级 overflow 不是 visible 时，KaTeX 的 MathML 旁白会漏出来。 */
  .udl-eq :global(.katex-mathml) {
    position: absolute !important;
    clip: rect(1px, 1px, 1px, 1px);
    clip-path: inset(50%);
    width: 1px; height: 1px; overflow: hidden;
    border: 0; padding: 0;
  }
  .udl-eq.katex-fallback::before { content: attr(data-tex); font-family: Georgia, serif; font-style: italic; }
  .udl-eqimg { text-align: center; margin: 14px 0 18px; }
  .udl-eqimg img {
    max-width: 100%; height: auto;
    /* 白底图融入米色纸面：multiply 让白色变透明效果 */
    mix-blend-mode: multiply;
  }
  :global([data-theme="dark"]) .udl-eqimg img {
    mix-blend-mode: screen;
    filter: invert(1) hue-rotate(180deg);
  }
  @media (max-width: 960px) {
    .udl-row { grid-template-columns: 1fr; column-gap: 0; }
    .cell-en { border-bottom: 1px dashed var(--color-card-border); padding-bottom: 10px; margin-bottom: 12px; }
    .udl-p.udl-en { font-size: 12.5px; }
    .udl-p.udl-zh { font-size: 14.5px; line-height: 1.95; }
    .udl-p.udl-drop::first-letter { font-size: 2.3em; }
  }
</style>
