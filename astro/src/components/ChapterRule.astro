---
interface Props {
  no: string;
  label: string;
  en?: string;
  value?: string;
  title?: string;
  lede?: string;
}
const { no, label, en, value, title, lede } = Astro.props;
---
<header class="chapter-rule" data-reveal>
  <p class="cr-line-row">
    <span class="cr-no">{no}</span>
    <span class="cr-label">{label}{en && <> / {en}</>}</span>
    <span class="cr-line" aria-hidden="true"></span>
    {value && <span class="cr-value">{value}</span>}
  </p>
  {title && (
    <div class="cr-head">
      <h1 class="cr-title">{title}</h1>
      {lede && <p class="cr-lede">{lede}</p>}
    </div>
  )}
</header>

<style>
  .chapter-rule {
    margin: 0;
    padding: 88px 0 0;
    color: var(--color-text-muted);
  }
  .cr-line-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-code);
    font-size: 11px;
    letter-spacing: .18em;
  }
  .cr-no { display: inline-grid; place-items: center; min-width: 2.6em; padding: 3px 6px; background: var(--color-accent); color: #fff; font-weight: 800; }
  .cr-label { color: var(--color-text-strong); letter-spacing: .22em; }
  .cr-line { flex: 1; height: 4px; background: var(--color-text-strong); transform: skewX(-18deg); }
  .cr-value { white-space: nowrap; }
  .cr-head { display: flex; align-items: flex-end; gap: clamp(16px, 3vw, 36px); flex-wrap: wrap; margin: 18px 0 36px; }
  .cr-title { margin: 0; font-family: Arial, Helvetica, var(--font-serif); font-size: clamp(48px, 6vw, 84px); font-weight: 900; letter-spacing: -.04em; line-height: .9; color: var(--color-text-strong); }
  .cr-lede { margin: 0; font-size: 13.5px; line-height: 1.95; color: var(--color-text-muted); max-width: 460px; }
  @media (min-width: 1440px) { .chapter-rule { padding-top: 112px; } }
  @media (max-width: 760px) {
    .chapter-rule { padding-top: 56px; }
    .cr-line-row { gap: 10px; font-size: 10px; }
    .cr-head { margin: 20px 0 28px; }
  }
</style>
