---
interface Props {
  no: string;
  label: string;
  en?: string;
  value?: string;
  title?: string;
  lede?: string;
}
const { label, value, title, lede } = Astro.props;
---
<header class="chapter-rule" data-reveal>
  <p class="cr-line-row">
    <span class="cr-mark" aria-hidden="true"></span>
    <span class="cr-label">{label}</span>
    <span class="cr-line" aria-hidden="true"></span>
    {value && <span class="cr-value">{value}</span>}
  </p>
  {title && (
    <div class="cr-head">
      <h1 class="cr-title">{title}</h1>
      {lede && <p class="cr-lede">{lede}</p>}
    </div>
  )}
</header>

<style>
  .chapter-rule {
    margin: 0;
    padding: 88px 0 0;
    color: var(--color-text-muted);
  }
  .cr-line-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: .14em;
  }
  .cr-mark { width: 18px; height: 1px; background: var(--color-accent); flex-shrink: 0; }
  .cr-label { color: var(--color-text-strong); }
  .cr-line { flex: 1; height: 1px; background: var(--color-card-border); }
  .cr-value { white-space: nowrap; }
  .cr-head { display: flex; align-items: baseline; gap: clamp(16px, 3vw, 36px); flex-wrap: wrap; margin: 26px 0 36px; }
  .cr-title { margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 3.2vw, 46px); font-weight: 500; letter-spacing: .05em; line-height: 1.3; color: var(--color-text-strong); }
  .cr-lede { margin: 0; font-size: 13.5px; line-height: 1.95; color: var(--color-text-muted); max-width: 460px; }
  @media (min-width: 1440px) { .chapter-rule { padding-top: 112px; } }
  @media (max-width: 760px) {
    .chapter-rule { padding-top: 56px; }
    .cr-line-row { gap: 10px; font-size: 10px; }
    .cr-head { margin: 20px 0 28px; }
  }
</style>
