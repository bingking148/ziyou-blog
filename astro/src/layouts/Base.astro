---
import { SITE_TITLE, SITE_DESCRIPTION, MENU, AUTHOR, SINCE, SOCIAL } from '../consts.ts';
import BackToTop from '../components/BackToTop.astro';
import { responsive } from '../utils/images.ts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  pageClass?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  cover,
  pageClass = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const coverAbs = cover ? new URL(cover, Astro.site) : new URL('/images/hero-bg-1280.jpg', Astro.site);
const coverInfo = responsive(coverAbs.pathname);
const coverWidth = coverInfo.width ?? (cover ? 1600 : 1280);
const coverHeight = coverInfo.height ?? (cover ? 900 : 853);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#f7fafc" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={coverAbs} />
    <meta property="og:image:alt" content={title ?? SITE_TITLE} />
    <meta property="og:image:width" content={String(coverWidth)} />
    <meta property="og:image:height" content={String(coverHeight)} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={AUTHOR} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={coverAbs} />
    {json && <script type="application/ld+json" set:html={json} />}

    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var valid = stored === 'dark' || stored === 'light' ? stored : null;
        document.documentElement.dataset.theme = valid || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <link rel="stylesheet" href="/resources/lxgw-wenkai-screen-webfont@1.1.0/lxgwwenkaiscreen.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/resources/lxgw-wenkai-screen-webfont@1.1.0/lxgwwenkaiscreen.css" /></noscript>
    <link rel="stylesheet" href="/resources/mulish/mulish.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/resources/mulish/mulish.css" /></noscript>
    <slot name="head" />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="edge-marks" aria-hidden="true">
      <i class="em-ticks"></i>
      <i class="em-ticks em-r"></i>
      <i class="em-chip"></i>
      <i class="em-dash"></i>
      <i class="em-corner"></i>
    </div>
    {pageClass.split(/\s+/).includes('is-home') && <div class="pointer-aura" aria-hidden="true"></div>}

    <header class="site-header">
      <a class="site-brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
        <svg class="brand-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 2v24M2 14h24M5.5 5.5l17 17M5.5 22.5l17-17" stroke="currentColor" stroke-width="1.2" />
          <circle cx="14" cy="14" r="4" stroke="currentColor" stroke-width="1.2" />
        </svg>
        <span>{SITE_TITLE}</span>
      </a>
      <nav id="main-nav" aria-label="主导航">
        {MENU.map((item) => (
          <a
            class:list={['main-nav-link-wrap', { 'is-active': item.url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.url) }]}
            href={item.url}
            aria-current={(item.url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.url)) ? 'page' : undefined}
          >{item.name}</a>
        ))}
      </nav>
      <div class="header-actions">
        <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航菜单">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <button id="theme-toggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
          <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </header>

    <div id="mobile-menu" class="mobile-menu" hidden>
      <nav aria-label="移动导航">
        {MENU.map((item) => (
          <a
            href={item.url}
            aria-current={(item.url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.url)) ? 'page' : undefined}
          >{item.name}</a>
        ))}
      </nav>
    </div>

    <main id="main" class="site-main" tabindex="-1"><slot /></main>

    <footer class="site-footer">
      <p class="footer-mark" aria-hidden="true">ZIYOU</p>
      <div class="footer-bar">
        <div class="footer-inner">
          <span>© {SINCE}—{new Date().getFullYear()} {AUTHOR}</span>
          <nav class="footer-links" aria-label="站点导航">
            <a href="/categories/">分类</a>
            <a href="/tags/">标签</a>
            <a href="/index.xml">RSS</a>
            <a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>
          </nav>
          <span class="footer-note">保持好奇，持续书写。</span>
          <span class="footer-stats">
            <span id="busuanzi_container_site_pv" style="display:none">访问 <span id="busuanzi_value_site_pv"></span></span>
            <span id="busuanzi_container_site_uv" style="display:none">访客 <span id="busuanzi_value_site_uv"></span></span>
          </span>
        </div>
      </div>
    </footer>
    <script async src="/resources/busuanzi/bsz.pure.mini.js"></script>
    <script>
      // 不蒜子在 localhost / 异常域名上会回一个共享的超大计数。只展示像样的整数。
      (function () {
        var ids = ['busuanzi_value_site_pv', 'busuanzi_value_site_uv', 'busuanzi_value_page_pv'];
        function sane(el) {
          if (!el) return;
          var raw = (el.textContent || '').replace(/[,\s]/g, '');
          var n = Number(raw);
          var host = location.hostname;
          var local = host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host.endsWith('.local');
          var box = el.parentElement;
          if (!raw || local || !Number.isFinite(n) || n < 0 || n > 1000000) {
            if (box) box.style.display = 'none';
            return;
          }
          el.textContent = n.toLocaleString('zh-CN');
        }
        var obs = new MutationObserver(function () { ids.forEach(function (id) { sane(document.getElementById(id)); }); });
        ids.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) obs.observe(el, { childList: true, characterData: true, subtree: true });
        });
      })();
    </script>
    <BackToTop />

    <script>
      (function () {
        'use strict';
        var root = document.documentElement;
        var themeBtn = document.getElementById('theme-toggle');
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function storedTheme() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'dark' || v === 'light' ? v : null;
          } catch (e) { return null; }
        }
        function applyTheme(theme, save) {
          root.dataset.theme = theme;
          if (themeMeta) themeMeta.setAttribute('content', theme === 'dark' ? '#14181f' : '#f7fafc');
          if (themeBtn) {
            var label = theme === 'dark' ? '切换到浅色模式' : '切换到深色模式';
            themeBtn.setAttribute('aria-label', label);
            themeBtn.setAttribute('title', label);
            themeBtn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
          }
          if (save) {
            try { localStorage.setItem('theme', theme); } catch (e) {}
          }
        }
        applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
        media.addEventListener('change', function (e) {
          if (!storedTheme()) applyTheme(e.matches ? 'dark' : 'light', false);
        });
        if (themeBtn) themeBtn.addEventListener('click', function () {
          applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
        });

        var navToggle = document.getElementById('nav-toggle');
        var mobileMenu = document.getElementById('mobile-menu');
        if (navToggle && mobileMenu) {
          var close = function (focus) {
            mobileMenu.hidden = true;
            navToggle.setAttribute('aria-expanded', 'false');
            navToggle.setAttribute('aria-label', '打开导航菜单');
            document.body.classList.remove('menu-open');
            if (focus) navToggle.focus();
          };
          var open = function () {
            mobileMenu.hidden = false;
            navToggle.setAttribute('aria-expanded', 'true');
            navToggle.setAttribute('aria-label', '关闭导航菜单');
            document.body.classList.add('menu-open');
            var first = mobileMenu.querySelector('a');
            if (first) requestAnimationFrame(function () { first.focus(); });
          };
          navToggle.addEventListener('click', function () {
            mobileMenu.hidden ? open() : close(false);
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !mobileMenu.hidden) close(true);
          });
          mobileMenu.addEventListener('click', function (e) {
            if (e.target.closest('a')) close(false);
          });
          document.addEventListener('click', function (e) {
            if (!mobileMenu.hidden && !mobileMenu.contains(e.target) && !navToggle.contains(e.target)) close(false);
          });
        }
      })();
    </script>
    <script>
      (function () {
        'use strict';
        var nav = document.getElementById('main-nav');
        if (!nav) return;
        var links = nav.querySelectorAll('.main-nav-link-wrap');
        if (!links.length) return;
        var pill = document.createElement('div');
        pill.className = 'nav-pill';
        pill.setAttribute('aria-hidden', 'true');
        nav.appendChild(pill);
        var norm = function (p) { return p.replace(/\/index\.html$/, '/'); };
        var pickActive = function () {
          var here = norm(location.pathname), best = null;
          for (var i = 0; i < links.length; i++) {
            var a = links[i], u;
            try { u = new URL(a.href, location.href); } catch (e) { continue; }
            var p = norm(u.pathname);
            if (p === here && p === '/') return a;
            if (p !== '/' && here.indexOf(p) === 0) best = best || a;
          }
          return best;
        };
        var active = pickActive();
        var place = function (el) {
          if (!el) { pill.classList.remove('is-ready'); return; }
          pill.classList.add('is-ready');
          var nr = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
          pill.style.width = r.width + 'px';
          pill.style.transform = 'translateX(' + (r.left - nr.left) + 'px)';
        };
        place(active);
        requestAnimationFrame(function () { pill.classList.add('is-ready'); place(active); });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { place(active); });
        Array.prototype.forEach.call(links, function (a) {
          a.addEventListener('mouseenter', function () { place(a); });
          a.addEventListener('focus', function () { place(a); });
        });
        nav.addEventListener('mouseleave', function () { place(active); });
        window.addEventListener('resize', function () { place(active); });
        window.addEventListener('load', function () { place(active); });
      })();
    </script>
    <script>
      (function () {
        'use strict';
        var els = document.querySelectorAll('[data-reveal]');
        if (els.length) {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('is-visible'); });
          } else {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
              });
            }, { rootMargin: '0px 0px -6% 0px' });
            els.forEach(function (el) { io.observe(el); });
          }
        }
        if (!document.body.classList.contains('is-home')) return;
        if (window.matchMedia('(hover: none), (pointer: coarse), (prefers-reduced-motion: reduce)').matches) return;
        var aura = document.querySelector('.pointer-aura');
        if (!aura) return;
        var R = 22, x = 0, y = 0, tx = 0, ty = 0, scale = 1, ts = 1, running = false, primed = false, inside = false;
        var jellyT0 = 0;
        var hotSel = 'a, button, h1, h2, .scene-title, .s2-title, .focus-card, .book-plate, .series-visual';
        function show(e) {
          if (e.pointerType && e.pointerType !== 'mouse') return;
          inside = true;
          tx = e.clientX; ty = e.clientY;
          if (!primed) { x = tx; y = ty; primed = true; }
          aura.classList.add('is-on');
          wake();
        }
        function jelly() {
          if (!jellyT0) return [1, 1];
          var t = (performance.now() - jellyT0) / 420;
          if (t >= 1) { jellyT0 = 0; return [1, 1]; }
          var e;
          if (t < 0.38) { e = Math.sin((t / 0.38) * Math.PI); return [1 + 0.16 * e, 1 - 0.14 * e]; }
          if (t < 0.72) { e = Math.sin(((t - 0.38) / 0.34) * Math.PI); return [1 - 0.1 * e, 1 + 0.1 * e]; }
          e = Math.sin(((t - 0.72) / 0.28) * Math.PI);
          return [1 + 0.04 * e, 1 - 0.035 * e];
        }
        function tick() {
          var dx = tx - x, dy = ty - y, ds = ts - scale;
          x += dx * 0.16;
          y += dy * 0.16;
          scale += ds * 0.14;
          var j = jelly();
          aura.style.transform = 'translate3d(' + (x - R) + 'px,' + (y - R) + 'px,0) scale(' + (scale * j[0]).toFixed(3) + ',' + (scale * j[1]).toFixed(3) + ')';
          if (!inside && !jellyT0 && Math.abs(dx) < 0.25 && Math.abs(dy) < 0.25 && Math.abs(ds) < 0.004) { running = false; return; }
          requestAnimationFrame(tick);
        }
        function wake() { if (!running) { running = true; requestAnimationFrame(tick); } }
        document.addEventListener('pointermove', show, { passive: true });
        document.addEventListener('pointerdown', function (e) {
          show(e);
          if (e.button !== 0) return;
          if (e.pointerType && e.pointerType !== 'mouse') return;
          jellyT0 = performance.now();
          wake();
        });
        document.addEventListener('pointerover', function (e) {
          var t = e.target && e.target.closest && e.target.closest(hotSel);
          ts = t ? 1.35 : 1;
          wake();
        });
        document.addEventListener('pointerout', function (e) {
          if (e.relatedTarget) return;
          inside = false;
          aura.classList.remove('is-on');
        });
      })();
    </script>
    <script>
      (function () {
        'use strict';
        if (!('requestIdleCallback' in window) || !document.createElement('link').relList.supports('prefetch')) return;
        if (navigator.connection && (navigator.connection.saveData || /2g/.test(navigator.connection.effectiveType || ''))) return;
        // 只保留按需 hover/focus 预热；关闭 Astro viewport prefetch 注入脚本。
        var astroPrefetch = document.querySelector('script[data-astro-prefetch]');
        if (astroPrefetch) astroPrefetch.remove();
        var seen = new Set();
        var prefetch = function (href) {
          if (seen.has(href)) return;
          seen.add(href);
          requestIdleCallback(function () {
            var link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = href;
            document.head.appendChild(link);
          });
        };
        document.addEventListener('mouseover', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="/"]');
          if (!a) return;
          var href = a.getAttribute('href');
          if (/^\/(post|archives|columns|categories|about|friend|learning)\//.test(href)) prefetch(href);
        }, { passive: true });
        document.addEventListener('focusin', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="/"]');
          if (!a) return;
          var href = a.getAttribute('href');
          if (/^\/(post|archives|columns|categories|about|friend|learning)\//.test(href)) prefetch(href);
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-bg {
    position: fixed; inset: 0; z-index: -2; pointer-events: none;
    background: var(--color-bg);
  }
  .site-bg::before {
    content: ""; position: fixed; z-index: 80; left: 0; top: 0; bottom: 0; width: 10px;
    background: #111; pointer-events: none;
  }
  .site-bg::after {
    content: ""; position: fixed; z-index: 81; left: 10px; top: 0; width: 10px; height: 56px;
    background: #c41e3a; pointer-events: none;
  }
  [data-theme="dark"] .site-bg::before { background: #c41e3a; }
  [data-theme="dark"] .site-bg::after { background: #f4f1ea; }
  /* 页边小构件：刻度、色块、短杠、角框。只占左右外侧，不进正文。 */
  .edge-marks { position: fixed; inset: 0; z-index: 4; pointer-events: none; }
  .edge-marks i { position: absolute; display: block; }
  .em-ticks {
    top: 92px; bottom: 88px; left: 14px; width: 8px;
    background: repeating-linear-gradient(to bottom, var(--color-text-strong) 0 7px, transparent 7px 24px);
    opacity: .38;
  }
  .em-r { left: auto; right: 14px; width: 2px; opacity: .32; }
  .em-chip { left: 13px; top: 42%; width: 9px; height: 9px; background: #c41e3a; }
  .em-dash { right: 12px; top: 28%; width: 18px; height: 3px; background: var(--color-text-strong); opacity: .45; }
  .em-corner { right: 12px; bottom: 64px; width: 14px; height: 14px; border-right: 2px solid #c41e3a; border-bottom: 2px solid #c41e3a; }
  body.is-home .edge-marks { display: none; }
  body.is-post .em-r, body.is-post .em-dash, body.is-post .em-corner { display: none; }
  body.is-home .pointer-aura {
    display: none;
    position: fixed; top: 0; left: 0; z-index: 140;
    width: 44px; height: 44px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 42%, rgba(255,255,255,.55) 68%, transparent 100%);
    mix-blend-mode: difference;
    pointer-events: none; opacity: 0;
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    body.is-home .pointer-aura { display: block; }
    body.is-home .pointer-aura.is-on { opacity: 1; }
  }
  .site-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: stretch; gap: 0; height: 64px;
    padding: 0 18px 0 20px; color: var(--color-text-strong); background: var(--color-bg);
    border-bottom: 3px solid var(--color-text-strong);
  }
  .site-brand {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-serif); font-size: 18px; font-weight: 700; letter-spacing: .2em;
    color: inherit;
  }
  .site-brand:hover { color: inherit; }
  .brand-mark { width: 26px; height: 26px; }
  #main-nav { position: relative; display: flex; gap: 8px; margin-left: auto; }
  .main-nav-link-wrap {
    position: relative; display: flex; align-items: center; padding: 0 14px;
    font-size: 13px; letter-spacing: .12em; color: inherit;
    border-left: 1px solid color-mix(in srgb, var(--color-text-strong) 28%, transparent);
  }
  .main-nav-link-wrap:hover { color: inherit; }
  .main-nav-link-wrap.is-active { color: #fff; }
  .main-nav-link-wrap.is-active::after { content: none; }
  :global(.nav-pill) {
    position: absolute; z-index: -1; top: 4px; left: 0; height: calc(100% - 8px);
    border-radius: 0; background: #c41e3a; border: 0; min-width: 8px;
    opacity: 0; pointer-events: none;
    transition: width .35s cubic-bezier(.2,.8,.2,1), opacity .2s;
  }
  :global(.nav-pill.is-ready) { opacity: 1; }
  .header-actions { display: flex; align-items: center; gap: 10px; margin-left: 10px; }
  #theme-toggle, #nav-toggle {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 1px solid currentColor; border-radius: 0; background: transparent;
    color: inherit; cursor: pointer; transition: transform .25s, background .25s;
  }
  #theme-toggle:hover, #nav-toggle:hover { background: rgba(255,255,255,.1); transform: rotate(12deg); }
  #nav-toggle { display: none; }
  .icon-moon { display: none; }
  [data-theme="dark"] .icon-sun { display: none; }
  [data-theme="dark"] .icon-moon { display: block; }
  .mobile-menu {
    position: fixed; inset: 0; z-index: 95;
    padding: 96px 24px 40px;
    background: var(--color-bg);
    color: var(--color-text-strong);
  }
  .mobile-menu nav { display: grid; gap: 0; }
  .mobile-menu a {
