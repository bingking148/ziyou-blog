---
import { SITE_TITLE, SITE_DESCRIPTION, MENU, AUTHOR, SINCE } from '../consts.ts';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cover?: string;
  pageClass?: string;
}

const { title, description = SITE_DESCRIPTION, cover, pageClass = '' } = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const coverAbs = cover ? new URL(cover, Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    {coverAbs && <meta property="og:image" content={coverAbs} />}

    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme =
          t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <link rel="stylesheet" href="/resources/lxgw-wenkai-screen-webfont@1.1.0/style.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/resources/lxgw-wenkai-screen-webfont@1.1.0/style.css" /></noscript>
    <link rel="stylesheet" href="/resources/mulish/mulish.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/resources/mulish/mulish.css" /></noscript>
    <slot name="head" />
  </head>
  <body class={pageClass}>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="pointer-aura" aria-hidden="true"></div>

    <header class="site-header">
      <a class="site-brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
        <svg class="brand-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 2v24M2 14h24M5.5 5.5l17 17M5.5 22.5l17-17" stroke="currentColor" stroke-width="1.2" />
          <circle cx="14" cy="14" r="4" stroke="currentColor" stroke-width="1.2" />
        </svg>
        <span>{SITE_TITLE}</span>
      </a>
      <nav id="main-nav" aria-label="主导航">
        {MENU.map((item) => (
          <a
            class:list={['main-nav-link-wrap', { 'is-active': item.url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.url) }]}
            href={item.url}
            aria-current={(item.url === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.url)) ? 'page' : undefined}
          >{item.name}</a>
        ))}
      </nav>
      <button id="theme-toggle" aria-label="切换明暗模式" title="切换明暗模式">
        <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </header>

    <main id="main" class="site-main"><slot /></main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>© {SINCE}—{new Date().getFullYear()} {AUTHOR}</span>
        <span class="footer-note">保持好奇，持续书写。</span>
        <span class="footer-stats">
          <span id="busuanzi_container_site_pv" style="display:none">访问 <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none">访客 <span id="busuanzi_value_site_uv"></span></span>
        </span>
      </div>
    </footer>
    <script async src="/resources/busuanzi/bsz.pure.mini.js"></script>
    <BackToTop />

    <script>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
    <script>
      (function () {
        'use strict';
        var nav = document.getElementById('main-nav');
        if (!nav) return;
        var links = nav.querySelectorAll('.main-nav-link-wrap');
        if (!links.length) return;
        var pill = document.createElement('div');
        pill.className = 'nav-pill';
        pill.setAttribute('aria-hidden', 'true');
        nav.appendChild(pill);
        var norm = function (p) { return p.replace(/\/index\.html$/, '/'); };
        var pickActive = function () {
          var here = norm(location.pathname), best = null;
          for (var i = 0; i < links.length; i++) {
            var a = links[i], u;
            try { u = new URL(a.href, location.href); } catch (e) { continue; }
            var p = norm(u.pathname);
            if (p === here && p === '/') return a;
            if (p !== '/' && here.indexOf(p) === 0) best = best || a;
          }
          return best;
        };
        var active = pickActive();
        var place = function (el) {
          if (!el) { pill.classList.remove('is-ready'); return; }
          pill.classList.add('is-ready');
          var nr = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
          pill.style.width = r.width + 'px';
          pill.style.transform = 'translateX(' + (r.left - nr.left) + 'px)';
        };
        place(active);
        requestAnimationFrame(function () { pill.classList.add('is-ready'); place(active); });
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { place(active); });
        Array.prototype.forEach.call(links, function (a) {
          a.addEventListener('mouseenter', function () { place(a); });
          a.addEventListener('focus', function () { place(a); });
        });
        nav.addEventListener('mouseleave', function () { place(active); });
        window.addEventListener('resize', function () { place(active); });
        window.addEventListener('load', function () { place(active); });
      })();
    </script>
    <script>
      (function () {
        'use strict';
        var els = document.querySelectorAll('[data-reveal]');
        if (els.length) {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('is-visible'); });
          } else {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
              });
            }, { rootMargin: '0px 0px -6% 0px' });
            els.forEach(function (el) { io.observe(el); });
          }
        }
        if (window.matchMedia('(hover: none), (prefers-reduced-motion: reduce)').matches) return;
        var aura = document.querySelector('.pointer-aura'), frame = null;
        document.addEventListener('pointermove', function (e) {
          if (frame) return;
          frame = requestAnimationFrame(function () {
            frame = null;
            aura.style.transform = 'translate3d(' + (e.clientX - 300) + 'px,' + (e.clientY - 300) + 'px,0)';
          });
        }, { passive: true });
      })();
    </script>
  </body>
</html>

<style>
  .site-bg {
    position: fixed; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(70% 60% at 5% 30%, color-mix(in srgb, var(--red-2) 8%, transparent), transparent),
      radial-gradient(50% 50% at 95% 70%, color-mix(in srgb, var(--red-1) 5%, transparent), transparent);
  }
  .pointer-aura {
    position: fixed; left: 0; top: 0; z-index: -1; width: 600px; height: 600px;
    border-radius: 50%; pointer-events: none; opacity: .24;
    background: radial-gradient(circle, color-mix(in srgb, var(--red-2) 13%, transparent), transparent 65%);
    will-change: transform;
  }
  .site-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; gap: 24px; height: 96px;
    padding: 0 clamp(24px, 4.5vw, 76px); color: #fff;
  }
  .site-brand {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--font-serif); font-size: 18px; font-weight: 700; letter-spacing: .2em;
    color: inherit;
  }
  .site-brand:hover { color: inherit; }
  .brand-mark { width: 26px; height: 26px; }
  #main-nav { position: relative; display: flex; gap: 8px; margin-left: auto; }
  .main-nav-link-wrap {
    position: relative; padding: 8px 16px; font-size: 13px; letter-spacing: .12em; color: inherit;
  }
  .main-nav-link-wrap:hover { color: inherit; }
  .main-nav-link-wrap.is-active::after {
    content: ''; position: absolute; left: 50%; bottom: 0; width: 3px; height: 3px;
    border-radius: 50%; background: currentColor; transform: translateX(-50%); opacity: .75;
  }
  .nav-pill {
    position: absolute; z-index: -1; top: 2px; left: 0; height: calc(100% - 4px);
    border-radius: 99px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.13);
    opacity: 0; pointer-events: none; backdrop-filter: blur(8px);
    transition: transform .5s cubic-bezier(.34,1.56,.64,1), width .5s cubic-bezier(.34,1.56,.64,1), opacity .3s;
  }
  .nav-pill.is-ready { opacity: 1; }
  #theme-toggle {
    display: grid; place-items: center; width: 36px; height: 36px; padding: 0;
    border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: transparent;
    color: inherit; cursor: pointer; transition: transform .25s, background .25s;
  }
  #theme-toggle:hover { background: rgba(255,255,255,.1); transform: rotate(12deg); }
  .icon-moon { display: none; }
  [data-theme="dark"] .icon-sun { display: none; }
  [data-theme="dark"] .icon-moon { display: block; }
  .site-main { min-height: 75vh; }
  .site-footer { padding: 28px clamp(24px,5vw,76px); border-top: 1px solid var(--color-card-border); }
  .footer-inner { display: flex; align-items: center; gap: 28px; font-size: 12px; color: var(--color-text-muted); }
  .footer-note { margin-right: auto; }
  .footer-stats { display: flex; gap: 14px; }
  body:not(.is-home):not(.is-post) .site-header {
    position: relative; height: 84px; color: var(--color-text-strong);
  }
  body:not(.is-home):not(.is-post) .nav-pill { background: var(--red-5); border-color: transparent; }
  body:not(.is-home):not(.is-post) #theme-toggle { border-color: var(--color-card-border); }
  body:not(.is-home):not(.is-post) #theme-toggle:hover { background: var(--red-5); }
  @media (max-width: 900px) {
    .site-header { height: 76px; gap: 12px; }
    #main-nav { gap: 0; }
    .main-nav-link-wrap { padding: 7px 9px; font-size: 12px; }
  }
  @media (max-width: 600px) {
    .site-header { padding: 0 18px; gap: 10px; }
    .site-brand { gap: 7px; font-size: 14px; }
    .brand-mark { width: 20px; height: 20px; }
    .main-nav-link-wrap { padding: 6px 7px; letter-spacing: 0; }
    #main-nav .main-nav-link-wrap:nth-child(2),
    #main-nav .main-nav-link-wrap:nth-child(5),
    #main-nav .main-nav-link-wrap:nth-child(6) { display: none; }
    #theme-toggle { width: 30px; height: 30px; flex-shrink: 0; }
    .footer-inner { flex-wrap: wrap; gap: 8px 16px; }
    .footer-note { width: 100%; order: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pointer-aura { display: none; }
    .nav-pill { transition: opacity .3s; }
  }
</style>
