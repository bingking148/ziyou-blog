---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = await getCollection('post');
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const hotTags = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([t]) => t);
---

<Base title="搜索" description="站内搜索" noindex>
  <div class="ed-wrap ed-wrap--wide search-page">
    <div class="search-top" data-reveal>
      <span class="ed-label">02 / SEARCH</span>
      <p class="search-hint">搜索全站 {posts.length} 篇文章</p>
    </div>

    <div class="search-field" data-reveal>
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词…"
        autocomplete="off"
        autofocus
        aria-label="搜索文章"
      />
      <svg class="search-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span class="search-underline" aria-hidden="true"></span>
    </div>

    <div class="search-suggest" data-reveal>
      <span>试试：</span>
      {hotTags.map((t) => <button type="button" class="suggest-btn" data-keyword={t}>{t}</button>)}
    </div>

    <p id="search-status" class="search-status" role="status" aria-live="polite">输入关键词开始搜索；也可以 <a href="/archives/">直接浏览全部归档</a>。</p>
    <ul id="search-results" class="search-results"></ul>

    <noscript>
      <p class="search-noscript">当前浏览器未启用 JavaScript，无法使用站内搜索。可以先到 <a href="/archives/">归档页</a> 或 <a href="/categories/">分类页</a> 浏览全部文章。</p>
    </noscript>
  </div>
</Base>

<script is:inline src="/resources/fuse.js/fuse.min.js"></script>
<script>
  (function () {
    'use strict';
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var status = document.getElementById('search-status');
    var index = null;         // search.json 内容
    var fuse = null;          // 拉丁查询用 fuse，首次命中拉丁字符才初始化
    var loading = false;
    var loadFailed = false;

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function setStatus(html, isError) {
      status.innerHTML = html;
      status.classList.toggle('is-error', !!isError);
    }

    function render(items, query) {
      if (!query) {
        results.innerHTML = '';
        setStatus(index ? '共收录 ' + index.length + ' 篇文章' : '输入关键词开始搜索');
        return;
      }
      if (!items.length) {
        results.innerHTML = '';
        setStatus('没有找到「' + esc(query) + '」相关的文章');
        return;
      }
      setStatus('找到 ' + items.length + ' 篇');
      results.innerHTML = items
        .map(function (it, i) {
          return (
            '<li><a class="ed-row result-row" href="' + esc(it.permalink) + '">' +
            '<span class="row-no">' + String(i + 1).padStart(2, '0') + '</span>' +
            '<span class="result-body">' +
            '<h3>' + esc(it.title) + '</h3>' +
            (it.description ? '<p>' + esc(it.description.slice(0, 110)) + '</p>' : '') +
            '</span>' +
            '<time>' + esc(it.date) + '</time>' +
            '<span class="row-arrow">↗</span>' +
            '</a></li>'
          );
        })
        .join('');
    }

    var CJK = /[一-鿿]/;

    function runSearch(q) {
      if (!index) return;
      if (CJK.test(q)) {
        // 中文：子串匹配（标题/描述/标签加权靠前）
        var lower = q.toLowerCase();
        var hits = index
          .map(function (it) {
            var score =
              (it.title.toLowerCase().includes(lower) ? 4 : 0) +
              ((it.description || '').toLowerCase().includes(lower) ? 2 : 0) +
              (it.tags.some(function (t) { return t.toLowerCase().includes(lower); }) ? 2 : 0) +
              ((it.content || '').toLowerCase().includes(lower) ? 1 : 0);
            return score > 0 ? { it: it, score: score } : null;
          })
          .filter(Boolean)
          .sort(function (a, b) { return b.score - a.score; })
          .map(function (h) { return h.it; });
        render(hits, q);
      } else {
        // 拉丁文首次查询时才真正建 fuse 实例——中文用户不需要付这部分初始化成本
        if (!fuse && window.Fuse) {
          fuse = new window.Fuse(index, {
            keys: [
              { name: 'title', weight: 3 },
              { name: 'description', weight: 2 },
              { name: 'tags', weight: 2 },
              { name: 'content', weight: 1 },
            ],
            threshold: 0.35,
            ignoreLocation: true,
          });
        }
        if (fuse) render(fuse.search(q, { limit: 20 }).map(function (r) { return r.item; }), q);
      }
    }

    function syncUrl(q, push) {
      try {
        var url = new URL(window.location.href);
        if (q) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        window.history[push ? 'pushState' : 'replaceState'](null, '', url);
      } catch (e) {}
    }

    function loadIndex(then) {
      if (index) { if (then) then(); return; }
      if (loading) return;
      loading = true;
      loadFailed = false;
      setStatus('正在加载索引…');
      fetch('/search.json')
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          index = data;
          loading = false;
          if (then) then();
          else setStatus('共收录 ' + data.length + ' 篇文章');
        })
        .catch(function () {
          loading = false;
          loadFailed = true;
          setStatus('索引加载失败。<button type="button" class="search-retry" id="search-retry">点击重试</button>', true);
          var retry = document.getElementById('search-retry');
          if (retry) retry.addEventListener('click', function () { loadIndex(then); });
        });
    }

    var timer = null;
    function trigger(immediate, push) {
      var q = input.value.trim();
      syncUrl(q, push);
      if (!q) { render([], ''); return; }
      if (!index) {
        loadIndex(function () { runSearch(q); });
        return;
      }
      clearTimeout(timer);
      if (immediate) { runSearch(q); return; }
      timer = setTimeout(function () { runSearch(q); }, 180);
    }

    input.addEventListener('input', function () { trigger(false); });

    // 浏览器前进/后退：跟随 URL 里的 ?q= 还原查询
    window.addEventListener('popstate', function () {
      var q = '';
      try { q = new URL(window.location.href).searchParams.get('q') || ''; } catch (e) {}
      input.value = q;
      if (q) trigger(true); else render([], '');
    });

    // 站内跳转回搜索页（SPA 式 history 导航后 pageshow 触发，bfcache 返回也会走到）
    window.addEventListener('pageshow', function () {
      var q = '';
      try { q = new URL(window.location.href).searchParams.get('q') || ''; } catch (e) {}
      if (q && q !== input.value) {
        input.value = q;
        trigger(true);
      } else if (q && !index) {
        // 首次以 ?q= 进入时 trigger 已被下方初始逻辑调过；这里处理「脚本后于 URL 变化就绪」的边角
        trigger(true);
      }
    });

    // 推荐关键词：填入并立即搜索
    document.querySelectorAll('.suggest-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        input.value = btn.getAttribute('data-keyword') || '';
        input.focus();
        trigger(true, true);
      });
    });

    // 进入页面：URL 已有 ?q= 就直接搜索（分享链接场景）；否则只在用户首次输入时才拉索引
    var initialQ = '';
    try { initialQ = new URL(window.location.href).searchParams.get('q') || ''; } catch (e) {}
    if (initialQ) {
      input.value = initialQ;
      trigger(true);
    }
  })();
</script>

<style>
  .search-page { max-width: 960px; }
  .search-top { padding: 88px 0 0; }
  .search-hint { margin: 18px 0 0; font-size: 14px; color: var(--color-text-muted); }
  .search-field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 56px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--red-3);
  }
  #search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    padding: 0;
    font-family: var(--font-serif);
    font-size: clamp(26px, 3.6vw, 42px);
    letter-spacing: .04em;
    color: var(--color-text-strong);
  }
  #search-input::placeholder { color: var(--color-text-muted); opacity: .55; }
  .search-icon { flex-shrink: 0; color: var(--red-2); transition: transform .4s ease; }
  .search-field:focus-within .search-icon { transform: rotate(90deg); }
  .search-underline {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: var(--red-1);
    transform: scaleX(0); transform-origin: left;
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .search-field:focus-within .search-underline { transform: scaleX(1); }
  .search-suggest { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 24px; font-size: 13px; color: var(--color-text-muted); }
  .suggest-btn {
    border: none; background: none; padding: 2px 0; cursor: pointer;
    font-family: inherit; font-size: 13px; letter-spacing: .05em;
    color: var(--red-1); border-bottom: 1px solid var(--red-3);
    transition: border-color .25s ease;
  }
  .suggest-btn:hover { border-color: var(--red-1); }
  .search-status { margin: 56px 0 20px; font-size: 12px; letter-spacing: .12em; color: var(--color-text-muted); }
  .search-status.is-error { color: var(--color-accent); }
  .search-status a { color: var(--color-link); border-bottom: 1px solid var(--red-3); }
  .search-retry {
    margin-left: 10px; padding: 2px 10px;
    border: 1px solid var(--color-card-border); border-radius: 999px;
    background: var(--color-surface); color: var(--color-link);
    font-size: 12px; cursor: pointer;
  }
  .search-retry:hover { background: var(--red-5); }
  .search-noscript {
    margin: 32px 0 0; padding: 14px 18px;
    border-left: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    font-size: 13.5px; line-height: 1.8;
  }
  .search-results { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .search-results :global(.result-row) { align-items: flex-start; }
  .search-results :global(.result-row .row-no) { padding-top: 6px; }
  .search-results :global(.result-body) { flex: 1; min-width: 0; }
  .search-results :global(.result-body h3) {
    margin: 0 0 8px; font-family: var(--font-serif); font-size: 19px; font-weight: 500;
    letter-spacing: .03em; color: var(--color-text-strong);
    transition: color .3s ease;
  }
  .search-results :global(.result-row:hover .result-body h3) { color: var(--red-1); }
  .search-results :global(.result-body p) {
    margin: 0; font-size: 13px; line-height: 1.8; color: var(--color-text-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .search-results :global(.result-row time) { flex-shrink: 0; padding-top: 6px; font-size: 11px; letter-spacing: .06em; color: var(--color-text-muted); }
  .search-results :global(.result-row .row-arrow) { padding-top: 4px; }
  @media (min-width: 1440px) {
    .search-page { max-width: var(--wide-content); }
    .search-top { display: grid; grid-template-columns: minmax(160px, .45fr) minmax(0, 1.4fr) auto; gap: var(--wide-gap); align-items: end; padding: 116px 0 64px; }
    .search-top .ed-label { align-self: start; margin-top: 18px; }
    .search-hint { margin: 0; font-family: var(--font-serif); font-size: clamp(28px, 2.8vw, 46px); line-height: 1.65; color: var(--color-text-strong); }
    .search-field { grid-column: 1 / -1; }
    .search-page { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .6fr); column-gap: var(--wide-gap); }
    .search-top { grid-column: 1 / -1; }
    .search-field { margin-top: 0; padding: 24px 0; }
    #search-input { font-size: clamp(32px, 3.2vw, 52px); }
    .search-suggest { align-self: center; justify-content: flex-end; margin-top: 0; }
    .search-status { grid-column: 1 / -1; margin: 72px 0 28px; }
    .search-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--wide-gap); border-top: 0; }
    .search-results { grid-column: 1 / -1; }
    .search-results :global(li) { min-width: 0; border-top: 1px solid var(--color-card-border); }
    .search-results :global(.result-row) { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; gap: 10px 20px; min-height: 180px; padding: 28px 16px 28px 4px; }
    .search-results :global(.result-body h3) { font-size: 20px; line-height: 1.6; }
    .search-results :global(.result-body p) { display: -webkit-box; white-space: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .search-results :global(.result-row time) { grid-column: 2; grid-row: 2; padding-top: 0; }
    .search-results :global(.result-row .row-arrow) { grid-column: 3; grid-row: 1; }
    .search-noscript { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .search-top { padding-top: 48px; }
    .search-field { margin-top: 40px; }
    .search-results :global(.result-row time) { display: none; }
  }
</style>
