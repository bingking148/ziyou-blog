---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { columnOf, columnPosts, postUrl, slugifyTaxonomy } from '../../utils/columns.ts';

type Post = CollectionEntry<'post'>;

export async function getStaticPaths() {
  const posts = await getCollection('post');
  const names = new Set<string>();
  for (const p of posts) for (const c of p.data.categories) names.add(c);
  return [...names].map((name) => ({
    params: { name: slugifyTaxonomy(name) },
    props: { name },
  }));
}

const { name } = Astro.props;
const posts = await getCollection('post');
const columns = await getCollection('columns');

const inCategory = posts
  .filter((p) => p.data.categories.includes(name))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const column = columns.find((c) => c.data.category === name);
const columnList = column ? columnPosts(column, posts) : [];
const ColumnContent = column ? (await render(column)).Content : null;

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const num = (w?: number) => String(w ?? 0).padStart(2, '0');
---

<Base title={column ? column.data.title : `分类：${name}`} description={column?.data.description ?? `分类「${name}」下的文章`}>
  {column && ColumnContent ? (
    <div class="columns-wrap">
      <h1 class="page-title" data-reveal>{column.data.title}</h1>
      <div class="column-card card" data-reveal>
        <div class="prose column-intro">
          <ColumnContent />
        </div>
        <ol class="column-list">
          {columnList.map((p) => (
            <li class="column-item">
              <span class="column-item-num">{num(p.data.weight)}</span>
              <a class="column-item-title" href={postUrl(p)}>{p.data.title}</a>
              <time class="column-item-date" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            </li>
          ))}
        </ol>
      </div>
    </div>
  ) : (
    <div class="tax-term-wrap" data-reveal>
      <h1 class="page-title">{name}</h1>
      <p class="page-sub">共 {inCategory.length} 篇</p>
      <ul class="post-list">
        {inCategory.map((p) => (
          <li>
            <a class="list-item card" href={postUrl(p)}>
              {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
              <div>
                <h3>{p.data.title}</h3>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</Base>

<style>
  .columns-wrap { max-width: 960px; margin: 0 auto; padding: 40px 0 8px; }
  .page-title { margin: 0 0 6px; font-size: 34px; letter-spacing: 4px; }
  .page-sub { margin: 0 0 28px; color: var(--color-text-muted); font-size: 14px; }
  .column-card { overflow: hidden; }
  .column-intro { padding: 28px 36px 8px; font-size: 15px; }
  .column-list { list-style: none; margin: 0; padding: 6px 12px 14px; }
  .column-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border-radius: 10px;
    transition: background 0.25s ease;
  }
  .column-item:hover { background: var(--red-5); }
  .column-item-num {
    flex-shrink: 0;
    min-width: 34px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    border-radius: 999px;
    background: var(--red-5);
    color: var(--red-1);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: background 0.25s ease;
  }
  .column-item:hover .column-item-num { background: var(--red-1); color: #fff; }
  .column-item-title {
    flex: 1;
    min-width: 0;
    color: var(--color-text-strong);
    font-weight: 600;
    font-size: 14.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .column-item-date { flex-shrink: 0; color: var(--color-text-muted); font-size: 12px; }

  .tax-term-wrap { max-width: 860px; margin: 0 auto; padding: 40px 0; }
  .post-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .list-item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 18px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .list-item:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .list-item img { width: 120px; height: 72px; object-fit: cover; border-radius: 10px; flex-shrink: 0; }
  .list-item h3 { margin: 0 0 6px; font-size: 16px; color: var(--color-text-strong); }
  .list-item time { font-size: 12.5px; color: var(--color-text-muted); }
  @media (max-width: 767px) {
    .column-intro { padding: 20px; }
    .column-item-date { display: none; }
  }
</style>
