---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChapterRule from '../../components/ChapterRule.astro';
import { slugifyTaxonomy } from '../../utils/columns.ts';

const posts = await getCollection('post');
const counts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="分类" description="文章分类">
  <div class="ed-wrap ed-wrap--wide">
    <ChapterRule no="06" label="分类" en="CATEGORIES" value={`${cats.length} 个分类`} title="分类" lede="按主题翻阅。" />
    <ol class="ed-list wide-list-grid" data-reveal>
      {cats.map(([name, count], i) => (
        <li>
          <a class="ed-row" href={`/categories/${slugifyTaxonomy(name)}/`}>
            <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-title">{name}</span>
            <span class="row-meta">{count} 篇</span>
            <span class="row-arrow">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
