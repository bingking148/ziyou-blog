---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { postUrl } from '../utils/columns.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="归档" description={`全部 ${posts.length} 篇文章的时间归档`}>
  <div class="archive-wrap" data-reveal>
    <h1 class="page-title">归档</h1>
    <p class="page-sub">共 {posts.length} 篇 · 按时间倒序</p>
    {years.map((y) => (
      <section class="archive-year">
        <h2 class="archive-year-title">{y}</h2>
        <ul class="archive-list">
          {byYear.get(y)!.map((p) => (
            <li class="archive-item">
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <a href={postUrl(p)}>{p.data.title}</a>
              <span class="archive-cats">
                {p.data.categories.map((c) => <em>{c}</em>)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .archive-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 0;
  }
  .page-title {
    margin: 0 0 6px;
    font-size: 34px;
    letter-spacing: 4px;
  }
  .page-sub {
    margin: 0 0 36px;
    color: var(--color-text-muted);
    font-size: 14px;
  }
  .archive-year { margin-bottom: 36px; }
  .archive-year-title {
    margin: 0 0 14px;
    font-size: 22px;
    color: var(--red-1);
    letter-spacing: 2px;
  }
  .archive-list { list-style: none; margin: 0; padding: 0; }
  .archive-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 9px 12px;
    border-radius: 10px;
    transition: background 0.25s ease;
  }
  .archive-item:hover { background: var(--red-5); }
  .archive-item time {
    flex-shrink: 0;
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--red-2);
  }
  .archive-item a {
    flex: 1;
    min-width: 0;
    color: var(--color-text-strong);
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .archive-item a:hover { color: var(--color-accent); }
  .archive-cats { flex-shrink: 0; }
  .archive-cats em {
    font-style: normal;
    font-size: 12px;
    color: var(--color-text-muted);
    margin-left: 8px;
  }
  @media (max-width: 767px) {
    .archive-cats { display: none; }
  }
</style>
