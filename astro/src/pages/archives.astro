---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChapterRule from '../components/ChapterRule.astro';

import ResponsiveImage from '../components/ResponsiveImage.astro';
import { postUrl } from '../utils/columns.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="归档" description={`全部 ${posts.length} 篇文章的时间归档`}>
  <div class="ed-wrap ed-wrap--wide">
    <ChapterRule
      no="04"
      label="归档"
      en="ARCHIVE"
      value={`${posts.length} 篇 · ${years.length} 个年份`}
      title="归档"
      lede="写下的每一篇，都留在这里。"
    />
    <nav class="archive-discovery" aria-label="按主题浏览">
      <a href="/categories/">按分类浏览</a>
      <a href="/tags/">按标签浏览</a>
      <a href="/search/">关键词搜索</a>
    </nav>

    {years.map((y) => (
      <section class="archive-year" data-reveal>
        <h2 class="archive-year-title"><span>{y}</span><i aria-hidden="true"></i></h2>
        <ol class="ed-list wide-list-grid">
          {byYear.get(y)!.map((p, i) => (
            <li>
              <a class="ed-row" href={postUrl(p)}>
                <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.data.title}</span>
                <span class="row-meta archive-cats">{p.data.categories[0]}</span>
                <time class="row-meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                {p.data.cover && (
                  <span class="archive-preview" aria-hidden="true">
                    <ResponsiveImage src={p.data.cover} sizes="240px" alt="" loading="lazy" />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .archive-year { margin-bottom: 56px; }
  .archive-discovery { display:flex;flex-wrap:wrap;gap:12px 24px;margin:-12px 0 56px;font-size:13px; }
  .archive-discovery a { color:var(--color-link);border-bottom:1px solid var(--red-3);padding-bottom:3px; }
  .archive-year-title { display: flex; align-items: center; gap: 24px; margin: 0 0 20px; }
  .archive-year-title span { font-family: Arial, Helvetica, sans-serif; font-size: clamp(64px, 8vw, 112px); font-weight: 900; color: var(--color-text-strong); letter-spacing: -.06em; line-height: .8; }
  .archive-year-title i { flex: 1; height: 10px; background: var(--color-accent); transform: skewX(-22deg); }
  .archive-year .ed-list { border-top: none; }
  .archive-year li { position: relative; }
  .archive-preview { position: absolute; right: 18%; top: 50%; z-index: 5; display: block; width: 240px; aspect-ratio: 1.45; overflow: hidden; pointer-events: none; visibility: hidden; opacity: 0; background: var(--red-4); box-shadow: 0 24px 60px rgba(15,30,50,.28); transform: translateY(-42%) rotate(4deg) scale(.9); transition: opacity .35s, transform .45s cubic-bezier(.2,.8,.2,1), visibility 0s .45s; }
  .archive-preview img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ed-row:hover .archive-preview, .ed-row:focus-visible .archive-preview { visibility: visible; opacity: 1; transform: translateY(-50%) rotate(-3deg) scale(1); transition-delay: 0s; }
  @media (min-width: 1440px) {
    .archive-year { margin-bottom: 104px; }
    .archive-year-title { margin-bottom: 30px; }
    .archive-year-title span { font-size: 120px; }
    .archive-year .ed-list { column-gap: var(--wide-gap); }
    .archive-discovery { margin-bottom: 76px; }
  }
  @media (min-width: 1900px) {
    .archive-year-title span { font-size: 136px; }
    .archive-year { margin-bottom: 124px; }
  }
  @media (max-width: 1000px), (hover: none), (prefers-reduced-motion: reduce) {
    .archive-preview { display: none; }
  }
  @media (max-width: 760px) {
    .archive-cats { display: none; }
    .archive-year { margin-bottom: 40px; }
  }
</style>
