---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { postUrl } from '../utils/columns.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="归档" description={`全部 ${posts.length} 篇文章的时间归档`}>
  <div class="ed-wrap">
    <PageHero
      index="04"
      label="ARCHIVE"
      title="归档"
      lede="写下的每一篇，都留在这里。"
      meta={[{ value: String(posts.length), label: '篇文章' }, { value: String(years.length), label: '个年份' }]}
    />

    {years.map((y) => (
      <section class="archive-year" data-reveal>
        <h2 class="archive-year-title"><span>{y}</span><i aria-hidden="true"></i></h2>
        <ol class="ed-list">
          {byYear.get(y)!.map((p, i) => (
            <li>
              <a class="ed-row" href={postUrl(p)}>
                <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{p.data.title}</span>
                <span class="row-meta archive-cats">{p.data.categories[0]}</span>
                <time class="row-meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>

<style>
  .archive-year { margin-bottom: 56px; }
  .archive-year-title { display: flex; align-items: center; gap: 24px; margin: 0 0 20px; }
  .archive-year-title span { font-size: clamp(32px, 3.6vw, 46px); font-weight: 500; color: var(--red-1); letter-spacing: .06em; }
  .archive-year-title i { flex: 1; height: 1px; background: var(--color-card-border); }
  .archive-year .ed-list { border-top: none; }
  @media (max-width: 760px) {
    .archive-cats { display: none; }
    .archive-year { margin-bottom: 40px; }
  }
</style>
