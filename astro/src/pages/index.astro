---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MoodKnob from '../components/MoodKnob.astro';
import InkPlate from '../components/InkPlate.astro';
import { columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';
import { TYPING_STRINGS, SOCIAL } from '../consts.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
const recent = posts.slice(0, 6);
const aiColumn = columns.find((c) => c.data.category === '人工智能学习');
const aiPool = aiColumn ? columnPosts(aiColumn, posts) : [];
const essay = aiPool.length ? aiPool[Math.floor(Math.random() * aiPool.length)] : undefined;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shortTitle = (t: string) => t.split('——')[0];
---

<Base pageClass="is-home">
  <section id="header" class="folio" aria-label="开篇">
    <div class="folio-pin">
      <div class="margin-rule" aria-hidden="true"><i></i></div>
      <div class="folio-copy">
        <p class="site-kicker">注</p>
        <h1 class="scene-title">
          <span class="title-line">在键盘上，</span>
          <span class="title-line">写下又一行注释。</span>
        </h1>
        <p class="folio-next">代码之外，仍有世界。</p>
        <div class="folio-actions">
          <p class="folio-typing">
            <span id="typing-text">{TYPING_STRINGS[0]}</span><span class="typing-cursor" aria-hidden="true"></span>
          </p>
          <a class="folio-link" href={postUrl(latest)}>阅读最新一篇</a>
          <a class="folio-more" href="#journal" data-folio-next>往下读</a>
        </div>
      </div>
      <a class="folio-latest" href={postUrl(latest)}>
        <InkPlate seed={latest.id} />
        <span class="folio-latest-kicker">最近一篇</span>
        <strong>{shortTitle(latest.data.title)}</strong>
      </a>
    </div>
  </section>

  <div id="journal" class="journal">
    <section class="opening" data-reveal>
      <span class="site-kicker">序</span>
      <p class="opening-text">
        这里不追逐热点，只记录那些<span>真正想明白的事</span>。
        从大模型的原理，到 Python 的第一行代码，再到数学与世界运作的方式——慢慢写，认真想。
      </p>
    </section>

    <section class="series" aria-labelledby="series-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="site-kicker">专栏</span>
          <h2 id="series-title">按顺序读完</h2>
        </div>
        <a class="text-link" href="/columns/">全部专栏</a>
      </header>
      <ol class="serial-list">
        {columns.map((c, i) => {
          const list = columnPosts(c, posts);
          const first = list[0];
          return (
            <li data-reveal>
              <a class="serial-row" href={`/categories/${slugifyTaxonomy(c.data.category)}/`}>
                <span class="serial-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="serial-name">{c.data.title.replace('专栏', '')}</span>
                <span class="serial-count">{String(list.length).padStart(2, '0')} 篇</span>
                <span class="serial-next">{first ? shortTitle(first.data.title) : '开始阅读'}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {essay && (
      <section class="interlude" data-reveal aria-label="随笔">
        <InkPlate seed={essay.id} />
        <div>
          <span class="site-kicker">随笔</span>
          <h2><a href={postUrl(essay)}>{shortTitle(essay.data.title)}</a></h2>
          <p>{essay.data.description}</p>
          <a class="text-link" href={postUrl(essay)}>读这一篇</a>
        </div>
      </section>
    )}

    <section class="latest" aria-labelledby="latest-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="site-kicker">最近</span>
          <h2 id="latest-title">最近写下</h2>
        </div>
        <a class="text-link" href="/archives/">全部归档</a>
      </header>
      <ol class="serial-list">
        {recent.map((p, i) => (
          <li data-reveal>
            <a class="serial-row" href={postUrl(p)}>
              <span class="serial-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="serial-name">{shortTitle(p.data.title)}</span>
              <time class="serial-count" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="serial-next">{p.data.categories[0]}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="colophon" data-reveal>
      <div>
        <span class="site-kicker">关于</span>
        <h2>一个仍在学习的人，<br />和一块留给好奇心的地方。</h2>
        <p>写代码，也写那些代码解释不了的问题。如果这个角落对你有用，欢迎常来。</p>
        <div class="colophon-links">
          <a class="text-link" href="/about/">关于我</a>
          {SOCIAL.github && <a class="text-link" href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>}
        </div>
        <div class="colophon-tags">
          {tags.slice(0, 8).map((t) => <a href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>)}
        </div>
      </div>
      <MoodKnob />
    </section>
  </div>

  <script define:vars={{ strings: TYPING_STRINGS }}>
    (function () {
      'use strict';
      var el = document.getElementById('typing-text');
      if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var order = strings.slice(), idx = 0, pos = order[0].length, deleting = true;
      function tick() {
        if (document.hidden) return setTimeout(tick, 1000);
        var s = order[idx];
        if (!deleting) {
          pos++; el.textContent = s.slice(0, pos);
          if (pos >= s.length) { deleting = true; return setTimeout(tick, 2400); }
          setTimeout(tick, 110);
        } else {
          pos--; el.textContent = s.slice(0, pos);
          if (pos <= 0) { deleting = false; idx = (idx + 1) % order.length; return setTimeout(tick, 600); }
          setTimeout(tick, 45);
        }
      }
      setTimeout(tick, 2800);
    })();
  </script>
  <script>
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var folio = document.querySelector('.folio');
      if (!folio) return;
      var pin = folio.querySelector('.folio-pin');
      var next = folio.querySelector('.folio-next');
      var link = folio.querySelector('[data-folio-next]');
      function place(p) {
        var shown = p > 0.62 ? 1 : 0;
        if (pin) pin.style.setProperty('--rule', Math.round(p * 100) + '%');
        if (pin) pin.style.setProperty('--next', String(shown));
        if (next) next.setAttribute('aria-hidden', shown ? 'false' : 'true');
      }
      if (reduced.matches) { place(1); return; }
      folio.classList.add('has-motion');
      var ticking = false;
      function update() {
        ticking = false;
        var distance = folio.offsetHeight - (pin ? pin.offsetHeight : 0);
        var p = distance > 0 ? Math.max(0, Math.min(1, -folio.getBoundingClientRect().top / distance)) : 1;
        place(p);
      }
      function schedule() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      if (link) link.addEventListener('click', function (event) {
        event.preventDefault();
        var distance = folio.offsetHeight - (pin ? pin.offsetHeight : 0);
        var target = folio.offsetTop + distance;
        var start = window.scrollY;
        var t0 = performance.now();
        function step(now) {
          var t = Math.min(1, (now - t0) / 700);
          var e = t * t * (3 - 2 * t);
          window.scrollTo(0, start + (target - start) * e);
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    })();
  </script>
</Base>

<style>
  .folio { position: relative; height: 118svh; min-height: 760px; }
  .folio-pin {
    --rule: 8%;
    --next: 0;
    position: sticky; top: 72px; height: calc(100svh - 72px); min-height: 560px;
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(220px, 320px);
    gap: clamp(32px, 5vw, 72px); align-items: center;
    padding: 4vh clamp(24px, 6vw, 88px) 6vh calc(clamp(24px, 6vw, 88px) + 28px);
  }
  .margin-rule { position: absolute; left: clamp(20px, 4vw, 56px); top: 12%; bottom: 14%; width: 1px; background: var(--color-card-border); }
  .margin-rule i { display: block; width: 1px; height: var(--rule); background: var(--color-accent); }
  .site-kicker { color: var(--color-text-strong); }
  .scene-title { margin: 0; font-weight: 500; font-size: clamp(40px, 5vw, 76px); line-height: 1.28; letter-spacing: .02em; color: var(--color-text-strong); }
  .title-line { display: block; }
  .folio-next {
    max-width: 12em; margin: 22px 0 0;
    font-family: var(--font-serif); font-size: clamp(28px, 3vw, 44px); line-height: 1.35;
    color: var(--color-text-strong); opacity: var(--next);
  }
  .folio-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 28px; }
  .folio-typing { margin: 0; min-height: 1.5em; color: var(--color-text-muted); font-size: 15px; }
  .typing-cursor { display: inline-block; width: 1px; height: .9em; margin-left: 4px; background: currentColor; animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .folio-link, .folio-more, .text-link { color: var(--color-text-strong); border-bottom: 1px solid var(--color-accent); padding-bottom: 2px; }
  .folio-link:hover, .folio-more:hover, .text-link:hover { color: var(--color-accent); }
  .folio-latest {
    display: grid; gap: 14px; align-content: end; color: var(--color-text-strong);
    border-top: 1px solid var(--color-card-border); padding-top: 16px;
  }
  .folio-latest :global(.ink-plate-svg) { width: 100%; aspect-ratio: 1; height: auto; border: 1px solid var(--color-card-border); }
  .folio-latest-kicker { font-size: 13px; letter-spacing: .12em; }
  .folio-latest strong { font-family: var(--font-serif); font-weight: 500; font-size: 22px; line-height: 1.45; }

  .journal { max-width: 980px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 64px) 48px; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 8px; }
  .section-head h2, .colophon h2, .interlude h2 { margin: 0; font-weight: 500; letter-spacing: .03em; }
  .section-head h2 { font-size: clamp(28px, 3vw, 40px); }
  .opening { padding: 88px 0 72px; }
  .opening-text { margin: 0; max-width: 20em; font-family: var(--font-serif); font-size: clamp(22px, 2.2vw, 32px); line-height: 1.85; color: var(--color-text-strong); }
  .opening-text span { color: var(--color-accent); }
  .series, .latest { padding-bottom: 72px; }
  .serial-list { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .serial-row {
    display: grid; grid-template-columns: 36px minmax(0, 1.4fr) auto minmax(0, 1fr);
    gap: 12px 18px; align-items: baseline; padding: 16px 2px;
    border-bottom: 1px solid var(--color-card-border); color: var(--color-text-strong);
  }
  .serial-no { color: var(--color-accent); font-size: 13px; }
  .serial-name { font-family: var(--font-serif); font-size: 20px; line-height: 1.45; }
  .serial-count, .serial-next { color: var(--color-text-muted); font-size: 14px; }
  .serial-row:hover .serial-name { color: var(--color-accent); }
  .interlude {
    display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 36px; align-items: center;
    margin-bottom: 72px; padding-top: 12px;
  }
  .interlude :global(.ink-plate-svg) { border: 1px solid var(--color-card-border); }
  .interlude h2 { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.4; }
  .interlude h2 a { color: var(--color-text-strong); }
  .interlude p { margin: 12px 0 18px; color: var(--color-text-muted); line-height: 1.85; }
  .colophon { display: grid; grid-template-columns: minmax(0, 1.4fr) 260px; gap: 36px; align-items: center; padding: 28px 0 72px; border-top: 1px solid var(--color-card-border); }
  .colophon h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.45; }
  .colophon p { max-width: 36em; color: var(--color-text-muted); line-height: 1.85; }
  .colophon-links { display: flex; gap: 22px; margin-top: 8px; }
  .colophon-tags { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: 22px; }
  .colophon-tags a { color: var(--color-text-muted); }
  .colophon-tags a:hover { color: var(--color-accent); }

  @media (max-width: 800px) {
    .folio { height: auto; min-height: 0; }
    .folio-pin { position: static; height: auto; min-height: 0; grid-template-columns: 1fr; padding: 36px 22px 28px 46px; }
    .scene-title { font-size: clamp(32px, 9vw, 42px); }
    .folio-next { opacity: 1; font-size: 26px; }
    .folio-latest { max-width: 220px; }
    .interlude, .colophon, .serial-row { grid-template-columns: 1fr; }
    .serial-count, .serial-next { display: none; }
    .opening { padding: 56px 0 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .folio { height: auto; min-height: 0; }
    .folio-pin { position: static; height: auto; }
    .folio-next { opacity: 1; }
    .typing-cursor { animation: none; }
  }
</style>
