---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MoodKnob from '../components/MoodKnob.astro';
import { columnOf, columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';
import { TYPING_STRINGS, SOCIAL, AUTHOR } from '../consts.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
const heroIndex = posts.slice(0, 3);
const recent = posts.slice(1, 8);
const essays = posts.filter((p) => !columnOf(p, columns)).slice(0, 2);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shortTitle = (t: string) => t.split('——')[0];
---

<Base pageClass="is-home">
  <!-- 开场：封面 → 胶片切片 → 最新作品卡，三幕共用一个滚动轨道 -->
  <section id="header" class="scene" aria-label="站点封面">
    <div class="scene-pin">
      <div class="scene-card">
        <div class="scene-media">
          <img
            class="scene-image"
            src="/images/hero-bg-1920.jpg"
            srcset="/images/hero-bg-760.jpg 760w, /images/hero-bg-1280.jpg 1280w, /images/hero-bg-1920.jpg 1920w"
            sizes="100vw"
            alt="夕阳下延伸至云海的山路"
            fetchpriority="high"
          />
        </div>
        <div class="scene-shade" aria-hidden="true"></div>
        <div class="scene-glint" aria-hidden="true"></div>
      </div>

      <div class="scene-shards" aria-hidden="true">
        {Array.from({ length: 7 }, (_, i) => (
          <div class="scene-shard" style={`--slice:${i}`}>
            <img src="/images/hero-bg-1920.jpg" alt="" loading="eager" />
          </div>
        ))}
      </div>

      <div class="scene-after" aria-hidden="true">
        <span class="after-orbit after-orbit-a"></span>
        <span class="after-orbit after-orbit-b"></span>
        <p class="after-ghost">BEYOND<br />THE CODE</p>
        <p class="after-caption">每一次下潜，都有新的风景。</p>
      </div>

      <a class="scene-focus" href={postUrl(latest)} aria-label={`阅读最新文章：${latest.data.title}`}>
        <div class="focus-card">
          {latest.data.cover && <img src={latest.data.cover} alt="" loading="lazy" />}
          <div class="focus-card-shade"></div>
          <div class="focus-card-copy">
            <span class="focus-label">LATEST ENTRY / 001</span>
            <h2>{shortTitle(latest.data.title)}</h2>
            <span class="focus-read">进入这一篇 <i>↗</i></span>
          </div>
          <span class="focus-edge" aria-hidden="true"></span>
        </div>
      </a>

      <div class="scene-frame" aria-hidden="true"></div>
      <div class="scene-content">
        <p class="scene-eyebrow"><span></span> FIELD NOTES OF A CURIOUS MIND</p>
        <h1 class="scene-title">
          <span class="title-line">在键盘上，</span>
          <span class="title-line title-indent">写下又一行注释。</span>
        </h1>
        <div class="scene-intro">
          <p class="scene-typing">
            <span id="typing-text">{TYPING_STRINGS[0]}</span><span class="typing-cursor" aria-hidden="true"></span>
          </p>
          <a class="scene-link" href={postUrl(latest)}>
            <span>阅读最新一篇</span>
            <svg viewBox="0 0 32 16" width="32" height="16" fill="none" aria-hidden="true"><path d="M0 8h29M22 1l7 7-7 7" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
        </div>
      </div>

      <div class="scene-side" aria-hidden="true">
        <span>CODE</span><i></i><span>CURIOSITY</span><i></i><span>LIFE</span>
      </div>
      <div class="scene-bottom">
        <div class="scene-edition">
          <span>VOL. 01</span>
          <span>{new Date().getFullYear()} / ZIYOU</span>
        </div>
        <nav class="scene-index" aria-label="最新文章速览">
          {heroIndex.map((p, i) => (
            <a href={postUrl(p)} class="scene-index-item">
              <span class="index-no">0{i + 1}</span>
              <span class="index-title">{shortTitle(p.data.title)}</span>
              <span class="index-arrow">↗</span>
            </a>
          ))}
        </nav>
      </div>
      <div class="scene-progress" aria-hidden="true">
        <span class="progress-label">AN OPENING IN THREE ACTS</span>
        <span class="progress-track"><i></i></span>
        <span class="progress-no">01</span>
      </div>
      <a class="scene-scroll" href="#journal" aria-label="跳过开场，向下阅读"><span></span>SCROLL TO EXPLORE</a>
    </div>
  </section>

  <div id="journal" class="journal">
    <!-- 序：让内容自己说话 -->
    <section class="opening" data-reveal>
      <span class="section-no">00 / PROLOGUE</span>
      <p class="opening-text">
        这里不追逐热点，只记录那些<span>真正想明白的事</span>。<br />
        从大模型的原理，到 Python 的第一行代码，<br class="desktop-br" />
        再到数学与世界运作的方式——慢慢写，认真想。
      </p>
      <div class="opening-mark" aria-hidden="true">“</div>
    </section>

    <!-- 专题：非对称杂志编排 -->
    <section class="series" aria-labelledby="series-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="section-no">01 / SERIES</span>
          <h2 id="series-title">专栏</h2>
        </div>
        <a class="text-link" href="/columns/">全部专栏 <span>↗</span></a>
      </header>
      <div class="series-grid">
        {columns.map((c, i) => {
          const list = columnPosts(c, posts);
          const first = list[0];
          return (
            <article class={`series-item series-item-${i + 1}`} data-reveal>
              <div class="flashcard-stage">
                <span class="flashcard-shadow" aria-hidden="true"></span>
                <a class="series-visual" href={`/categories/${slugifyTaxonomy(c.data.category)}/`} data-flashcard="series">
                  <img src={c.data.cover} alt={c.data.title} loading="lazy" />
                  <span class="flashcard-foil" aria-hidden="true"></span>
                  <span class="series-count">{String(list.length).padStart(2, '0')} 篇</span>
                  <span class="series-ord">SERIES 0{i + 1}</span>
                </a>
              </div>
              <div class="series-body">
                <h3><a href={`/categories/${slugifyTaxonomy(c.data.category)}/`}>{c.data.title.replace('专栏', '')}</a></h3>
                <p>{c.data.description}</p>
                <a class="series-start" href={first ? postUrl(first) : '/columns/'}>
                  <span class="series-start-no">01</span>
                  <span>{first ? shortTitle(first.data.title) : '开始阅读'}</span>
                  <span class="series-start-arrow">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 随想：大尺幅横图 + 文字 -->
    {essays[0] && (
      <section class="interlude" data-reveal aria-label="数理随想">
        <div class="flashcard-stage">
          <span class="flashcard-shadow" aria-hidden="true"></span>
          <a class="interlude-image" href={postUrl(essays[0])} data-flashcard="interlude">
            <img src={essays[0].data.cover} alt={essays[0].data.title} loading="lazy" />
            <span class="flashcard-foil" aria-hidden="true"></span>
          </a>
        </div>
        <div class="interlude-copy">
          <span class="section-no">02 / ESSAY</span>
          <p class="interlude-kicker">在公式之外</p>
          <h2><a href={postUrl(essays[0])}>{essays[0].data.title}</a></h2>
          <p>{essays[0].data.description}</p>
          <a class="text-link" href={postUrl(essays[0])}>读这篇随想 <span>↗</span></a>
        </div>
      </section>
    )}

    <!-- 最新：编号目录，悬停浮图 -->
    <section class="latest" aria-labelledby="latest-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="section-no">03 / LATEST</span>
          <h2 id="latest-title">最近写下</h2>
        </div>
        <span class="section-aside">{posts.length} 篇文字，仍在生长</span>
      </header>
      <ol class="latest-list">
        {recent.map((p, i) => (
          <li data-reveal style={`--i:${Math.min(i, 3)}`}>
            <a class="latest-row" href={postUrl(p)}>
              <span class="latest-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="latest-title-wrap">
                <h3>{shortTitle(p.data.title)}</h3>
                <span class="latest-cat">{p.data.categories[0]}</span>
              </span>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="latest-arrow">↗</span>
              <span class="latest-preview" aria-hidden="true">
                <span class="preview-card" data-flashcard="preview">
                  {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
                  <span class="flashcard-foil" aria-hidden="true"></span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="latest-more" data-reveal>
        <a class="text-link" href="/archives/">翻阅全部归档 <span>↗</span></a>
      </div>
    </section>

    <!-- 尾章：作者与氛围 -->
    <section class="colophon" data-reveal>
      <div class="colophon-main">
        <span class="section-no">04 / ABOUT</span>
        <h2>一个仍在学习的人，<br />和一块留给好奇心的地方。</h2>
        <p>写代码，也写那些代码解释不了的问题。如果这个角落对你有用，欢迎常来。</p>
        <div class="colophon-links">
          <a class="text-link" href="/about/">关于我 <span>↗</span></a>
          {SOCIAL.github && <a class="text-link" href={SOCIAL.github} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
        </div>
        <div class="colophon-tags">
          {tags.slice(0, 8).map((t) => <a href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>)}
        </div>
      </div>
      <div class="colophon-knob"><MoodKnob /></div>
    </section>
  </div>

  <script define:vars={{ strings: TYPING_STRINGS }}>
    (function () {
      'use strict';
      var el = document.getElementById('typing-text');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var order = strings.slice(), idx = 0, pos = order[0].length, deleting = true;
      for (var i = order.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1)), t = order[i]; order[i] = order[j]; order[j] = t;
      }
      function tick() {
        var s = order[idx];
        if (!deleting) {
          pos++; el.textContent = s.slice(0, pos);
          if (pos >= s.length) { deleting = true; return setTimeout(tick, 2400); }
          setTimeout(tick, 110);
        } else {
          pos--; el.textContent = s.slice(0, pos);
          if (pos <= 0) { deleting = false; idx = (idx + 1) % order.length; return setTimeout(tick, 600); }
          setTimeout(tick, 45);
        }
      }
      setTimeout(tick, 3200);
    })();
  </script>
  <script>
    /* 三幕开场：真实滚动距离映射时间线，快速拖动与反向滚动都保持一致。 */
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) return;
      var scene = document.querySelector('.scene');
      if (!scene) return;
      scene.classList.add('has-motion');
      var pin = scene.querySelector('.scene-pin');
      var shards = scene.querySelectorAll('.scene-shard');
      var bottom = scene.querySelector('.scene-bottom');
      var ticking = false;
      var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
      var smooth = function (v) { v = clamp(v); return v * v * (3 - 2 * v); };
      var ramp = function (p, a, b) { return smooth((p - a) / (b - a)); };
      function update() {
        ticking = false;
        var rect = scene.getBoundingClientRect();
        var distance = scene.offsetHeight - window.innerHeight;
        if (distance <= 0) return;
        var p = clamp(-rect.top / distance);
        var split = ramp(p, 0.12, 0.46);
        var reveal = ramp(p, 0.43, 0.72);
        var arrive = ramp(p, 0.58, 0.88);
        var exit = ramp(p, 0.88, 1);
        var mobile = window.innerWidth <= 760;
        var st = pin.style;
        st.setProperty('--scene-p', p.toFixed(4));
        st.setProperty('--hero-y', (-split * 16 - reveal * 35) + 'vh');
        st.setProperty('--hero-scale', (1.04 + split * 0.09).toFixed(3));
        st.setProperty('--hero-blur', (split * 8).toFixed(2) + 'px');
        st.setProperty('--hero-opacity', (1 - ramp(p, 0.27, 0.5)).toFixed(3));
        st.setProperty('--copy-y', (-split * 25).toFixed(2) + 'vh');
        st.setProperty('--copy-opacity', (1 - ramp(p, 0.08, 0.36)).toFixed(3));
        st.setProperty('--copy-blur', (split * 7).toFixed(2) + 'px');
        st.setProperty('--after-opacity', reveal.toFixed(3));
        st.setProperty('--after-scale', (0.76 + reveal * 0.24).toFixed(3));
        st.setProperty('--focus-opacity', arrive.toFixed(3));
        st.setProperty('--focus-x', ((1 - arrive) * (mobile ? 34 : 58) - exit * 4) + 'vw');
        st.setProperty('--focus-y', ((1 - arrive) * 20 - exit * 9) + 'vh');
        st.setProperty('--focus-ry', ((1 - arrive) * -48 + exit * 12).toFixed(2) + 'deg');
        st.setProperty('--focus-rz', ((1 - arrive) * 9 - exit * 2).toFixed(2) + 'deg');
        st.setProperty('--focus-scale', (0.82 + arrive * 0.18).toFixed(3));
        st.setProperty('--scene-progress', (p * 100).toFixed(2) + '%');
        st.setProperty('--chapter', p < 0.4 ? '"01"' : p < 0.72 ? '"02"' : '"03"');
        pin.classList.toggle('is-after', p > 0.42);
        bottom.style.opacity = String(1 - ramp(p, 0.04, 0.26));
        bottom.style.transform = 'translateY(' + split * 70 + 'px)';
        for (var i = 0; i < shards.length; i++) {
          var dir = i % 2 ? 1 : -1;
          var local = ramp(p, 0.13 + Math.abs(i - 3) * 0.012, 0.55 + Math.abs(i - 3) * 0.012);
          var x = dir * local * (12 + Math.abs(i - 3) * 10);
          var y = local * ((i - 3) * 13);
          var ry = dir * local * (mobile ? 26 : 64);
          var rz = dir * local * (3 + Math.abs(i - 3) * 1.5);
          var scale = 1 - local * 0.28;
          var opacity = 1 - ramp(p, 0.49 + Math.abs(i - 3) * 0.012, 0.71 + Math.abs(i - 3) * 0.012);
          shards[i].style.transform = 'translate3d(' + x + 'vw,' + y + 'vh,0) rotateY(' + ry + 'deg) rotateZ(' + rz + 'deg) scale(' + scale + ')';
          shards[i].style.opacity = String(opacity);
        }
      }
      function schedule() {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener('load', schedule);
      update();
    })();
  </script>
  <script>
    /* 滚动闪卡：每张卡有不同的空间轨迹；光泽与投影跟随同一个视角。 */
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) return;
      var nodes = document.querySelectorAll('[data-flashcard]');
      if (!nodes.length) return;

      // 非对称轨迹让一组卡片像被同一只手依次翻看，而不是同步摆动。
      var SERIES = [
        { ry: -34, rx: 22, rz: -4.5, drift: 7, lift: 46 },
        { ry: 30, rx: -24, rz: 4, drift: -6, lift: 40 }
      ];
      var INTERLUDE = { ry: 22, rx: 30, rz: -2.5, drift: 4, lift: 32 };
      function previewSig(i) {
        return { ry: i % 2 ? 26 : -26, rx: (i % 3 - 1) * 12, rz: i % 2 ? 5 : -5, drift: 0, lift: 24 };
      }
      var counts = { series: 0, preview: 0 };
      var items = [];
      Array.prototype.forEach.call(nodes, function (card) {
        var kind = card.getAttribute('data-flashcard'), sig = null;
        if (kind === 'series') sig = SERIES[counts.series++ % SERIES.length];
        else if (kind === 'interlude') sig = INTERLUDE;
        else if (kind === 'preview') sig = previewSig(counts.preview++);
        if (!sig) return;
        var item = { card: card, host: card.closest('.flashcard-stage') || card, sig: sig, on: false, hover: false, hx: 0, hy: 0, tx: 0, ty: 0 };
        items.push(item);
        // 指针只提供很小的额外倾角，滚动仍是主导，避免卡片跟手乱晃。
        card.addEventListener('pointerenter', function (e) {
          if (e.pointerType === 'touch') return;
          item.hover = true; schedule();
        });
        card.addEventListener('pointermove', function (e) {
          if (e.pointerType === 'touch') return;
          var r = card.getBoundingClientRect();
          item.tx = Math.max(-1, Math.min(1, (e.clientX - r.left) / r.width * 2 - 1));
          item.ty = Math.max(-1, Math.min(1, (e.clientY - r.top) / r.height * 2 - 1));
          schedule();
        }, { passive: true });
        card.addEventListener('pointerleave', function () {
          item.hover = false; item.tx = 0; item.ty = 0; schedule();
        });
      });

      var small = window.matchMedia('(max-width: 760px)');
      var ticking = false, hoverFrame = 0;
      function schedule() {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
        if (!hoverFrame) hoverFrame = requestAnimationFrame(settle);
      }
      function set(st, name, value) { st.setProperty(name, value); }
      function update() {
        ticking = false;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var d = small.matches ? 0.42 : 1;
        for (var i = 0; i < items.length; i++) {
          var it = items[i];
          if (!it.on && !it.hover) continue;
          var r = it.host.getBoundingClientRect();
          if (r.bottom < -120 || r.top > vh + 120) continue;
          var span = vh / 2 + r.height / 2;
          var p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / span));
          var s = it.sig;
          // 居中时保留一点倾角与悬浮感；离开视口再自然收拢，不会像贴在屏幕上的死图。
          var rest = Math.abs(p) < 0.12 ? 1 - Math.abs(p) / 0.12 : 0;
          var ry = (s.ry * p + s.ry * 0.13 * rest) * d + it.hx * 6;
          var rx = (s.rx * p - s.rx * 0.1 * rest) * d - it.hy * 5;
          var rz = s.rz * p * d;
          var tz = ((1 - Math.abs(p)) * s.lift + (it.hover ? 18 : 0)) * d;
          var drift = -s.drift * p * d;
          var energy = Math.min(1, Math.abs(p) * 1.6 + (it.hover ? 0.28 : 0));
          var gx = 50 - ry * 2.4;
          var st = it.host.style;
          set(st, '--fc-rx', rx.toFixed(2) + 'deg');
          set(st, '--fc-ry', ry.toFixed(2) + 'deg');
          set(st, '--fc-rz', rz.toFixed(2) + 'deg');
          set(st, '--fc-tz', tz.toFixed(1) + 'px');
          set(st, '--fc-drift', drift.toFixed(1) + 'px');
          set(st, '--fc-scale', (1 + (1 - Math.abs(p)) * 0.025).toFixed(3));
          set(st, '--fc-gx', gx.toFixed(1) + '%');
          set(st, '--fc-gy', (50 + rx * 1.4).toFixed(1) + '%');
          set(st, '--fc-glint', (0.18 + energy * 0.62).toFixed(3));
          set(st, '--fc-holo', (0.12 + energy * 0.52).toFixed(3));
          set(st, '--fc-hue', (p * 95 + it.hx * 24).toFixed(1) + 'deg');
          set(st, '--fc-px', (-ry * 0.3).toFixed(1) + 'px');
          set(st, '--fc-py', (rx * 0.24).toFixed(1) + 'px');
          set(st, '--fc-shx', (-ry * 1.1).toFixed(1) + 'px');
          set(st, '--fc-shy', (18 + Math.abs(rx) * 0.7).toFixed(1) + 'px');
          set(st, '--fc-sho', (0.34 + (1 - Math.abs(p)) * 0.3).toFixed(3));
        }
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            for (var j = 0; j < items.length; j++) {
              if (items[j].card === en.target) { items[j].on = en.isIntersecting; break; }
            }
          });
          schedule();
        }, { rootMargin: '25% 0px 25% 0px' });
        items.forEach(function (it) { io.observe(it.card); });
      } else {
        items.forEach(function (it) { it.on = true; });
      }
      // 桌面端只在滚动帧之外补少量缓动帧；后台标签页不运行。
      var last = 0;
      function settle(now) {
        hoverFrame = 0;
        if (document.hidden) { last = 0; return; }
        var moving = false;
        if (!last || now - last >= 24) {
          last = now;
          items.forEach(function (it) {
            var nx = it.hover ? it.tx : 0, ny = it.hover ? it.ty : 0;
            if (Math.abs(nx - it.hx) > 0.005 || Math.abs(ny - it.hy) > 0.005) moving = true;
            it.hx += (nx - it.hx) * 0.16;
            it.hy += (ny - it.hy) * 0.16;
          });
          if (moving) update();
        }
        if (moving) requestAnimationFrame(settle); else last = 0;
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener('load', schedule);
      update();
      // 只在指针移动期间启动缓动帧，不为每张卡建立永久 rAF。
    })();
  </script>
</Base>

<style>
  /* ===== 三幕开场 ===== */
  .scene { position: relative; height: 100svh; min-height: 660px; overflow: hidden; color: #fff; background: #0a1420; }
  .scene.has-motion { height: 240svh; min-height: 1500px; overflow: visible; }
  .scene-pin {
    --hero-y: 0vh; --hero-scale: 1.04; --hero-blur: 0px; --hero-opacity: 1;
    --copy-y: 0vh; --copy-opacity: 1; --copy-blur: 0px;
    --after-opacity: 0; --after-scale: .76; --focus-opacity: 0;
    --focus-x: 58vw; --focus-y: 20vh; --focus-ry: -48deg; --focus-rz: 9deg; --focus-scale: .82;
    --scene-progress: 0%; --chapter: "01";
    position: sticky; top: 0; height: 100svh; min-height: 620px; overflow: hidden;
    isolation: isolate; perspective: 1400px; perspective-origin: 50% 46%;
    background: #0a1420;
  }
  .scene-card {
    position: absolute; inset: 0; overflow: hidden;
    background: #26384c;
    opacity: var(--hero-opacity);
    transform: translate3d(0, var(--hero-y), 0) scale(var(--hero-scale));
    will-change: transform, opacity;
  }
  .scene-media { position: absolute; inset: 0; }
  .scene-image { width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: center 42%; animation: scene-in 2.2s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes scene-in { from { opacity: .2; filter: blur(8px); } to { opacity: 1; filter: blur(0); } }
  .scene-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(12,25,40,.62) 0%, rgba(12,25,40,.24) 48%, rgba(12,25,40,.02) 78%),
      linear-gradient(0deg, rgba(10,21,34,.88) 0%, transparent 42%),
      linear-gradient(180deg, rgba(10,21,34,.35), transparent 30%);
  }
  .scene-glint { display: none; }
  .scene-shards { display: none; position: absolute; inset: 0; z-index: 2; pointer-events: none; transform-style: preserve-3d; }
  .scene-shard {
    --step: calc(100% / 7);
    position: absolute; top: -2px; bottom: -2px;
    left: calc(var(--slice) * var(--step)); width: calc(var(--step) + 1px);
    overflow: hidden; opacity: 0; transform-origin: center;
    box-shadow: 0 24px 70px rgba(0,0,0,.3);
    will-change: transform, opacity;
  }
  .scene-shard img {
    position: absolute; top: 0; height: 100%; max-width: none; width: 700%;
    left: calc(var(--slice) * -100%); object-fit: cover; object-position: center 42%;
    filter: blur(var(--hero-blur));
  }
  .scene-after {
    position: absolute; inset: 0; z-index: 0; overflow: hidden;
    opacity: var(--after-opacity);
    background:
      radial-gradient(circle at 68% 42%, rgba(97,147,185,.22), transparent 34%),
      radial-gradient(circle at 12% 92%, rgba(137,87,74,.18), transparent 40%),
      linear-gradient(125deg, #09131f, #152738 64%, #0b1724);
    transform: scale(var(--after-scale));
  }
  .after-orbit { position: absolute; border: 1px solid rgba(185,213,234,.14); border-radius: 50%; transform: rotate(-24deg); }
  .after-orbit-a { width: 78vw; height: 42vw; right: -15vw; top: 10%; }
  .after-orbit-b { width: 58vw; height: 70vw; right: 0; top: -8%; }
  .after-ghost {
    position: absolute; left: 5vw; top: 50%; margin: 0;
    transform: translateY(-50%); font-size: clamp(72px,10.5vw,180px); line-height: .98;
    letter-spacing: -.04em; font-weight: 600; color: transparent;
    -webkit-text-stroke: 1px rgba(192,217,236,.17);
  }
  .after-caption { position: absolute; left: 6vw; bottom: 20%; margin: 0; font-size: 12px; letter-spacing: .24em; color: rgba(223,234,244,.55); }
  .scene-focus {
    position: absolute; z-index: 3; right: 9vw; top: 50%; width: min(42vw, 580px);
    color: #fff; opacity: var(--focus-opacity); pointer-events: none;
    transform: translate3d(var(--focus-x), calc(-50% + var(--focus-y)), 0) rotateY(var(--focus-ry)) rotateZ(var(--focus-rz)) scale(var(--focus-scale));
    transform-style: preserve-3d; will-change: transform, opacity;
  }
  .scene-pin.is-after .scene-focus { pointer-events: auto; }
  .focus-card { position: relative; aspect-ratio: 1.12; overflow: hidden; background: #1d3246; box-shadow: -40px 50px 100px rgba(0,0,0,.42), 0 0 0 1px rgba(255,255,255,.16); }
  .focus-card > img { width: 100%; height: 100%; max-width: none; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .scene-focus:hover .focus-card > img { transform: scale(1.06); }
  .focus-card-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(6,15,26,.94), rgba(6,15,26,.04) 70%); }
  .focus-card-copy { position: absolute; left: 8%; right: 8%; bottom: 9%; }
  .focus-label { font-size: 9px; letter-spacing: .25em; color: rgba(255,255,255,.68); }
  .focus-card-copy h2 { margin: 14px 0 24px; color: #fff; font-size: clamp(25px,2.8vw,42px); line-height: 1.4; font-weight: 400; letter-spacing: .04em; }
  .focus-read { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.26); padding-top: 16px; font-size: 11px; letter-spacing: .14em; }
  .focus-read i { font-size: 20px; font-style: normal; transition: transform .3s; }
  .scene-focus:hover .focus-read i { transform: translate(4px,-4px); }
  .focus-edge { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,.24) 49%, transparent 60%); background-size: 260% 100%; background-position: var(--scene-progress) 0; mix-blend-mode: screen; pointer-events: none; }
  .scene-frame { position: absolute; z-index: 4; inset: 112px 4.5vw 118px; border: 1px solid rgba(255,255,255,.13); pointer-events: none; opacity: var(--copy-opacity); }
  .scene-content {
    position: absolute; z-index: 4; left: clamp(40px,8vw,140px); top: 50%; width: min(76vw,1400px); padding-right: 5vw;
    opacity: var(--copy-opacity); filter: blur(var(--copy-blur)); pointer-events: auto;
    transform: translateY(calc(-52% + var(--copy-y)));
    will-change: transform, opacity;
  }
  .scene.has-motion .scene-content { pointer-events: auto; }
  .scene-pin.is-after .scene-content { pointer-events: none; }
  .scene-eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 30px; font-size: 10px; letter-spacing: .36em; color: rgba(255,255,255,.72); animation: rise-in 1s .25s both; }
  .scene-eyebrow span { width: 36px; height: 1px; background: rgba(255,255,255,.65); }
  .scene-title { margin: 0; font-weight: 400; font-size: clamp(46px,6.8vw,104px); line-height: 1.32; letter-spacing: .04em; color: #fff; text-shadow: 0 3px 30px rgba(10,20,35,.25); }
  .title-line { display: block; animation: rise-in 1.2s cubic-bezier(.16,.8,.26,1) both; }
  .title-line:nth-child(1) { animation-delay: .4s; }
  .title-line:nth-child(2) { animation-delay: .58s; }
  .title-indent { padding-left: 1.15em; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(36px); } to { opacity: 1; transform: none; } }
  .scene-intro { display: flex; align-items: center; gap: 42px; margin-top: 44px; padding-left: 1.3em; animation: rise-in 1s .85s both; }
  .scene-typing { margin: 0; min-height: 1.5em; font-size: 13px; letter-spacing: .12em; color: rgba(255,255,255,.74); }
  .typing-cursor { display: inline-block; width: 1px; height: 1em; margin-left: 5px; background: currentColor; vertical-align: -2px; animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .scene-link { display: inline-flex; align-items: center; gap: 18px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,.55); color: #fff; font-size: 13px; letter-spacing: .14em; }
  .scene-link svg { transition: transform .35s; }
  .scene-link:hover svg { transform: translateX(7px); }
  .scene-side { position: absolute; right: 6.6vw; top: 50%; display: flex; align-items: center; gap: 16px; writing-mode: vertical-rl; font-size: 9px; letter-spacing: .42em; color: rgba(255,255,255,.65); transform: translateY(-70%); }
  .scene-side i { width: 1px; height: 36px; background: rgba(255,255,255,.35); }
  .scene-bottom { position: absolute; z-index: 5; left: 4.5vw; right: 4.5vw; bottom: 0; display: flex; align-items: stretch; border-top: 1px solid rgba(255,255,255,.2); }
  .scene-edition { display: flex; flex-direction: column; justify-content: center; gap: 7px; width: 24%; padding: 24px 24px 24px 0; font-size: 9px; letter-spacing: .24em; color: rgba(255,255,255,.65); }
  .scene-index { display: grid; grid-template-columns: repeat(3,1fr); flex: 1; }
  .scene-index-item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 26px 24px; border-left: 1px solid rgba(255,255,255,.18); color: #fff; transition: background .35s; }
  .scene-index-item:hover { background: rgba(255,255,255,.09); color: #fff; }
  .index-no { font-size: 10px; color: rgba(255,255,255,.5); letter-spacing: .1em; }
  .index-title { font-size: 12px; letter-spacing: .04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .index-arrow { opacity: .6; transition: transform .3s; }
  .scene-index-item:hover .index-arrow { transform: translate(3px,-3px); opacity: 1; }
  .scene-scroll { position: absolute; z-index: 6; right: 4.5vw; bottom: 128px; display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.6); font-size: 9px; letter-spacing: .3em; writing-mode: vertical-rl; }
  .scene-scroll span { display: none; }
  @keyframes scroll-pulse { 50% { transform: scaleY(.55); transform-origin: top; opacity: .4; } }
  .scene-progress {
    position: absolute; z-index: 6; left: 4.5vw; right: 4.5vw; bottom: 34px;
    display: flex; align-items: center; gap: 18px; pointer-events: none;
    opacity: var(--after-opacity); color: rgba(218,231,242,.62);
    font-size: 8px; letter-spacing: .26em;
  }
  .progress-track { width: 130px; height: 1px; background: rgba(255,255,255,.18); overflow: hidden; }
  .progress-track i { display: block; width: var(--scene-progress); height: 100%; background: #dbe7f1; }
  .progress-no { margin-left: auto; font-size: 12px; }
  .progress-no::before { content: var(--chapter); }
  /* JS 未启动时保持原始封面，不让装饰层挡住文字与链接。 */
  .scene-shards, .scene-after, .scene-focus, .scene-progress { visibility: hidden; }
  .scene.has-motion .scene-shards, .scene.has-motion .scene-after,
  .scene.has-motion .scene-focus, .scene.has-motion .scene-progress { visibility: visible; }
  .scene.has-motion .scene-shards { display: block; }

  /* ===== 正文 ===== */
  .journal { max-width: 1280px; margin: 0 auto; padding: 0 clamp(24px,5vw,64px); }
  .section-no { display: block; margin-bottom: 22px; font-size: 10px; letter-spacing: .28em; color: var(--red-2); }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 46px; }
  .section-head h2 { margin: 0; font-size: clamp(28px,3vw,42px); font-weight: 500; letter-spacing: .06em; }
  .section-aside { font-size: 12px; color: var(--color-text-muted); }
  .text-link { display: inline-flex; align-items: center; gap: 14px; padding-bottom: 7px; border-bottom: 1px solid var(--red-3); font-size: 12.5px; letter-spacing: .1em; color: var(--red-1); }
  .text-link span { transition: transform .3s; }
  .text-link:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .text-link:hover span { transform: translate(3px,-3px); }

  .opening { position: relative; padding: 150px 0 140px; }
  .opening-text { position: relative; z-index: 1; margin: 0; font-family: var(--font-serif); font-size: clamp(23px,2.7vw,36px); line-height: 1.95; letter-spacing: .05em; color: var(--color-text-strong); }
  .opening-text span { color: var(--red-1); box-shadow: inset 0 -.35em 0 var(--red-4); }
  .opening-mark { position: absolute; right: 3%; top: 64px; font-family: Georgia,serif; font-size: 230px; line-height: 1; color: var(--red-4); opacity: .65; }

  .series { padding-bottom: 150px; }
  .series-grid { display: grid; grid-template-columns: 1.18fr 1fr; gap: clamp(28px,4.5vw,68px); align-items: start; }
  .series-item-2 { margin-top: 104px; }
  .series-visual { position: relative; display: block; overflow: hidden; background: var(--red-4); }
  .series-item-1 .series-visual { aspect-ratio: 1.28; }
  .series-item-2 .series-visual { aspect-ratio: 1.05; }
  .series-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .series-visual:hover img { transform: scale(1.055); }
  .series-count { position: absolute; right: 18px; top: 18px; padding: 7px 12px; background: rgba(15,28,44,.6); backdrop-filter: blur(8px); color: #fff; font-size: 10px; letter-spacing: .16em; }
  .series-ord { position: absolute; left: 20px; bottom: 18px; font-size: 9px; letter-spacing: .3em; color: rgba(255,255,255,.85); text-shadow: 0 1px 8px #000; }
  .series-body { padding-top: 26px; }
  .series-body h3 { margin: 0 0 14px; font-size: clamp(24px,2.3vw,32px); font-weight: 500; letter-spacing: .05em; }
  .series-body h3 a { color: var(--color-text-strong); }
  .series-body h3 a:hover { color: var(--red-1); }
  .series-body > p { margin: 0 0 24px; font-size: 14px; line-height: 1.95; color: var(--color-text-muted); }
  .series-start { display: flex; align-items: center; gap: 16px; padding: 16px 0; border-top: 1px solid var(--color-card-border); border-bottom: 1px solid var(--color-card-border); font-size: 13px; color: var(--color-text-strong); }
  .series-start-no { color: var(--red-2); font-size: 11px; }
  .series-start-arrow { margin-left: auto; color: var(--red-1); transition: transform .3s; }
  .series-start:hover .series-start-arrow { transform: translateX(6px); }

  .interlude { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(36px,5vw,80px); align-items: center; margin: 0 calc(clamp(24px,5vw,64px) * -1) 150px; padding: 80px clamp(24px,5vw,64px); background: var(--color-surface-muted); }
  .interlude-image { display: block; overflow: hidden; aspect-ratio: 1.5; }
  .interlude-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s; }
  .interlude-image:hover img { transform: scale(1.04); }
  .interlude-kicker { margin: 0 0 12px; font-size: 12px; letter-spacing: .2em; color: var(--red-2); }
  .interlude-copy h2 { margin: 0 0 20px; font-size: clamp(24px,2.4vw,34px); line-height: 1.55; font-weight: 500; }
  .interlude-copy h2 a { color: var(--color-text-strong); }
  .interlude-copy > p:not(.interlude-kicker) { font-size: 14px; line-height: 1.95; color: var(--color-text-muted); margin-bottom: 28px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .latest { padding-bottom: 140px; }
  .latest-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .latest-row { position: relative; display: flex; align-items: center; gap: clamp(20px,3vw,46px); padding: 28px 6px; border-bottom: 1px solid var(--color-card-border); color: var(--color-text-strong); }
  .latest-no { width: 28px; flex-shrink: 0; font-size: 11px; color: var(--red-2); }
  .latest-title-wrap { flex: 1; min-width: 0; }
  .latest-title-wrap h3 { margin: 0 0 7px; font-size: clamp(17px,1.7vw,22px); font-weight: 500; letter-spacing: .03em; transition: color .3s, transform .35s; }
  .latest-cat { font-size: 11px; letter-spacing: .12em; color: var(--color-text-muted); }
  .latest-row time { font-size: 11px; letter-spacing: .08em; color: var(--color-text-muted); }
  .latest-arrow { font-size: 18px; color: var(--red-2); transition: transform .3s; }
  .latest-row:hover .latest-title-wrap h3 { color: var(--red-1); transform: translateX(8px); }
  .latest-row:hover .latest-arrow { transform: translate(4px,-4px); }
  .latest-preview { position: absolute; right: 15%; top: 50%; z-index: 5; width: 240px; aspect-ratio: 1.45; pointer-events: none; opacity: 0; transform: translateY(-42%) rotate(4deg) scale(.9); transition: opacity .35s, transform .45s cubic-bezier(.2,.8,.2,1); box-shadow: 0 24px 60px rgba(15,30,50,.28); }
  .preview-card { display: block; width: 100%; height: 100%; overflow: hidden; background: var(--red-4); }
  .latest-preview img { width: 100%; height: 100%; object-fit: cover; }
  .latest-row:hover .latest-preview { opacity: 1; transform: translateY(-50%) rotate(-3deg) scale(1); }
  .latest-more { margin-top: 36px; text-align: right; }

  .colophon { display: grid; grid-template-columns: 1fr 270px; gap: 70px; align-items: center; padding: 70px 0 100px; border-top: 1px solid var(--color-card-border); }
  .colophon-main h2 { margin: 0 0 22px; font-size: clamp(26px,3vw,40px); font-weight: 500; line-height: 1.65; letter-spacing: .04em; }
  .colophon-main > p { max-width: 480px; font-size: 14px; line-height: 1.95; color: var(--color-text-muted); }
  .colophon-links { display: flex; gap: 30px; margin-top: 28px; }
  .colophon-tags { display: flex; flex-wrap: wrap; gap: 12px 18px; margin-top: 44px; }
  .colophon-tags a { font-size: 11px; color: var(--color-text-muted); }
  .colophon-tags a:hover { color: var(--red-1); }
  .colophon-knob :global(.mood-knob-widget) { border: none; box-shadow: none; background: transparent; }

  /* ===== 滚动闪卡 ===== */
  .flashcard-stage {
    --fc-rx: 0deg; --fc-ry: 0deg; --fc-rz: 0deg; --fc-tz: 0px; --fc-drift: 0px;
    --fc-scale: 1; --fc-gx: 50%; --fc-gy: 50%; --fc-glint: 0; --fc-holo: 0;
    --fc-hue: 0deg; --fc-px: 0px; --fc-py: 0px; --fc-shx: 0px; --fc-shy: 18px; --fc-sho: 0;
    position: relative;
    isolation: isolate;
    perspective: 1050px;
    perspective-origin: 50% 46%;
  }
  .flashcard-shadow {
    position: absolute; left: 4%; right: 4%; bottom: -9%; height: 22%; z-index: -1;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(9,22,39,.58), rgba(9,22,39,.16) 42%, transparent 70%);
    filter: blur(10px);
    opacity: var(--fc-sho);
    transform: translate3d(var(--fc-shx), var(--fc-shy), 0) scaleX(.92);
    pointer-events: none;
  }
  .series-visual, .interlude-image, .preview-card {
    position: relative;
    transform-style: preserve-3d;
    transform: translate3d(var(--fc-drift), 0, var(--fc-tz)) rotateX(var(--fc-rx)) rotateY(var(--fc-ry)) rotateZ(var(--fc-rz)) scale(var(--fc-scale));
    box-shadow: 0 1px 0 rgba(255,255,255,.5), 0 18px 50px rgba(12,28,48,.13);
    backface-visibility: hidden;
    will-change: transform;
  }
  .series-visual img, .interlude-image img, .preview-card img {
    transform: scale(1.09) translate3d(var(--fc-px), var(--fc-py), 0);
    will-change: transform;
  }
  .series-visual:hover img { transform: scale(1.13) translate3d(var(--fc-px), var(--fc-py), 0); }
  .interlude-image:hover img { transform: scale(1.12) translate3d(var(--fc-px), var(--fc-py), 0); }
  .flashcard-foil {
    position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none;
    opacity: var(--fc-holo);
    background:
      radial-gradient(circle at var(--fc-gx) var(--fc-gy), rgba(255,255,255,.58), transparent 24%),
      conic-gradient(from calc(210deg + var(--fc-hue)) at var(--fc-gx) var(--fc-gy),
        rgba(255,70,145,.34), rgba(255,215,95,.25), rgba(72,255,202,.3),
        rgba(80,152,255,.34), rgba(190,90,255,.26), rgba(255,70,145,.34));
    background-size: 100% 100%, 180% 180%;
    background-position: center, var(--fc-gx) var(--fc-gy);
    mix-blend-mode: color-dodge;
    filter: saturate(1.35);
  }
  /* 窄镜面高光 + 宽柔光：随倾角扫过，而非整张图泛白。 */
  .series-visual::after, .interlude-image::after, .preview-card::after {
    content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      linear-gradient(112deg, transparent 32%, rgba(255,255,255,.06) 40%, rgba(255,251,235,.8) 48%, rgba(255,255,255,.18) 51%, transparent 60%),
      radial-gradient(ellipse at var(--fc-gx) var(--fc-gy), rgba(255,255,255,.36), transparent 42%);
    background-size: 260% 100%, 100% 100%;
    background-position: var(--fc-gx) 0, center;
    mix-blend-mode: screen;
    opacity: var(--fc-glint);
  }
  /* 极细的亮边让斜角时有真实卡片的厚度，而不是图片简单变形。 */
  .series-visual::before, .interlude-image::before, .preview-card::before {
    content: ""; position: absolute; inset: 0; z-index: 4; pointer-events: none;
    border: 1px solid rgba(255,255,255,.48);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), inset 0 -22px 34px rgba(8,24,44,.12);
    opacity: calc(.3 + var(--fc-glint));
  }
  .series-count, .series-ord { z-index: 5; transform: translateZ(24px); }
  .preview-card {
    --fc-rx: 0deg; --fc-ry: 0deg; --fc-rz: 0deg; --fc-tz: 0px; --fc-drift: 0px;
    --fc-scale: 1; --fc-gx: 50%; --fc-gy: 50%; --fc-glint: 0; --fc-holo: 0;
    --fc-hue: 0deg; --fc-px: 0px; --fc-py: 0px;
    pointer-events: none;
  }
  @supports (transform: translateZ(1px)) {
    .series-visual, .interlude-image, .preview-card { transform-origin: 50% 48%; }
  }

  @media (max-width: 1000px) {
    .scene-frame { inset: 92px 4vw 112px; }
    .scene-title { font-size: clamp(42px,7.4vw,72px); }
    .scene-side { display: none; }
    .scene-edition { display: none; }
    .scene-focus { right: 6vw; width: min(55vw,520px); }
    .after-ghost { font-size: 11vw; }
    .latest-preview { display: none; }
    .colophon { gap: 30px; }
  }
  @media (max-width: 760px) {
