    .opening-mark { right: 0; top: 56px; font-size: 280px; }
    .section-head { margin-bottom: 62px; }
    .series { padding-bottom: 160px; }
    .series-grid {
      grid-template-columns: 1.18fr .94fr 1.06fr .94fr;
      gap: clamp(24px, 2.2vw, 44px);
      padding: 0;
      align-items: start;
    }
    .series-item-2, .series-item-3, .series-item-4 { margin-top: 0; }
    .series-item-1 .series-visual { aspect-ratio: 1.28; }
    .series-item-2 .series-visual { aspect-ratio: 1.02; }
    .series-item-3 .series-visual { aspect-ratio: 1.22; }
    .series-item-4 .series-visual { aspect-ratio: 1.08; }
    .series-body { padding-top: 24px; }
    .series-body h3 { font-size: clamp(22px, 1.45vw, 30px); }
    .series-body > p { font-size: 14px; }
    .interlude {
      /* 杂志跨页：中等图（限宽）+ 右侧文案，整体居中，图不随视口膨胀。 */
      grid-template-columns: minmax(0, 720px) minmax(320px, .9fr);
      justify-content: center;
      gap: clamp(48px, 4vw, 88px);
      align-items: center;
      margin-right: calc(-1 * var(--wide-gutter));
      margin-left: calc(-1 * var(--wide-gutter));
      margin-bottom: 150px;
      padding: clamp(56px, 4vw, 84px) var(--wide-gutter);
    }
    .interlude-image { aspect-ratio: 1.5; }
    .interlude-copy h2 { font-size: clamp(28px, 1.9vw, 36px); }
    .interlude-copy > p:not(.interlude-kicker) { font-size: 15px; -webkit-line-clamp: 5; }
    .latest { padding-bottom: 190px; }
    .latest-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px var(--wide-gap); border-top: 0; }
    .latest-list > li { min-width: 0; border-top: 1px solid var(--color-card-border); border-bottom: 1px solid var(--color-card-border); background: color-mix(in srgb, var(--color-surface) 58%, transparent); }
    .latest-list > li:nth-child(even) { transform: none; }
    /* 卡片统一顶对齐，节奏靠列间留白与呼吸，不做会让标题错行的垂直位移。 */
    .latest-row { display: grid; grid-template-columns: 24px minmax(0, 1fr) 16px; grid-template-rows: auto auto; gap: 8px 16px; min-height: 132px; padding: 26px 20px; border-bottom: 0; align-items: start; }
    .latest-row .latest-no { grid-row: 1; padding-top: 5px; }
    .latest-title-wrap { grid-row: 1; }
    .latest-row time { grid-column: 2; grid-row: 2; }
    .latest-arrow { grid-column: 3; grid-row: 1; }
    .latest-title-wrap h3 { font-size: clamp(17px, 1.15vw, 22px); line-height: 1.55; }
    .latest-cat { font-size: 12px; }
    .latest-preview { right: 6%; width: 230px; }
    .latest-more { margin-top: 60px; }
    .colophon { grid-template-columns: minmax(0, 1.5fr) minmax(300px, .7fr); gap: var(--wide-gap); padding: 94px 0 120px; }
    .colophon-main h2 { font-size: clamp(36px, 3vw, 54px); }
    .colophon-main > p { max-width: 560px; font-size: 15px; }
    .colophon-knob { justify-self: end; min-width: 280px; }
  }
  @media (min-width: 1900px) {
    .opening { grid-template-columns: minmax(180px, .4fr) minmax(0, 1.8fr); }
    .series-grid { gap: 44px; }
    .series-item-2 { margin-top: 96px; }
    .series-item-4 { margin-top: 132px; }
    .latest-list { column-gap: 64px; }
    .latest-row { min-height: 142px; }
  }

  @media (max-width: 1000px) {
