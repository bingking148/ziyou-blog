  }
  .s2-frame-line {
    position: absolute; left: 58%; top: 18%; width: 16%; height: 28%;
    border: 2px solid color-mix(in srgb, var(--s2-white) 55%, transparent);
  }
  .s2-corner { position: absolute; width: 18px; height: 18px; border: 0 solid var(--s2-white); }
  .s2-c1 { left: 6%; top: 11%; border-top-width: 3px; border-left-width: 3px; border-color: #111; }
  .s2-c2 { right: 5%; top: 11%; border-top-width: 3px; border-right-width: 3px; }
  .s2-c3 { left: 6%; bottom: 9%; border-bottom-width: 3px; border-left-width: 3px; border-color: #111; }
  .s2-c4 { right: 5%; bottom: 9%; border-bottom-width: 3px; border-right-width: 3px; border-color: #c41e3a; }
  .s2-ticks-h {
    position: absolute; left: 12%; top: 72%; display: flex; gap: 7px; align-items: flex-end;
  }
  .s2-ticks-h i { width: 16px; height: 3px; background: #111; }
  .s2-ticks-h i:nth-child(3n) { height: 10px; background: #111; }
  .s2-bars-mid {
    position: absolute; left: 64%; top: 22%; width: 120px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .s2-bars-mid i { display: block; height: 4px; background: var(--s2-white); }
  .s2-bars-mid i:nth-child(2) { width: 72%; background: var(--s2-cyan); }
  .s2-bars-mid i:nth-child(3) { width: 48%; background: #c41e3a; }
  .s2-bars-mid i:nth-child(4) { width: 86%; }
  .s2-bars-mid i:nth-child(5) { width: 34%; background: var(--s2-cyan); }
  .s2-bars-mid i:nth-child(6) { width: 60%; }
  .s2-ticks-v {
    position: absolute; right: 3.2%; top: 18%; display: flex; flex-direction: column; gap: 8px;
  }
  .s2-ticks-v i { width: 14px; height: 3px; background: var(--s2-white); }
  .s2-ticks-v i:nth-child(3n) { width: 22px; background: #c41e3a; }
  .s2-grid {
    position: absolute; left: 14%; bottom: 11%;
    display: grid; grid-template-columns: repeat(8, 8px); gap: 5px;
  }
  .s2-grid-b {
    left: auto; right: 31%; top: 58%; bottom: auto;
    grid-template-columns: repeat(4, 9px);
  }
  .s2-grid i { width: 8px; height: 8px; background: #111; }
  .s2-grid-b i { background: var(--s2-white); }
  .s2-grid-b i:nth-child(4n) { background: #c41e3a; }
  .s2-grid-b i:nth-child(5n) { background: var(--s2-cyan); }
  .s2-shard { position: absolute; background: var(--s2-white); }
  .s2-shard-a { left: 12%; top: 10%; width: 54px; height: 16px; background: #111; transform: skewX(-18deg); }
  .s2-shard-b { left: 51%; top: 13%; width: 22px; height: 22px; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .s2-shard-c { left: 70%; bottom: 16%; width: 42px; height: 8px; background: var(--s2-cyan); }
  .s2-tri { position: absolute; width: 0; height: 0; border-style: solid; }
  .s2-tri-a { left: 10%; bottom: 22%; border-width: 0 0 14px 12px; border-color: transparent transparent #111 transparent; }
  .s2-tri-b { right: 18%; bottom: 18%; border-width: 12px 12px 0 0; border-color: var(--s2-cyan) transparent transparent transparent; }
  .s2-tri-c { left: 68%; top: 62%; border-width: 0 10px 12px 0; border-color: transparent #c41e3a transparent transparent; }
  .s2-float {
    position: absolute; left: 9%; top: 78%;
    padding: 4px 8px; background: #111; color: #f5c518;
    font-family: Arial, Helvetica, sans-serif; font-weight: 900; font-size: 13px;
  }
  .s2-float-b { left: auto; right: 31%; top: 14%; background: var(--s2-white); color: var(--s2-deep); letter-spacing: .16em; font-size: 11px; }
  .s2-float-c { left: 62%; top: 34%; background: transparent; color: var(--s2-white); border: 2px solid var(--s2-white); letter-spacing: .12em; }
  .s2-float-d { left: auto; right: 34%; bottom: 20%; top: auto; background: var(--s2-deep); color: var(--s2-cyan); letter-spacing: .18em; font-size: 11px; }
  .scene.has-motion .s2-rail-top { animation: s2-dash 1.8s linear infinite; }
  .scene.has-motion .s2-grid i:nth-child(odd) { animation: chip-blink 2.2s steps(2) infinite; }
  .scene.has-motion .s2-bars-mid i:nth-child(odd) { animation: chip-blink 2.8s steps(2) infinite; }
  .scene.has-motion .s2-float-c { animation: drift-y 4.2s ease-in-out infinite alternate; }
  @keyframes s2-dash { to { background-position: 20px 0; } }
  .s2-board {
    position: absolute; z-index: 2;
    left: max(36px, 8%); right: max(36px, 7%);
    top: 11%; bottom: 16%;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(280px, .9fr);
    gap: 18px; align-items: start;
  }
  .s2-copy { position: relative; padding: 12px 12px 12px 22px; }
  .s2-copy::before {
    content: ""; position: absolute; left: 0; top: 6%; bottom: 18%; width: 7px; background: #111;
  }
  .s2-kicker {
    margin: 0 0 12px; font-size: 12px; letter-spacing: .28em; font-weight: 800; color: #111;
  }
  .s2-title {
    margin: 0 0 12px;
    font-size: clamp(72px, 6.8vw, 112px);
    line-height: .86; letter-spacing: -.03em;
    font-weight: 400; color: #111;
  }
  .s2-line { display: block; width: max-content; max-width: 100%; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .scene.has-motion .s2-title { pointer-events: auto; cursor: default; }
  .scene.has-motion .s2-title:hover :global(.live-ch) { animation-play-state: paused; }
  .scene.has-motion .s2-title:hover .s2-a { transform: rotate(-3.2deg) translate3d(calc(10px + var(--px, 0) * 8px), -6px, 0); }
  .scene.has-motion .s2-title:hover .s2-b { transform: rotate(4deg) translate3d(calc(16px + var(--px, 0) * 10px), 0, 0); }
  .scene.has-motion .s2-title:hover .s2-c { transform: rotate(-2.2deg) translate3d(calc(-8px + var(--px, 0) * 8px), 3px, 0); }
  .scene.has-motion .s2-title:hover .s2-d { transform: rotate(-3deg) translate3d(calc(20px + var(--px, 0) * 8px), 2px, 0); }
  .scene.has-motion .s2-title:hover .s2-e { transform: rotate(2.2deg) translate3d(calc(6px + var(--px, 0) * 8px), 5px, 0); text-shadow: 8px 8px 0 rgba(0, 0, 0, .35); }
  .s2-a, .s2-c, .s2-e {
    font-family: "Archivo Black", "Arial Black", Arial, sans-serif;
    font-weight: 400; text-transform: uppercase; letter-spacing: -.035em;
  }
  .s2-b, .s2-d {
    font-family: "Fraunces", Georgia, "Times New Roman", serif;
    font-style: italic; font-weight: 900; letter-spacing: -.02em;
    color: #111;
  }
  .s2-a { font-size: 1.08em; transform: rotate(-2.1deg); transform-origin: 0 75%; }
  .s2-b { margin: .2em 0 .55em 1.55em; font-size: .48em; line-height: 1; transform: rotate(2.2deg); transform-origin: 0 50%; }
  .s2-c { margin: .14em 0 0 -.02em; font-size: .84em; transform: rotate(-1.2deg); transform-origin: 0 80%; }
  .s2-d { margin: .28em 0 .4em 2.3em; font-size: .44em; line-height: 1; transform: rotate(-1.8deg); transform-origin: 0 40%; }
  .s2-e { margin-top: .1em; font-size: .98em; transform: rotate(1.2deg); transform-origin: 0 30%; }
  .s2-e i {
    display: inline-block; margin-left: .06em;
    font-family: "Fraunces", Georgia, serif; font-style: italic; font-weight: 900;
    font-size: .55em; line-height: 1; color: #111;
    transform: translateY(-.08em) rotate(8deg);
  }
  .s2-note {
    margin: 0 0 18px; max-width: 28em;
    font-size: 16px; line-height: 1.6; font-weight: 700; color: #111;
  }
  .s2-meta { display: flex; gap: 8px; margin: 0; }
  .s2-meta span {
    padding: 5px 8px; background: #111; color: #f5c518;
    font-size: 11px; letter-spacing: .14em; font-weight: 800;
  }
  .s2-meta span:nth-child(2) { background: #111; color: #f5c518; }
  .s2-panel {
    align-self: start; margin-top: 0; width: min(100%, 420px); justify-self: end;
    padding: 18px 18px 14px;
    background: var(--s2-white); color: var(--s2-deep);
    border: 3px solid var(--s2-white);
    box-shadow: 12px 12px 0 color-mix(in srgb, #041428 35%, var(--s2-deep));
  }
  .s2-panel-k {
    margin: 0 0 8px; font-size: 11px; letter-spacing: .28em; font-weight: 800; color: #c41e3a;
  }
  .s2-menu { display: flex; flex-direction: column; }
  .s2-menu span {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 8px; border-top: 2px solid color-mix(in srgb, var(--s2-deep) 18%, transparent);
    font-weight: 800; letter-spacing: .16em; font-size: 15px;
  }
  .s2-menu b { font-family: Arial, Helvetica, sans-serif; color: #c41e3a; font-weight: 900; }
  .s2-menu span:nth-child(2) { background: var(--s2-cyan); }
  .s2-menu span:nth-child(3) { background: var(--s2-deep); color: #fff; }
  .s2-menu span:nth-child(3) b { color: var(--s2-cyan); }
  .scene-focus {
    position: absolute; z-index: 8; right: max(36px, 7%); top: 52%; width: min(24vw, 340px);
    color: var(--s2-ink); pointer-events: none;
    opacity: var(--open, 0);
    transform: translate3d(0, calc((1 - var(--arrive, 0)) * 26px), 0);
  }
  .scene.has-motion .scene-focus { pointer-events: auto; }
  .focus-card {
    position: relative; aspect-ratio: 1.35; overflow: hidden; background: var(--s2-deep);
    border: 3px solid var(--s2-white);
    box-shadow: 10px 10px 0 #c41e3a;
    transition: box-shadow .4s ease, transform .45s cubic-bezier(.2,.7,.2,1);
  }
  .scene.has-motion .focus-card { animation: focus-idle 5.4s ease-in-out infinite alternate; }
  @keyframes focus-idle {
    from { transform: translate3d(0, 0, 0) rotate(-0.4deg); }
    to { transform: translate3d(0, -8px, 0) rotate(0.45deg); }
  }
  .scene.has-motion .scene-focus:hover .focus-card {
    animation: none;
    transform: translate3d(calc(var(--px, 0) * 12px), calc(-12px + var(--py, 0) * 8px), 0) rotate(calc(var(--px, 0) * -2deg));
    box-shadow: 18px 18px 0 #c41e3a;
  }
  .focus-card > img { width: 100%; height: 100%; max-width: none; object-fit: cover; filter: grayscale(.15) saturate(1.05); transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .scene.has-motion .scene-focus:hover .focus-card > img { transform: scale(1.06) translate3d(calc(var(--px, 0) * -8px), calc(var(--py, 0) * -6px), 0); }
  .focus-card-copy { transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .scene.has-motion .scene-focus:hover .focus-card-copy { transform: translate3d(calc(var(--px, 0) * 6px), calc(var(--py, 0) * -4px), 0); }
  .scene.has-motion .scene-focus:hover .focus-read i { transform: translate(5px, -4px); }
  .focus-card-shade { position: absolute; z-index: 2; inset: 0; background: linear-gradient(0deg, rgba(6,40,74,.88), rgba(6,40,74,.04) 62%); }
  .focus-card-copy { position: absolute; z-index: 3; left: 8%; right: 8%; bottom: 8%; }
  .focus-label { font-family: var(--s2-ui); font-size: 11px; letter-spacing: .18em; color: var(--s2-cyan); }
  .focus-card-copy h2 { margin: 8px 0 12px; color: #f7fbff; font-family: var(--s2-display); font-size: clamp(16px, 1.2vw, 22px); line-height: 1.35; font-weight: 700; }
  .focus-read { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(247,251,255,.45); padding-top: 10px; font-size: 12px; letter-spacing: .12em; color: #f7fbff; }
  .focus-read i { font-style: normal; display: inline-block; transition: transform .35s; }
  .page-exit {
    position: fixed; inset: 0; z-index: 500; pointer-events: none;
    background: var(--color-bg);
    transform: scaleX(0); transform-origin: left center;
    transition: transform .48s cubic-bezier(.7, 0, .2, 1);
  }
  .page-exit::after { content: ""; position: absolute; top: 0; bottom: 0; right: 0; width: 12px; background: #c41e3a; }
  :global(html.is-leaving) .page-exit { transform: scaleX(1); pointer-events: auto; }
  .focus-edge { display: none; }
  .scene-content {
    position: absolute; z-index: 8; left: 22%; top: 26%; width: min(58vw, 820px);
    opacity: calc(1 - var(--copy));
    transform: translate3d(0, calc(var(--drift) * -10px + var(--copy) * -18px), 0);
    pointer-events: none;
  }
  .scene.has-motion .scene-content { pointer-events: none; }
  .scene.has-motion .scene-title,
  .scene.has-motion .scene-intro { pointer-events: auto; }
  .scene-eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 18px; font-size: 12px; letter-spacing: .22em; color: var(--muted); font-weight: 700; }
  .scene-eyebrow span { width: 42px; height: 4px; background: #c41e3a; }
  .scene-title { margin: 0; font-weight: 700; font-size: clamp(44px, 5.2vw, 78px); line-height: 1.05; letter-spacing: .01em; color: var(--ink); font-family: var(--font-serif), "Songti SC", serif; }
  .title-shift { display: block; transform-origin: left center; }
  .title-line { display: block; width: fit-content; transition: transform .45s cubic-bezier(.2,.7,.2,1), box-shadow .45s, text-shadow .45s; }
  .title-shift-a { transform: scaleX(calc(1 + var(--copy) * .05)) translateY(calc(var(--copy) * -8px)); }
  .title-shift-b { margin-top: 10px; margin-left: 12%; transform: scaleX(calc(1 - var(--copy) * .14)); }
  .title-shift-b .title-line { box-shadow: inset 0 -0.28em 0 color-mix(in srgb, var(--s2-ochre) calc(var(--morph) * 100%), #c41e3a); }
  .scene.has-motion .scene-title { cursor: default; }
  .scene.has-motion .scene-title:hover .title-shift-a .title-line {
    transform: translate3d(calc(8px + var(--px, 0) * 7px), calc(-4px + var(--py, 0) * 4px), 0) rotate(-0.6deg);
    text-shadow: 7px 7px 0 color-mix(in srgb, #c41e3a 40%, transparent);
  }
  .scene.has-motion .scene-title:hover .title-shift-b .title-line {
    transform: translate3d(calc(14px + var(--px, 0) * 8px), 2px, 0);
    box-shadow: inset 0 -0.2em 0 #c41e3a;
  }
  .scene.has-motion .scene-title:hover :global(.live-ch) { animation-play-state: paused; }
  .scene-intro { display: flex; align-items: center; gap: 28px; margin-top: 26px; }
  .scene-typing { margin: 0; min-height: 1.5em; font-size: 14px; letter-spacing: .06em; color: var(--muted); font-weight: 700; }
  .typing-cursor { display: inline-block; width: 1px; height: 1em; margin-left: 5px; background: currentColor; vertical-align: -2px; animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .scene-link { display: inline-flex; align-items: center; gap: 14px; padding-bottom: 6px; border-bottom: 3px solid var(--ink); color: var(--ink); font-size: 14px; letter-spacing: .06em; font-weight: 700; }
  .scene-link svg { transition: transform .35s; }
  .scene-link:hover svg { transform: translateX(6px); }
  .scene-side {
    position: absolute; z-index: 8; right: 1.4vw; top: 18%;
    display: flex; align-items: center; gap: 10px; writing-mode: vertical-rl;
    font-size: 12px; letter-spacing: .28em; color: var(--ink); font-weight: 700;
    opacity: calc(1 - var(--copy));
  }
  .scene-side i { width: 2px; height: 28px; background: #c41e3a; }
  .scene-bottom {
    position: absolute; z-index: 8; left: 18%; right: 8%; bottom: 0;
    display: flex; align-items: stretch; border-top: 3px solid var(--ink); background: var(--paper);
    opacity: calc(1 - var(--copy));
    transform: translate3d(0, calc(var(--copy) * 110%), 0);
  }
  .scene-edition { display: flex; flex-direction: column; justify-content: center; gap: 7px; width: 16%; padding: 16px 16px 16px 0; font-size: 12px; letter-spacing: .12em; color: var(--muted); font-weight: 700; }
  .scene-index { display: grid; grid-template-columns: repeat(3,1fr); flex: 1; }
  .scene-index-item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 16px; border-left: 3px solid var(--ink); color: var(--ink); }
  .scene-index-item:hover { background: var(--slab); color: var(--on-slab); }
  .index-no { font-size: 11px; color: #c41e3a; letter-spacing: .08em; font-weight: 700; }
  .index-title { font-size: 12px; letter-spacing: .04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .index-arrow { opacity: .7; }
  .scene-scroll {
    position: absolute; z-index: 9; right: 4.5vw; bottom: 108px;
    display: grid; place-items: center; width: 54px; aspect-ratio: 1;
    color: #f7f4ee; background: #c41e3a; box-shadow: 6px 6px 0 #111;
    opacity: var(--scroll-cta-opacity);
  }
  .scene-scroll svg { position: relative; z-index: 1; }
  .scroll-label {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    font-size: 12px; letter-spacing: .14em; white-space: nowrap; color: var(--ink); font-weight: 700;
  }
  .scene-pin.is-past-intro .scene-scroll,
  .scene-pin.is-cinematic .scene-scroll { opacity: 0; pointer-events: none; }
  .scene-progress {
    position: absolute; z-index: 6; left: 8%; right: auto; bottom: 18px; width: min(34vw, 420px);
    display: flex; align-items: center; gap: 16px; height: 36px; pointer-events: none;
    opacity: var(--arrive); color: var(--s2-white);
    background: transparent;
    font-size: 12px; letter-spacing: .16em; font-weight: 700; white-space: nowrap;
  }
  .progress-track { width: 120px; height: 3px; background: color-mix(in srgb, var(--s2-ink) 22%, transparent); overflow: hidden; }
  .progress-track i { display: block; width: var(--scene-progress); height: 100%; background: var(--s2-ochre); }
  .progress-no { margin-left: auto; font-size: 12px; }
  .progress-no::before { content: var(--chapter); }
  .scene-after, .scene-focus, .scene-progress { visibility: hidden; }
  .scene.has-motion .scene-after,
  .scene.has-motion .scene-focus,
  .scene.has-motion .scene-progress { visibility: visible; }

  /* ===== 正文 ===== */
  .journal { max-width: 1280px; margin: 0 auto; padding: 0 clamp(24px,5vw,64px); background: var(--color-bg); }
  .section-no { display: block; margin-bottom: 22px; font-size: 10px; letter-spacing: .28em; color: var(--red-2); }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 46px; }
  .section-head h2 { margin: 0; font-size: clamp(28px,3vw,42px); font-weight: 500; letter-spacing: .06em; }
  .section-aside { font-size: 12px; color: var(--color-text-muted); }
  .text-link { display: inline-flex; align-items: center; gap: 14px; padding-bottom: 7px; border-bottom: 1px solid var(--red-3); font-size: 12.5px; letter-spacing: .1em; color: var(--red-1); }
  .text-link span { transition: transform .3s; }
  .text-link:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .text-link:hover span { transform: translate(3px,-3px); }

  .opening { position: relative; padding: 150px 0 140px; }
  .opening::before,
  .opening::after,
  .series::after,
  .latest::after,
  .interlude::after {
    content: "";
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  .opening::before {
    left: 0; top: 28px; width: min(280px, 42%); height: 52px;
    background:
      repeating-linear-gradient(90deg, var(--color-text-strong) 0 10px, transparent 10px 22px) 0 0 / 160px 3px no-repeat,
      linear-gradient(#c41e3a, #c41e3a) 0 16px / 16px 16px no-repeat,
      linear-gradient(var(--color-text-strong), var(--color-text-strong)) 28px 22px / 54px 3px no-repeat,
      radial-gradient(circle, var(--color-text-strong) 1.5px, transparent 1.7px) 96px 28px / 12px 12px no-repeat;
    opacity: .5;
  }
  .opening::after {
    left: 0; right: 0; bottom: 36px; height: 22px;
    background:
      repeating-linear-gradient(90deg, var(--color-text-strong) 0 12px, transparent 12px 28px) left center / min(420px, 70%) 3px no-repeat,
      linear-gradient(#c41e3a, #c41e3a) right 0 center / 22px 8px no-repeat;
    opacity: .45;
  }
  .opening-ticks { display: none; }
  .series, .latest, .interlude { position: relative; }
  .series::after, .latest::after {
    left: 0; bottom: 42px; width: min(260px, 48%); height: 34px;
    background:
      repeating-linear-gradient(90deg, var(--color-text-strong) 0 8px, transparent 8px 18px) 0 0 / 140px 3px no-repeat,
      linear-gradient(#c41e3a, #c41e3a) 152px 0 / 11px 11px no-repeat,
      linear-gradient(var(--color-text-strong), var(--color-text-strong)) 0 18px / 42px 2px no-repeat,
      radial-gradient(circle, #c41e3a 1.6px, transparent 1.8px) 56px 22px / 8px 8px no-repeat;
    opacity: .5;
  }
  .latest::after { left: auto; right: 0; }
  .interlude::after {
    left: 8%; bottom: -78px; width: 120px; height: 28px;
    background:
      linear-gradient(var(--color-text-strong), var(--color-text-strong)) 0 0 / 36px 3px no-repeat,
      repeating-linear-gradient(90deg, #c41e3a 0 6px, transparent 6px 14px) 0 14px / 70px 6px no-repeat;
    opacity: .55;
  }
  .opening-text { position: relative; z-index: 1; margin: 0; font-family: var(--font-serif); font-size: clamp(23px,2.7vw,36px); line-height: 1.95; letter-spacing: .05em; color: var(--color-text-strong); }
  .opening-text span { color: var(--red-1); box-shadow: inset 0 -.35em 0 var(--red-4); }
  .opening-mark { position: absolute; right: 3%; top: 64px; font-family: Georgia,serif; font-size: 230px; line-height: 1; color: var(--red-4); opacity: .65; }

  .series { padding-bottom: 150px; }
  .series-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
  .series-item, .series-item-2, .series-item-3, .series-item-4 { margin: 0; display: grid; grid-template-columns: minmax(160px, 32%) 1fr; background: var(--color-bg); color: var(--color-text-strong); border: 2px solid var(--color-text-strong); border-bottom: 8px solid #c41e3a; }
  .series-body h3 a, .series-body > p, .series-start { color: var(--color-text-strong); }
  .series-body { padding: 28px 32px 24px; }
  .series-visual { position: relative; display: block; overflow: hidden; background: var(--red-4); }
  .series-item-1 .series-visual { aspect-ratio: 1.28; }
  .series-item-2 .series-visual { aspect-ratio: 1.05; }
  .series-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .series-visual:hover img { transform: scale(1.055); }
  .series-count { position: absolute; right: 0; top: 0; padding: 7px 12px; background: #c41e3a; color: #fff; font-size: 11px; letter-spacing: .14em; font-weight: 700; }
  .series-ord { position: absolute; left: 20px; bottom: 18px; font-size: 9px; letter-spacing: .3em; color: rgba(255,255,255,.85); text-shadow: 0 1px 8px #000; }
  .series-body { padding-top: 26px; }
  .series-body h3 { margin: 0 0 14px; font-size: clamp(24px,2.3vw,32px); font-weight: 500; letter-spacing: .05em; }
  .series-body h3 a { color: var(--color-text-strong); }
  .series-body h3 a:hover { color: var(--red-1); }
  .series-body > p { margin: 0 0 24px; font-size: 14px; line-height: 1.95; color: var(--color-text-muted); }
  .series-start { display: flex; align-items: center; gap: 16px; padding: 16px 0; border-top: 1px solid var(--color-card-border); border-bottom: 1px solid var(--color-card-border); font-size: 13px; color: var(--color-text-strong); }
  .series-start-no { color: var(--red-2); font-size: 11px; }
  .series-start-arrow { margin-left: auto; color: var(--red-1); transition: transform .3s; }
  .series-start:hover .series-start-arrow { transform: translateX(6px); }

  .interlude { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(36px,5vw,80px); align-items: center; margin: 0 calc(clamp(24px,5vw,64px) * -1) 150px; padding: 80px clamp(24px,5vw,64px); background: var(--color-surface-muted); }
  .interlude-image { display: block; overflow: hidden; aspect-ratio: 1.5; }
  .interlude-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s; }
  .interlude-image:hover img { transform: scale(1.04); }
  .book-plate {
    position: relative;
    background:
      linear-gradient(#c41e3a, #c41e3a) 0 0 / 18px 100% no-repeat,
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--color-text-strong) 16%, transparent) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(color-mix(in srgb, var(--color-text-strong) 12%, transparent) 0 1px, transparent 1px 32px),
      var(--color-surface);
    color: var(--color-text-strong);
  }
  .plate-spine { position: absolute; inset: 0 auto 0 0; width: 18px; background: #c41e3a; }
  .plate-kicker {
    position: absolute; top: 22px; left: 40px;
    font-size: 12px; letter-spacing: .32em; font-weight: 800;
  }
  .plate-title {
    position: absolute; left: 40px; top: 22%;
    font-family: var(--font-serif);
    font-size: clamp(40px, 4.2vw, 68px);
    font-weight: 700; line-height: 1.02; letter-spacing: .06em;
  }
  .plate-en {
    position: absolute; left: 40px; bottom: 58px; max-width: 62%;
    font-size: 12px; letter-spacing: .18em; font-weight: 800;
  }
  .plate-eq {
    position: absolute; right: 7%; top: 16%;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic; font-size: clamp(26px, 2.6vw, 40px);
    color: #c41e3a; transform: rotate(-8deg);
  }
  .plate-grid {
    position: absolute; right: 22px; bottom: 20px;
    display: grid; grid-template-columns: repeat(6, 11px); gap: 6px;
  }
  .plate-grid i { display: block; height: 11px; background: var(--color-text-strong); }
  .plate-grid i:nth-child(3n) { background: #c41e3a; }
  .plate-chip { position: absolute; top: 0; right: 0; width: 64px; height: 16px; background: #c41e3a; }
  .interlude-kicker { margin: 0 0 12px; font-size: 12px; letter-spacing: .2em; color: var(--red-2); }
  .interlude-copy h2 { margin: 0 0 20px; font-size: clamp(24px,2.4vw,34px); line-height: 1.55; font-weight: 500; }
  .interlude-copy h2 a { color: var(--color-text-strong); }
  .interlude-copy > p:not(.interlude-kicker) { font-size: 14px; line-height: 1.95; color: var(--color-text-muted); margin-bottom: 28px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .latest { padding-bottom: 140px; }
  .latest-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .latest-row { position: relative; display: flex; align-items: center; gap: clamp(20px,3vw,46px); padding: 28px 6px; border-bottom: 1px solid var(--color-card-border); color: var(--color-text-strong); }
  .latest-no { width: 28px; flex-shrink: 0; font-size: 11px; color: var(--red-2); }
  .latest-title-wrap { flex: 1; min-width: 0; }
  .latest-title-wrap h3 { margin: 0 0 7px; font-size: clamp(17px,1.7vw,22px); font-weight: 500; letter-spacing: .03em; transition: color .3s, transform .35s; }
  .latest-cat { font-size: 11px; letter-spacing: .12em; color: var(--color-text-muted); }
  .latest-row time { font-size: 11px; letter-spacing: .08em; color: var(--color-text-muted); }
  .latest-arrow { font-size: 18px; color: var(--red-2); transition: transform .3s; }
  .latest-row:hover .latest-title-wrap h3 { color: var(--red-1); transform: translateX(8px); }
  .latest-row:hover .latest-arrow { transform: translate(4px,-4px); }
  .latest-preview { position: absolute; right: 15%; top: 50%; z-index: 5; width: 240px; aspect-ratio: 1.45; pointer-events: none; opacity: 0; transform: translateY(-42%) rotate(4deg) scale(.9); transition: opacity .35s, transform .45s cubic-bezier(.2,.8,.2,1); box-shadow: 0 24px 60px rgba(15,30,50,.28); }
  .preview-card { display: block; width: 100%; height: 100%; overflow: hidden; background: var(--red-4); }
  .latest-preview img { width: 100%; height: 100%; object-fit: cover; }
  .latest-row:hover .latest-preview { opacity: 1; transform: translateY(-50%) rotate(-3deg) scale(1); }
  .latest-more { margin-top: 36px; text-align: right; }

  .colophon { display: grid; grid-template-columns: 1fr 270px; gap: 70px; align-items: center; padding: 70px 0 100px; border-top: 1px solid var(--color-card-border); }
  .colophon-main h2 { margin: 0 0 22px; font-size: clamp(26px,3vw,40px); font-weight: 500; line-height: 1.65; letter-spacing: .04em; }
  .colophon-main > p { max-width: 480px; font-size: 14px; line-height: 1.95; color: var(--color-text-muted); }
  .colophon-links { display: flex; gap: 30px; margin-top: 28px; }
  .colophon-tags { display: flex; flex-wrap: wrap; gap: 12px 18px; margin-top: 44px; }
  .colophon-tags a { font-size: 11px; color: var(--color-text-muted); }
  .colophon-tags a:hover { color: var(--red-1); }
  .colophon-knob :global(.mood-knob-widget) { border: none; box-shadow: none; background: transparent; }

  /* ===== 滚动闪卡 ===== */
  .flashcard-stage {
    --fc-rx: 0deg; --fc-ry: 0deg; --fc-rz: 0deg; --fc-tz: 0px; --fc-drift: 0px;
    --fc-scale: 1; --fc-gx: 50%; --fc-gy: 50%; --fc-glint: 0; --fc-holo: 0;
    --fc-hue: 0deg; --fc-px: 0px; --fc-py: 0px; --fc-shx: 0px; --fc-shy: 18px; --fc-sho: 0;
    position: relative;
    isolation: isolate;
    perspective: 1050px;
    perspective-origin: 50% 46%;
  }
  .flashcard-shadow {
    position: absolute; left: 4%; right: 4%; bottom: -9%; height: 22%; z-index: -1;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(9,22,39,.58), rgba(9,22,39,.16) 42%, transparent 70%);
    filter: blur(10px);
    opacity: var(--fc-sho);
    transform: translate3d(var(--fc-shx), var(--fc-shy), 0) scaleX(.92);
    pointer-events: none;
  }
  .series-visual, .interlude-image, .preview-card {
    position: relative;
    transform-style: preserve-3d;
    transform: translate3d(var(--fc-drift), 0, var(--fc-tz)) rotateX(var(--fc-rx)) rotateY(var(--fc-ry)) rotateZ(var(--fc-rz)) scale(var(--fc-scale));
    box-shadow: 10px 10px 0 #111;
    backface-visibility: hidden;
    will-change: transform;
  }
  .series-visual img, .interlude-image img, .preview-card img {
    transform: scale(1.09) translate3d(var(--fc-px), var(--fc-py), 0);
    will-change: transform;
  }
  .series-visual:hover img { transform: scale(1.13) translate3d(var(--fc-px), var(--fc-py), 0); }
  .interlude-image:hover img { transform: scale(1.12) translate3d(var(--fc-px), var(--fc-py), 0); }
  .flashcard-foil {
    position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none;
    opacity: var(--fc-holo);
    background:
      radial-gradient(circle at var(--fc-gx) var(--fc-gy), rgba(255,255,255,.58), transparent 24%),
      linear-gradient(115deg, transparent 42%, rgba(225,6,0,.28) 49%, rgba(255,255,255,.35) 50%, transparent 58%);
    background-size: 100% 100%, 180% 180%;
    background-position: center, var(--fc-gx) var(--fc-gy);
    mix-blend-mode: color-dodge;
    filter: saturate(1.35);
  }
  /* 窄镜面高光 + 宽柔光：随倾角扫过，而非整张图泛白。 */
  .series-visual::after, .interlude-image::after, .preview-card::after {
    content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      linear-gradient(112deg, transparent 32%, rgba(255,255,255,.06) 40%, rgba(255,251,235,.8) 48%, rgba(255,255,255,.18) 51%, transparent 60%),
      radial-gradient(ellipse at var(--fc-gx) var(--fc-gy), rgba(255,255,255,.36), transparent 42%);
    background-size: 260% 100%, 100% 100%;
    background-position: var(--fc-gx) 0, center;
    mix-blend-mode: screen;
    opacity: var(--fc-glint);
  }
  /* 极细的亮边让斜角时有真实卡片的厚度，而不是图片简单变形。 */
  .series-visual::before, .interlude-image::before, .preview-card::before {
    content: ""; position: absolute; inset: 0; z-index: 4; pointer-events: none;
    border: 1px solid rgba(255,255,255,.48);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08), inset 0 -22px 34px rgba(8,24,44,.12);
    opacity: calc(.3 + var(--fc-glint));
  }
  .series-count, .series-ord { z-index: 5; transform: translateZ(24px); }
  .preview-card {
    --fc-rx: 0deg; --fc-ry: 0deg; --fc-rz: 0deg; --fc-tz: 0px; --fc-drift: 0px;
    --fc-scale: 1; --fc-gx: 50%; --fc-gy: 50%; --fc-glint: 0; --fc-holo: 0;
    --fc-hue: 0deg; --fc-px: 0px; --fc-py: 0px;
    pointer-events: none;
  }
  @supports (transform: translateZ(1px)) {
    .series-visual, .interlude-image, .preview-card { transform-origin: 50% 48%; }
  }

  /* ===== 宽屏杂志编排：从 1440px 起增加并列关系，而不是单纯放大中央窄栏 ===== */
  @media (min-width: 1440px) {
    .journal { max-width: var(--wide-content); padding-right: var(--wide-gutter); padding-left: var(--wide-gutter); }
    /* 全宽画幅中倾斜闪卡的装饰性投影可以出画，但不能扩大页面滚动区域。 */
    .journal { overflow-x: clip; }
    .opening { display: grid; grid-template-columns: minmax(130px, .34fr) minmax(0, 1.8fr); gap: var(--wide-gap); padding: 160px 0 170px; }
