    .s2-wash::after { left: 0; top: 48%; bottom: auto; width: 100%; height: 8px; }
    .s2-board { left: 16px; right: 16px; grid-template-columns: 1fr; gap: 12px; top: 8%; }
    .s2-title { font-size: clamp(46px, 12.5vw, 58px); }
