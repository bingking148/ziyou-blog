    .s2-d { margin-left: .9em; }
    .s2-panel { margin-top: 0; }
    .scene-focus { left: auto; right: 16px; top: auto; bottom: 72px; width: min(46vw, 180px); }
    .focus-card { aspect-ratio: 1.15; border-width: 3px; box-shadow: 8px 8px 0 #c41e3a; }
    .scene-progress { left: 16px; right: 16px; color: var(--s2-onfield); background: transparent; }
    .scene-focus:hover .focus-card { box-shadow: 10px 10px 0 var(--s2-ochre); }
    .focus-card-copy h2 { font-size: clamp(18px, 4.6vw, 24px); margin: 8px 0 12px; }
    .focus-label { font-size: 7px; }
    .focus-read { padding-top: 10px; font-size: 9px; }
    .scene-progress { left: 24px; right: 24px; bottom: 0; height: 56px; }
    .progress-label { font-size: 7px; letter-spacing: .18em; }
    .progress-track { width: 60px; }
    .opening { padding: 90px 0 80px; }
    .opening-text { font-size: 22px; line-height: 1.95; }
    .desktop-br { display: none; }
    .opening-mark { font-size: 140px; top: 44px; }
    .section-head { margin-bottom: 30px; }
    .section-aside { display: none; }
    .series { padding-bottom: 90px; }
    .series-grid { grid-template-columns: 1fr; gap: 52px; }
