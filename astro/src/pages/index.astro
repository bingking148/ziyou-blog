---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MoodKnob from '../components/MoodKnob.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { responsive } from '../utils/images.ts';
import { columnOf, columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';
import { TYPING_STRINGS, SOCIAL, AUTHOR } from '../consts.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
const heroIndex = posts.slice(0, 3);
const recent = posts.slice(1, 7);
// 随想位：从「人工智能学习」专栏随机抽一篇（构建时随机；dev 下每次刷新都换）
const aiColumn = columns.find((c) => c.data.category === '人工智能学习');
const aiPool = aiColumn ? columnPosts(aiColumn, posts) : [];
const essays = aiPool.length ? [aiPool[Math.floor(Math.random() * aiPool.length)]] : [];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shortTitle = (t: string) => t.split('——')[0];
---

<Base pageClass="is-home">
  <!-- 开场：同一张封面、同一套中文句子。滚动只画一条朱砂线，再把最近一篇沿这条斜线送进来。 -->
  <section id="header" class="scene" aria-label="站点封面">
    <div class="scene-pin">
      <div class="scene-card">
        <div class="scene-media">
          <ResponsiveImage
            class="scene-image"
            src="/images/hero-bg-1920.jpg"
            sizes="100vw"
            alt="立于晴空下的蓝发人物"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="scene-shade" aria-hidden="true"></div>
      </div>

      <svg class="scene-incision" viewBox="0 0 1440 850" preserveAspectRatio="none" aria-hidden="true">
        <path class="incision-core" pathLength="1" d="M160 700 L1040 520" />
      </svg>

      <a class="scene-focus" href={postUrl(latest)} aria-label={`阅读最新文章：${latest.data.title}`}>
        <div class="focus-card">
          <div class="focus-copy">
            <span class="focus-label">最近一篇</span>
            <h2>{shortTitle(latest.data.title)}</h2>
            <span class="focus-read">进入这一篇 <i>↗</i></span>
          </div>
        </div>
      </a>

      <div class="scene-stack">
      <div class="scene-content">
        <p class="site-kicker">注</p>
        <h1 class="scene-title">
          <span class="title-line">在键盘上，</span>
          <span class="title-line">写下又一行注释。</span>
        </h1>
        <div class="scene-intro">
          <p class="scene-typing">
            <span id="typing-text">{TYPING_STRINGS[0]}</span><span class="typing-cursor" aria-hidden="true"></span>
          </p>
          <a class="scene-link" href={postUrl(latest)}>
            <span>阅读最新一篇</span>
            <svg viewBox="0 0 32 16" width="32" height="16" fill="none" aria-hidden="true"><path d="M0 8h29M22 1l7 7-7 7" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
          <a
            class="scene-scroll"
            href="#journal"
            data-cinematic-scroll
            aria-label="看下一句"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M12 4v15M5.5 13l6.5 6.5L18.5 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>下一句</span>
          </a>
        </div>
      </div>
      <div class="scene-next" aria-hidden="true">
        <p class="scene-title">
          <span class="title-line">代码之外，</span>
          <span class="title-line">仍有世界。</span>
        </p>
      </div>
      </div>

      <div class="scene-bottom">
        <div class="scene-edition">
          <span>注</span>
          <span>{new Date().getFullYear()}</span>
        </div>
        <nav class="scene-index" aria-label="最新文章速览">
          {heroIndex.map((p, i) => (
            <a href={postUrl(p)} class="scene-index-item">
              <span class="index-no">0{i + 1}</span>
              <span class="index-title">{shortTitle(p.data.title)}</span>
              <span class="index-arrow">↗</span>
            </a>
          ))}
        </nav>
      </div>
      <div class="scene-progress" aria-hidden="true">
        <span class="progress-label">一句，再到下一句</span>
        <span class="progress-track"><i></i></span>
      </div>
    </div>
  </section>

  <div id="journal" class="journal">
    <!-- 序：让内容自己说话 -->
    <section class="opening" data-reveal>
      <span class="site-kicker">序</span>
      <p class="opening-text">
        这里不追逐热点，只记录那些<span>真正想明白的事</span>。<br />
        从大模型的原理，到 Python 的第一行代码，<br class="desktop-br" />
        再到数学与世界运作的方式——慢慢写，认真想。
      </p>
      <div class="opening-mark" aria-hidden="true">“</div>
    </section>

    <!-- 专题：非对称杂志编排 -->
    <section class="series" aria-labelledby="series-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="site-kicker">专栏</span>
          <h2 id="series-title">按顺序读完</h2>
        </div>
        <a class="text-link" href="/columns/">全部专栏 <span>↗</span></a>
      </header>
      <ol class="serial-list">
        {columns.map((c, i) => {
          const list = columnPosts(c, posts);
          const first = list[0];
          return (
            <li data-reveal>
              <a class="serial-row" href={`/categories/${slugifyTaxonomy(c.data.category)}/`}>
                <span class="serial-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="serial-name">{c.data.title.replace('专栏', '')}</span>
                <span class="serial-count">{String(list.length).padStart(2, '0')} 篇</span>
                <span class="serial-next">{first ? shortTitle(first.data.title) : '开始阅读'}</span>
                <span class="serial-arrow">↗</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- 随想：大尺幅横图 + 文字 -->
    {essays[0] && (
      <section class="interlude" data-reveal aria-label="数理随想">
        <a class="interlude-image ink-plate" href={postUrl(essays[0])}>
          <ResponsiveImage src={essays[0].data.cover} sizes="(max-width: 760px) 100vw, 40vw" alt="" loading="lazy" />
        </a>
        <div class="interlude-copy">
          <span class="site-kicker">随笔</span>
          <p class="interlude-kicker">在公式之外</p>
          <h2><a href={postUrl(essays[0])}>{essays[0].data.title}</a></h2>
          <p>{essays[0].data.description}</p>
          <a class="text-link" href={postUrl(essays[0])}>读这篇随想 <span>↗</span></a>
        </div>
      </section>
    )}

    <!-- 最新：编号目录，悬停浮图 -->
    <section class="latest" aria-labelledby="latest-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="site-kicker">最近</span>
          <h2 id="latest-title">最近写下</h2>
        </div>
        <span class="section-aside">{posts.length} 篇文字，仍在生长</span>
      </header>
      <ol class="latest-list">
        {recent.map((p, i) => (
          <li data-reveal style={`--i:${Math.min(i, 3)}`}>
            <a class="latest-row" href={postUrl(p)}>
              <span class="latest-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="latest-title-wrap">
                <h3>{shortTitle(p.data.title)}</h3>
                <span class="latest-cat">{p.data.categories[0]}</span>
              </span>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="latest-arrow">↗</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="latest-more" data-reveal>
        <a class="text-link" href="/archives/">翻阅全部归档 <span>↗</span></a>
      </div>
    </section>

    <!-- 尾章：作者与氛围 -->
    <section class="colophon" data-reveal>
      <div class="colophon-main">
        <span class="site-kicker">关于</span>
        <h2>一个仍在学习的人，<br />和一块留给好奇心的地方。</h2>
        <p>写代码，也写那些代码解释不了的问题。如果这个角落对你有用，欢迎常来。</p>
        <div class="colophon-links">
          <a class="text-link" href="/about/">关于我 <span>↗</span></a>
          {SOCIAL.github && <a class="text-link" href={SOCIAL.github} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
        </div>
        <div class="colophon-tags">
          {tags.slice(0, 8).map((t) => <a href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>)}
        </div>
      </div>
      <div class="colophon-knob"><MoodKnob /></div>
    </section>
  </div>

  <script define:vars={{ strings: TYPING_STRINGS }}>
    (function () {
      'use strict';
      var el = document.getElementById('typing-text');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var order = strings.slice(), idx = 0, pos = order[0].length, deleting = true;
      for (var i = order.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1)), t = order[i]; order[i] = order[j]; order[j] = t;
      }
      function tick() {
        if (document.hidden) return setTimeout(tick, 1000);
        var s = order[idx];
        if (!deleting) {
          pos++; el.textContent = s.slice(0, pos);
          if (pos >= s.length) { deleting = true; return setTimeout(tick, 2400); }
          setTimeout(tick, 110);
        } else {
          pos--; el.textContent = s.slice(0, pos);
          if (pos <= 0) { deleting = false; idx = (idx + 1) % order.length; return setTimeout(tick, 600); }
          setTimeout(tick, 45);
        }
      }
      setTimeout(tick, 3200);
    })();
  </script>
  <script>
    /* 一句换到下一句：滚动只驱动一条朱砂线和一张始终在画面内的文章卡。 */
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var scene = document.querySelector('.scene');
      if (!scene) return;
      var pin = scene.querySelector('.scene-pin');
      var next = scene.querySelector('.scene-next');
      var focus = scene.querySelector('.scene-focus');
      var cta = scene.querySelector('[data-cinematic-scroll]');
      function placeHeader() {
        var past = scene.getBoundingClientRect().bottom < 72;
        document.body.dataset.scene = past ? 'journal' : 'photo';
      }
      if (reduced.matches || !pin) {
        placeHeader();
        window.addEventListener('scroll', placeHeader, { passive: true });
        window.addEventListener('resize', placeHeader);
        return;
      }
      scene.classList.add('has-motion');
      var playing = false;
      var ticking = false;
      var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
      var smooth = function (v) { v = clamp(v); return v * v * (3 - 2 * v); };
      var ramp = function (p, a, b) { return smooth((p - a) / (b - a)); };
      function update() {
        ticking = false;
        var rect = scene.getBoundingClientRect();
        var distance = scene.offsetHeight - pin.offsetHeight;
        if (distance <= 0) { placeHeader(); return; }
        var p = clamp(-rect.top / distance);
        var line = ramp(p, 0.04, 0.42);
        var swap = ramp(p, 0.34, 0.48);
        var copy = swap <= 0.5 ? 1 - swap * 2 : 0;
        var nextOp = swap <= 0.5 ? 0 : (swap - 0.5) * 2;
        var card = ramp(p, 0.5, 0.86);
        var mobile = window.innerWidth <= 760;
        var st = pin.style;
        st.setProperty('--scene-p', p.toFixed(4));
        st.setProperty('--line', line.toFixed(3));
        st.setProperty('--copy-opacity', copy.toFixed(3));
        st.setProperty('--next-opacity', nextOp.toFixed(3));
        st.setProperty('--card-opacity', card.toFixed(3));
        st.setProperty('--card-x', ((1 - card) * (mobile ? 0 : 16)).toFixed(1) + 'px');
        st.setProperty('--card-y', ((1 - card) * (mobile ? 12 : 24)).toFixed(1) + 'px');
        st.setProperty('--scene-progress', (p * 100).toFixed(2) + '%');
        if (next) next.setAttribute('aria-hidden', nextOp > 0.6 ? 'false' : 'true');
        if (focus) {
          var active = card > 0.62;
          focus.toggleAttribute('inert', !active);
          focus.setAttribute('aria-hidden', active ? 'false' : 'true');
        }
        var sceneLink = scene.querySelector('.scene-link');
        if (sceneLink) sceneLink.toggleAttribute('inert', copy < 0.2);
        if (cta) {
          var ctaOff = copy < 0.2 || playing;
          cta.toggleAttribute('inert', ctaOff);
          if (playing) cta.setAttribute('aria-disabled', 'true');
          else cta.removeAttribute('aria-disabled');
        }
        placeHeader();
      }
      var root = document.documentElement;
      var playFrame = 0;
      var previousScrollBehavior = root.style.scrollBehavior;
      function stopCinema() {
        if (!playing) return;
        playing = false;
        if (playFrame) cancelAnimationFrame(playFrame);
        playFrame = 0;
        root.style.scrollBehavior = previousScrollBehavior;
        if (cta) cta.removeAttribute('aria-disabled');
        schedule();
      }
      function playCinema(now) {
        var t = clamp((now - playCinema.start) / playCinema.duration);
        var eased = t * t * (3 - 2 * t);
        window.scrollTo(0, playCinema.from + (playCinema.to - playCinema.from) * eased);
        if (t >= 1) { stopCinema(); return; }
        playFrame = requestAnimationFrame(playCinema);
      }
      if (cta) {
        cta.addEventListener('click', function (event) {
          event.preventDefault();
          if (playing) return;
          var distance = scene.offsetHeight - pin.offsetHeight;
          if (distance <= 0) return;
          var from = window.scrollY;
          var to = scene.offsetTop + distance * 0.9;
          if (from >= to - 4) { schedule(); return; }
          playing = true;
          previousScrollBehavior = root.style.scrollBehavior;
          root.style.scrollBehavior = 'auto';
          cta.setAttribute('aria-disabled', 'true');
          cta.setAttribute('inert', '');
          playCinema.start = performance.now();
          playCinema.from = from;
          playCinema.to = to;
          playCinema.duration = window.innerWidth <= 760 ? 1100 : 1400;
          playFrame = requestAnimationFrame(playCinema);
        });
      }
      window.addEventListener('wheel', stopCinema, { passive: true });
      window.addEventListener('touchstart', stopCinema, { passive: true });
      window.addEventListener('site:stop-cinema', stopCinema);
      window.addEventListener('keydown', function (event) {
        if (!playing) return;
        var keys = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' ', 'PageUp', 'PageDown', 'Home', 'End'];
        if (keys.indexOf(event.key) >= 0) stopCinema();
      });
      function schedule() {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener('load', schedule);
      update();
    })();
  </script>
</Base>

<style>
  .scene {
    position: relative;
    height: 150svh;
    min-height: 860px;
    overflow-x: clip;
    overflow-y: visible;
    color: #fff;
    background: #0a1420;
  }
  .scene-pin {
    --line: 0;
    --copy-opacity: 1;
    --next-opacity: 0;
    --card-opacity: 0;
    --card-x: 16px;
    --card-y: 24px;
    --scene-progress: 0%;
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    background: #0a1420;
  }
  .scene-card { position: absolute; inset: 0; overflow: hidden; background: #26384c; }
  .scene-media { position: absolute; inset: 0; }
  .scene-image {
    width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: center 42%;
    animation: scene-in .8s ease both;
  }
  @keyframes scene-in { from { opacity: .35; } to { opacity: 1; } }
  .scene-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10,20,32,.72) 0%, rgba(10,20,32,.28) 46%, rgba(10,20,32,.05) 72%),
      linear-gradient(0deg, rgba(10,20,32,.72) 0%, transparent 36%),
      linear-gradient(180deg, rgba(10,20,32,.28), transparent 24%);
  }
  .scene-incision {
    position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%;
    pointer-events: none; visibility: hidden;
  }
  .scene.has-motion .scene-incision,
  .scene.has-motion .scene-next,
  .scene.has-motion .scene-focus { visibility: visible; }
  .scene-incision path { fill: none; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--line)); }
  .incision-core { stroke: #bf4136; stroke-width: 2; }
  .scene-stack {
    position: absolute; z-index: 4;
    left: clamp(28px, 7vw, 120px); top: 18%;
    width: min(680px, 62vw);
  }
  .scene .site-kicker { color: rgba(255,255,255,.82); }
  .scene-content { opacity: var(--copy-opacity); }
  .scene-next {
    position: absolute; left: 0; right: 0; top: 34px;
    opacity: var(--next-opacity); visibility: hidden; pointer-events: none;
  }
  .scene-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 72px);
    line-height: 1.35;
    letter-spacing: .03em;
    color: #fff;
  }
  .title-line { display: block; white-space: nowrap; }
  .scene-intro { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 28px; }
  .scene-typing { margin: 0; min-height: 1.5em; font-size: 14px; letter-spacing: .06em; color: rgba(255,255,255,.78); }
  .typing-cursor { display: inline-block; width: 1px; height: 1em; margin-left: 5px; background: currentColor; vertical-align: -2px; animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .scene-link, .scene-scroll {
    display: inline-flex; align-items: center; gap: 10px;
    padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,.55);
    color: #fff; font-family: var(--font-serif); font-size: 15px; letter-spacing: .06em;
  }
  .scene-link svg, .scene-scroll svg { transition: transform .3s ease; }
  .scene-link:hover svg { transform: translateX(6px); }
  .scene-scroll:hover svg { transform: translateY(3px); }
  .scene-focus {
    position: absolute; z-index: 4;
    right: max(28px, 4vw); bottom: 118px;
    width: min(300px, 24vw);
    color: #fff;
    opacity: var(--card-opacity);
    visibility: hidden;
    transform: translate3d(var(--card-x), var(--card-y), 0);
  }
  .focus-card { background: #102434; border-left: 2px solid #bf4136; }
  .focus-copy { padding: 16px 18px 18px; }
  .focus-label { font-family: var(--font-serif); font-size: 13px; letter-spacing: .12em; color: rgba(255,255,255,.72); }
  .focus-copy h2 { margin: 8px 0 12px; font-family: var(--font-serif); font-weight: 500; font-size: 20px; line-height: 1.45; color: #fff; }
  .focus-read { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.28); padding-top: 10px; font-size: 13px; }
  .focus-read i { font-style: normal; }
  .scene-bottom {
    position: absolute; z-index: 5; left: clamp(28px, 6vw, 80px); right: clamp(28px, 6vw, 80px); bottom: 0;
    display: flex; align-items: stretch; border-top: 1px solid rgba(255,255,255,.2);
  }
  .scene-edition { display: flex; flex-direction: column; justify-content: center; gap: 6px; width: 18%; padding: 18px 18px 18px 0; font-family: var(--font-serif); font-size: 13px; letter-spacing: .12em; color: rgba(255,255,255,.7); }
  .scene-index { display: grid; grid-template-columns: repeat(3, 1fr); flex: 1; }
  .scene-index-item { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 18px 16px; border-left: 1px solid rgba(255,255,255,.18); color: #fff; }
  .scene-index-item:hover { background: rgba(255,255,255,.08); color: #fff; }
  .index-no { font-size: 12px; color: rgba(255,255,255,.55); }
  .index-title { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .scene-progress {
    position: absolute; z-index: 5; left: clamp(28px, 7vw, 120px); bottom: 108px;
    display: flex; align-items: center; gap: 12px; pointer-events: none;
    color: rgba(255,255,255,.7); font-family: var(--font-serif); font-size: 12px; letter-spacing: .12em;
    opacity: var(--next-opacity);
  }
  .progress-track { width: 88px; height: 1px; background: rgba(255,255,255,.28); }
  .progress-track i { display: block; width: var(--scene-progress); height: 100%; background: #bf4136; }

  .journal { max-width: 1080px; margin: 0 auto; padding: 0 clamp(24px, 5vw, 64px); }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .section-head h2 { margin: 0; font-size: clamp(28px, 3vw, 40px); font-weight: 500; letter-spacing: .04em; }
  .section-aside { font-size: 13px; color: var(--color-text-muted); }
  .text-link { display: inline-flex; align-items: center; gap: 10px; padding-bottom: 4px; border-bottom: 1px solid var(--red-3); font-size: 14px; color: var(--red-1); }
  .text-link:hover { color: var(--color-accent); border-color: var(--color-accent); }

  .opening { position: relative; padding: 120px 0 100px; }
  .opening-text { position: relative; z-index: 1; margin: 0; max-width: 18em; font-family: var(--font-serif); font-size: clamp(24px, 2.4vw, 34px); line-height: 1.9; letter-spacing: .03em; color: var(--color-text-strong); }
  .opening-text span { color: var(--color-accent); box-shadow: inset 0 -.28em 0 color-mix(in srgb, var(--color-accent) 22%, transparent); }
  .opening-mark { position: absolute; right: 4%; top: 72px; font-family: var(--font-serif); font-size: 96px; line-height: 1; color: var(--red-4); }

