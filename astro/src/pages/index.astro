      background:
        repeating-linear-gradient(to bottom, var(--color-text-strong) 0 8px, transparent 8px 22px) 0 0 / 2px 100% no-repeat,
        linear-gradient(#c41e3a, #c41e3a) 16px 8px / 14px 14px no-repeat,
        linear-gradient(var(--color-text-strong), var(--color-text-strong)) 16px 32px / 40px 3px no-repeat;
      opacity: .45;
    }
    .opening .section-no { padding-top: 17px; }
