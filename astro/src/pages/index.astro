---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MoodKnob from '../components/MoodKnob.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { responsive } from '../utils/images.ts';
import { columnOf, columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';
import { TYPING_STRINGS, SOCIAL, AUTHOR } from '../consts.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
const heroIndex = posts.slice(0, 3);
const recent = posts.slice(1, 7);
// 随想位：从「人工智能学习」专栏随机抽一篇（构建时随机；dev 下每次刷新都换）
const aiColumn = columns.find((c) => c.data.category === '人工智能学习');
const aiPool = aiColumn ? columnPosts(aiColumn, posts) : [];
const essays = aiPool.length ? [aiPool[Math.floor(Math.random() * aiPool.length)]] : [];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shortTitle = (t: string) => t.split('——')[0];
---

<Base pageClass="is-home">
  <!-- 开场：封面 → 胶片切片 → 最新作品卡，三幕共用一个滚动轨道 -->
  <section id="header" class="scene" aria-label="站点封面">
    <div class="scene-pin">
      <div class="scene-card">
        <div class="scene-media">
          <ResponsiveImage
            class="scene-image"
            src="/images/hero-bg-1920.jpg"
            sizes="100vw"
            alt="夕阳下延伸至云海的山路"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="scene-shade" aria-hidden="true"></div>
        <div class="scene-glint" aria-hidden="true"></div>
      </div>

      <div class="scene-tears" aria-hidden="true">
        <div class="scene-tear scene-tear-a">
          <ResponsiveImage src="/images/hero-bg-1920.jpg" sizes="100vw" alt="" loading="eager" />
        </div>
        <div class="scene-tear scene-tear-b">
          <ResponsiveImage src="/images/hero-bg-1920.jpg" sizes="100vw" alt="" loading="eager" />
        </div>
      </div>
      <svg class="scene-incision" viewBox="0 0 1440 850" preserveAspectRatio="none" aria-hidden="true">
        <path class="incision-glow" pathLength="1" d="M-40 760L620 0M0 820L680 0" />
        <path class="incision-core" pathLength="1" d="M-40 760L620 0M0 820L680 0" />
      </svg>

      <div class="scene-after" aria-hidden="true">
        <svg class="after-lines" viewBox="0 0 1440 850" preserveAspectRatio="none">
          <path class="after-rule" d="M0 690H1440M0 710H1440M1060 0V850M1080 0V850" />
          <path class="after-cut" pathLength="1" d="M-40 760L620 0M0 820L680 0" />
        </svg>
        <p class="after-kicker">CHAPTER 02 / NOTES ON CURIOSITY</p>
        <p class="after-ghost"><span>BEYOND</span><span><em>THE</em> <b>CODE</b></span></p>
        <p class="after-caption">
          <span>代码之外，仍有世界。</span>
          <span class="after-caption-en">A QUIET ARCHIVE OF<br />LOUD IDEAS.</span>
        </p>
        <span class="after-stamp">02</span>
      </div>

      <a class="scene-focus" href={postUrl(latest)} aria-label={`阅读最新文章：${latest.data.title}`}>
        <div class="focus-card">
          {latest.data.cover && <ResponsiveImage src={latest.data.cover} sizes="(max-width: 760px) 72vw, 42vw" alt="" loading="lazy" />}
          <div class="focus-card-shade"></div>
          <div class="focus-card-copy">
            <span class="focus-label">LATEST ENTRY / 001</span>
            <h2>{shortTitle(latest.data.title)}</h2>
            <span class="focus-read">进入这一篇 <i>↗</i></span>
          </div>
          <span class="focus-edge" aria-hidden="true"></span>
        </div>
      </a>

      <div class="scene-frame" aria-hidden="true"></div>
      <div class="scene-content">
        <p class="scene-eyebrow"><span></span> FIELD NOTES OF A CURIOUS MIND</p>
        <h1 class="scene-title">
          <span class="title-shift title-shift-a"><span class="title-line">在键盘上，</span></span>
          <span class="title-shift title-shift-b"><span class="title-line title-indent">写下又一行注释。</span></span>
        </h1>
        <div class="scene-intro">
          <p class="scene-typing">
            <span id="typing-text">{TYPING_STRINGS[0]}</span><span class="typing-cursor" aria-hidden="true"></span>
          </p>
          <a class="scene-link" href={postUrl(latest)}>
            <span>阅读最新一篇</span>
            <svg viewBox="0 0 32 16" width="32" height="16" fill="none" aria-hidden="true"><path d="M0 8h29M22 1l7 7-7 7" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
        </div>
      </div>

      <div class="scene-side" aria-hidden="true">
        <span>CODE</span><i></i><span>CURIOSITY</span><i></i><span>LIFE</span>
      </div>
      <div class="scene-bottom">
        <div class="scene-edition">
          <span>VOL. 01</span>
          <span>{new Date().getFullYear()} / ZIYOU</span>
        </div>
        <nav class="scene-index" aria-label="最新文章速览">
          {heroIndex.map((p, i) => (
            <a href={postUrl(p)} class="scene-index-item">
              <span class="index-no">0{i + 1}</span>
              <span class="index-title">{shortTitle(p.data.title)}</span>
              <span class="index-arrow">↗</span>
            </a>
          ))}
        </nav>
      </div>
      <div class="scene-progress" aria-hidden="true">
        <span class="progress-label">AN OPENING IN THREE ACTS</span>
        <span class="progress-track"><i></i></span>
        <span class="progress-no">01</span>
      </div>
      <a
        class="scene-scroll"
        href="#journal"
        data-cinematic-scroll
        aria-label="播放开场动画并进入第二幕"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
          <path d="M12 4v15M5.5 13l6.5 6.5L18.5 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="scroll-label" aria-hidden="true">PLAY OPENING</span>
      </a>
    </div>
  </section>

  <div id="journal" class="journal">
    <!-- 序：让内容自己说话 -->
    <section class="opening" data-reveal>
      <span class="section-no">00 / PROLOGUE</span>
      <p class="opening-text">
        这里不追逐热点，只记录那些<span>真正想明白的事</span>。<br />
        从大模型的原理，到 Python 的第一行代码，<br class="desktop-br" />
        再到数学与世界运作的方式——慢慢写，认真想。
      </p>
      <div class="opening-mark" aria-hidden="true">“</div>
    </section>

    <!-- 专题：非对称杂志编排 -->
    <section class="series" aria-labelledby="series-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="section-no">01 / SERIES</span>
          <h2 id="series-title">专栏</h2>
        </div>
        <a class="text-link" href="/columns/">全部专栏 <span>↗</span></a>
      </header>
      <div class="series-grid">
        {columns.map((c, i) => {
          const list = columnPosts(c, posts);
          const first = list[0];
          return (
            <article class={`series-item series-item-${i + 1}`} data-reveal>
              <div class="flashcard-stage">
                <span class="flashcard-shadow" aria-hidden="true"></span>
                <a class="series-visual" href={`/categories/${slugifyTaxonomy(c.data.category)}/`} data-flashcard="series">
                  <ResponsiveImage src={c.data.cover} sizes="(max-width: 760px) 100vw, 55vw" alt={c.data.title} loading="lazy" />
                  <span class="flashcard-foil" aria-hidden="true"></span>
                  <span class="series-count">{String(list.length).padStart(2, '0')} 篇</span>
                  <span class="series-ord">SERIES 0{i + 1}</span>
                </a>
              </div>
              <div class="series-body">
                <h3><a href={`/categories/${slugifyTaxonomy(c.data.category)}/`}>{c.data.title.replace('专栏', '')}</a></h3>
                <p>{c.data.description}</p>
                <a class="series-start" href={first ? postUrl(first) : '/columns/'}>
                  <span class="series-start-no">01</span>
                  <span>{first ? shortTitle(first.data.title) : '开始阅读'}</span>
                  <span class="series-start-arrow">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 随想：大尺幅横图 + 文字 -->
    {essays[0] && (
      <section class="interlude" data-reveal aria-label="数理随想">
        <div class="flashcard-stage">
          <span class="flashcard-shadow" aria-hidden="true"></span>
          <a class="interlude-image" href={postUrl(essays[0])} data-flashcard="interlude">
            <ResponsiveImage src={essays[0].data.cover} sizes="(max-width: 760px) 100vw, 60vw" alt={essays[0].data.title} loading="lazy" />
            <span class="flashcard-foil" aria-hidden="true"></span>
          </a>
        </div>
        <div class="interlude-copy">
          <span class="section-no">02 / ESSAY</span>
          <p class="interlude-kicker">在公式之外</p>
          <h2><a href={postUrl(essays[0])}>{essays[0].data.title}</a></h2>
          <p>{essays[0].data.description}</p>
          <a class="text-link" href={postUrl(essays[0])}>读这篇随想 <span>↗</span></a>
        </div>
      </section>
    )}

    <!-- 最新：编号目录，悬停浮图 -->
    <section class="latest" aria-labelledby="latest-title">
      <header class="section-head" data-reveal>
        <div>
          <span class="section-no">03 / LATEST</span>
          <h2 id="latest-title">最近写下</h2>
        </div>
        <span class="section-aside">{posts.length} 篇文字，仍在生长</span>
      </header>
      <ol class="latest-list">
        {recent.map((p, i) => (
          <li data-reveal style={`--i:${Math.min(i, 3)}`}>
            <a class="latest-row" href={postUrl(p)}>
              <span class="latest-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="latest-title-wrap">
                <h3>{shortTitle(p.data.title)}</h3>
                <span class="latest-cat">{p.data.categories[0]}</span>
              </span>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="latest-arrow">↗</span>
              <span class="latest-preview" aria-hidden="true">
                <span class="preview-card" data-flashcard="preview">
                  {p.data.cover && <ResponsiveImage src={p.data.cover} sizes="240px" alt="" loading="lazy" />}
                  <span class="flashcard-foil" aria-hidden="true"></span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="latest-more" data-reveal>
        <a class="text-link" href="/archives/">翻阅全部归档 <span>↗</span></a>
      </div>
    </section>

    <!-- 尾章：作者与氛围 -->
    <section class="colophon" data-reveal>
      <div class="colophon-main">
        <span class="section-no">04 / ABOUT</span>
        <h2>一个仍在学习的人，<br />和一块留给好奇心的地方。</h2>
        <p>写代码，也写那些代码解释不了的问题。如果这个角落对你有用，欢迎常来。</p>
        <div class="colophon-links">
          <a class="text-link" href="/about/">关于我 <span>↗</span></a>
          {SOCIAL.github && <a class="text-link" href={SOCIAL.github} target="_blank" rel="noopener">GitHub <span>↗</span></a>}
        </div>
        <div class="colophon-tags">
          {tags.slice(0, 8).map((t) => <a href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>)}
        </div>
      </div>
      <div class="colophon-knob"><MoodKnob /></div>
    </section>
  </div>

  <script define:vars={{ strings: TYPING_STRINGS }}>
    (function () {
      'use strict';
      var el = document.getElementById('typing-text');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var order = strings.slice(), idx = 0, pos = order[0].length, deleting = true;
      for (var i = order.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1)), t = order[i]; order[i] = order[j]; order[j] = t;
      }
      function tick() {
        if (document.hidden) return setTimeout(tick, 1000);
        var s = order[idx];
        if (!deleting) {
          pos++; el.textContent = s.slice(0, pos);
          if (pos >= s.length) { deleting = true; return setTimeout(tick, 2400); }
          setTimeout(tick, 110);
        } else {
          pos--; el.textContent = s.slice(0, pos);
          if (pos <= 0) { deleting = false; idx = (idx + 1) % order.length; return setTimeout(tick, 600); }
          setTimeout(tick, 45);
        }
      }
      setTimeout(tick, 3200);
    })();
  </script>
  <script>
    /* ===== 三幕开场 v4：虚拟时间线，与真实滚动彻底解耦 =====
       平板闪屏的根因：此前三幕把动画进度绑在真实文档滚动上——工具栏收放、
       惯性滚动、resize 都会直接改写滚动几何，画面被浏览器反复拉扯，锁输入
       治标不治本。这一版演示全程零真实滚动：

       - 进度 p 只活在 JS 里，rAF 补间逐帧写 CSS 变量：一整段连续动画，
         浏览器插不进手，也就无从闪起
       - 演示期间锁住页面滚动（html.intro-lock，桌面滚动条宽度实时补偿），
         落幕时与真实滚动无缝交接——p=1 的画面与滚动位置 end 的 sticky
         画面逐像素一致，交接零跳变
       - 三个停靠点不变：封面(0) → 海报+卡片(0.86) → 正文顶(1)；滚轮一格 /
         滑动一次 / 方向键一下翻一页，整幕约 3.1s，找回正片的从容节奏
       - 从正文向上滚过边界自动回到演示态倒放对应一幕；返回顶部把倒放
         委托给本脚本（site:intro-reverse），不再用滚动擦时间线 */
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) return;
      var scene = document.querySelector('.scene');
      if (!scene) return;
      scene.classList.add('has-motion');
      var pin = scene.querySelector('.scene-pin');
      var bottom = scene.querySelector('.scene-bottom');
      var cta = scene.querySelector('[data-cinematic-scroll]');
      var root = document.documentElement;
      var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
      var smooth = function (v) { v = clamp(v); return v * v * (3 - 2 * v); };
      var ramp = function (p, a, b) { return smooth((p - a) / (b - a)); };

      /* ===== 渲染：纯函数。画面只由进度 p 决定，与滚动位置无关 ===== */
      var playing = false;
      function render(p) {
        var hold = ramp(p, 0, 0.16);
        var incision = ramp(p, 0.14, 0.28);
        var tear = ramp(p, 0.26, 0.46);
        var paper = ramp(p, 0.4, 0.62);
        var lineIn = ramp(p, 0.5, 0.68);
        var poster = ramp(p, 0.54, 0.72);
        var stamp = ramp(p, 0.66, 0.78);
        var arrive = ramp(p, 0.68, 0.86);
        var exit = ramp(p, 0.88, 1);
        var mobile = window.innerWidth <= 760;
        var st = pin.style;
        st.setProperty('--scene-p', p.toFixed(4));
        st.setProperty('--hero-y', '0vh');
        st.setProperty('--hero-scale', (1.04 + hold * 0.04 + tear * 0.02).toFixed(3));
        st.setProperty('--hero-blur', (tear * (mobile ? 3 : 6)).toFixed(2) + 'px');
        st.setProperty('--hero-opacity', (1 - ramp(p, 0.28, 0.44)).toFixed(3));
        st.setProperty('--copy-y', '0vh');
        st.setProperty('--copy-opacity', (1 - ramp(p, 0.34, 0.5)).toFixed(3));
        st.setProperty('--copy-blur', (tear * (mobile ? 3 : 6)).toFixed(2) + 'px');
        st.setProperty('--intro-opacity', (1 - ramp(p, 0.08, 0.22)).toFixed(3));
        st.setProperty('--intro-y', (-ramp(p, 0.08, 0.22) * 4).toFixed(2) + 'vh');
        st.setProperty('--title-a-x', (-tear * (mobile ? 9 : 14)).toFixed(2) + 'vw');
        st.setProperty('--title-a-y', (-tear * (mobile ? 7 : 10)).toFixed(2) + 'vh');
        st.setProperty('--title-b-x', (tear * (mobile ? 10 : 15)).toFixed(2) + 'vw');
        st.setProperty('--title-b-y', (tear * (mobile ? 8 : 11)).toFixed(2) + 'vh');
        st.setProperty('--incision-scale', incision.toFixed(3));
        st.setProperty('--incision-opacity', (1 - ramp(p, 0.42, 0.52)).toFixed(3));
        st.setProperty('--tear-gap', (tear * (mobile ? 6 : 10)).toFixed(2) + '%');
        st.setProperty('--tear-opacity', (1 - ramp(p, 0.4, 0.5)).toFixed(3));
        st.setProperty('--tear-a-x', (-tear * (mobile ? 14 : 28)).toFixed(2) + 'vw');
        st.setProperty('--tear-a-y', (-tear * (mobile ? 12 : 22)).toFixed(2) + 'vh');
        st.setProperty('--tear-a-r', (-tear * (mobile ? 5 : 8)).toFixed(2) + 'deg');
        st.setProperty('--tear-b-x', (tear * (mobile ? 16 : 30)).toFixed(2) + 'vw');
        st.setProperty('--tear-b-y', (tear * (mobile ? 14 : 24)).toFixed(2) + 'vh');
        st.setProperty('--tear-b-r', (tear * (mobile ? 6 : 9)).toFixed(2) + 'deg');
        st.setProperty('--paper-gap', (8 + paper * 105).toFixed(2) + '%');
        st.setProperty('--after-opacity', Math.min(1, paper * 1.6).toFixed(3));
        st.setProperty('--after-scale', (0.94 + paper * 0.06).toFixed(3));
        st.setProperty('--after-title-a-x', (-(1 - poster) * (mobile ? 6 : 12)).toFixed(2) + 'vw');
        st.setProperty('--after-title-b-x', ((1 - poster) * (mobile ? 6 : 12)).toFixed(2) + 'vw');
        st.setProperty('--after-title-y', '0px');
        st.setProperty('--after-title-mask', ((1 - poster) * 85).toFixed(2) + '%');
        st.setProperty('--after-lines-x', ((1 - paper) * -40).toFixed(2) + 'px');
        st.setProperty('--after-lines-opacity', paper.toFixed(3));
        st.setProperty('--after-line', lineIn.toFixed(3));
        st.setProperty('--after-meta', poster.toFixed(3));
        st.setProperty('--after-stamp', stamp.toFixed(3));
        st.setProperty('--focus-opacity', (arrive * (1 - exit)).toFixed(3));
        st.setProperty('--focus-x', ((1 - arrive) * (mobile ? 24 : 18) + exit * (mobile ? 20 : 28)) + 'vw');
        st.setProperty('--focus-y', ((1 - arrive) * (mobile ? 22 : 18) + exit * (mobile ? 6 : 8)) + 'vh');
        st.setProperty('--focus-ry', ((1 - arrive) * -38 + exit * 12).toFixed(2) + 'deg');
        st.setProperty('--focus-rz', ((1 - arrive) * 8 - arrive * 2 - exit * 2).toFixed(2) + 'deg');
        st.setProperty('--focus-scale', (0.76 + arrive * 0.24).toFixed(3));
        st.setProperty('--scene-progress', (p * 100).toFixed(2) + '%');
        st.setProperty('--scroll-cta-opacity', (1 - ramp(p, 0.08, 0.18)).toFixed(3));
        st.setProperty('--chapter', p < 0.28 ? '"01"' : p < 0.74 ? '"02"' : '"03"');
        pin.classList.toggle('is-after', p > 0.4);
        pin.classList.toggle('is-past-intro', p > 0.18 || playing);
        pin.classList.toggle('is-end', p > 0.96);
        bottom.style.opacity = String(1 - ramp(p, 0.04, 0.26));
        bottom.style.transform = 'translateY(' + tear * 70 + 'px)';
        bottom.style.visibility = p > 0.28 ? 'hidden' : 'visible';
        var focus = scene.querySelector('.scene-focus');
        if (focus) {
          var active = p > 0.62 && p < 0.97;
          focus.toggleAttribute('inert', !active);
          focus.setAttribute('aria-hidden', String(!active));
        }
        var sceneLink = scene.querySelector('.scene-link');
        if (sceneLink) sceneLink.toggleAttribute('inert', p > 0.22);
        if (cta) {
          cta.toggleAttribute('inert', p > 0.18 || playing);
          if (playing) cta.setAttribute('aria-disabled', 'true');
          else cta.removeAttribute('aria-disabled');
        }
      }
      /* ===== 几何与状态 =====
         停靠点仍是文档坐标：end = 三幕播完时的滚动位置，p=1 的 sticky 画面
         与 scrollY=end 的画面逐像素一致，交接因此零跳变。 */
      function trackDistance() { return scene.offsetHeight - pin.offsetHeight; }
      function endY() { return scene.offsetTop + trackDistance(); }
      function scrollP() {
        var d = trackDistance();
        if (d <= 0) return 0;
        return clamp((window.scrollY - scene.offsetTop) / d);
      }

      var STOPS = [0, 0.86, 1]; /* 封面 → 海报+卡片 → 正文顶 */
      var present = false;      /* 演示态：滚动已锁，虚拟时间线驱动画面 */
      var vp = 0;               /* 虚拟进度 */
      var stage = 0;            /* 当前补间的目标幕 */
      var flipFrame = 0;
      var contentFrame = 0;     /* 端点停靠 → 正文的交接滚动 */
      var navFlight = false;    /* skip-link 锚点飞行期间不抢越界 */
      var lastY = window.scrollY;
      var ticking = false;

      /* 加速—匀速—减速的梯形速度：与旧版正片同款节奏。对称缓动会把切口
         推得太靠后，观影像页面卡住。 */
      var CINEMA_ACCEL = 0.16;
      var CINEMA_DECEL = 0.24;
      var CINEMA_CRUISE = 1 / (1 - (CINEMA_ACCEL + CINEMA_DECEL) / 2);
      var easeCinema = function (x) {
        x = clamp(x);
