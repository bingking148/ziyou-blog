---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MoodKnob from '../components/MoodKnob.astro';
import InkPlate from '../components/InkPlate.astro';
import { columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';
import { TYPING_STRINGS, SOCIAL } from '../consts.ts';

const posts = (await getCollection('post')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);
const latest = posts[0];
const recent = posts.slice(0, 6);
const aiColumn = columns.find((c) => c.data.category === '人工智能学习');
const aiPool = aiColumn ? columnPosts(aiColumn, posts) : [];
const essay = aiPool.length ? aiPool[Math.floor(Math.random() * aiPool.length)] : undefined;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const shortTitle = (t: string) => t.split('——')[0];
---

<Base pageClass="is-home">
  <section id="header" class="shot" aria-label="开场">
    <div class="shot-pin">
      <div class="shot-frame">
        <img class="shot-still" src="/images/hero-bg-1920.jpg" alt="" />
        <div class="shot-grade" aria-hidden="true"></div>
        <div class="shot-bar shot-bar-top" aria-hidden="true"></div>
        <div class="shot-bar shot-bar-bottom" aria-hidden="true"></div>
      </div>
      <div class="shot-safe">
        <p class="slate-kicker"><i></i>场记 01 · 站训</p>
        <h1 class="scene-title">
          <span class="title-line">在键盘上，</span>
          <span class="title-line">写下又一行注释。</span>
        </h1>
        <div class="clapper" aria-hidden="true"><i></i></div>
        <p class="shot-next">代码之外，仍有世界。</p>
        <div class="shot-actions">
          <p class="shot-typing"><span id="typing-text">{TYPING_STRINGS[0]}</span><span class="typing-cursor" aria-hidden="true"></span></p>
          <a class="shot-link" href={postUrl(latest)}>阅读最新一篇</a>
          <a class="shot-roll" href="#journal" data-shot-roll>开拍</a>
        </div>
      </div>
      <p class="shot-take" aria-hidden="true"><span class="take-now">01</span><span class="take-next">02</span></p>
    </div>
  </section>

  <div id="journal" class="journal">
    <section class="opening" data-reveal>
      <p class="slate-kicker ink"><i></i>场记 02 · 序</p>
      <p class="opening-text">
        这里不追逐热点，只记录那些<span>真正想明白的事</span>。
        从大模型的原理，到 Python 的第一行代码，再到数学与世界运作的方式——慢慢写，认真想。
      </p>
    </section>

    <section class="series" aria-labelledby="series-title">
      <header class="section-head" data-reveal>
        <div>
          <p class="slate-kicker ink"><i></i>场记 03 · 专栏</p>
          <h2 id="series-title">按顺序读完</h2>
        </div>
        <a class="text-link" href="/columns/">全部专栏</a>
      </header>
      <ol class="serial-list">
        {columns.map((c, i) => {
          const list = columnPosts(c, posts);
          const first = list[0];
          return (
            <li data-reveal>
              <a class="serial-row" href={`/categories/${slugifyTaxonomy(c.data.category)}/`}>
                <span class="serial-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="serial-name">{c.data.title.replace('专栏', '')}</span>
                <span class="serial-count">{String(list.length).padStart(2, '0')} 篇</span>
                <span class="serial-next">{first ? shortTitle(first.data.title) : '开始阅读'}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {essay && (
      <section class="interlude" data-reveal aria-label="随笔">
        <div class="film-gate"><InkPlate seed={essay.id} /></div>
        <div>
          <p class="slate-kicker ink"><i></i>场记 04 · 随笔</p>
          <h2><a href={postUrl(essay)}>{shortTitle(essay.data.title)}</a></h2>
          <p>{essay.data.description}</p>
          <a class="text-link" href={postUrl(essay)}>读这一篇</a>
        </div>
      </section>
    )}

    <section class="latest" aria-labelledby="latest-title">
      <header class="section-head" data-reveal>
        <div>
          <p class="slate-kicker ink"><i></i>场记 05 · 最近</p>
          <h2 id="latest-title">最近写下</h2>
        </div>
        <a class="text-link" href="/archives/">全部归档</a>
      </header>
      <ol class="serial-list">
        {recent.map((p, i) => (
          <li data-reveal>
            <a class="serial-row" href={postUrl(p)}>
              <span class="serial-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="serial-name">{shortTitle(p.data.title)}</span>
              <time class="serial-count" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="serial-next">{p.data.categories[0]}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="colophon" data-reveal>
      <div>
        <p class="slate-kicker ink"><i></i>场记 06 · 关于</p>
        <h2>一个仍在学习的人，<br />和一块留给好奇心的地方。</h2>
        <p>写代码，也写那些代码解释不了的问题。如果这个角落对你有用，欢迎常来。</p>
        <div class="colophon-links">
          <a class="text-link" href="/about/">关于我</a>
          {SOCIAL.github && <a class="text-link" href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>}
        </div>
        <div class="colophon-tags">
          {tags.slice(0, 8).map((t) => <a href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>)}
        </div>
      </div>
      <MoodKnob />
    </section>
  </div>

  <script define:vars={{ strings: TYPING_STRINGS }}>
    (function () {
      'use strict';
      var el = document.getElementById('typing-text');
      if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var order = strings.slice(), idx = 0, pos = order[0].length, deleting = true;
      function tick() {
        if (document.hidden) return setTimeout(tick, 1000);
        var s = order[idx];
        if (!deleting) {
          pos++; el.textContent = s.slice(0, pos);
          if (pos >= s.length) { deleting = true; return setTimeout(tick, 2400); }
          setTimeout(tick, 110);
        } else {
          pos--; el.textContent = s.slice(0, pos);
          if (pos <= 0) { deleting = false; idx = (idx + 1) % order.length; return setTimeout(tick, 600); }
          setTimeout(tick, 45);
        }
      }
      setTimeout(tick, 2600);
    })();
  </script>
  <script>
    (function () {
      'use strict';
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var shot = document.querySelector('.shot');
      if (!shot) return;
      var pin = shot.querySelector('.shot-pin');
      var next = shot.querySelector('.shot-next');
      var roll = shot.querySelector('[data-shot-roll]');
      var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
      var smooth = function (v) { v = clamp(v); return v * v * (3 - 2 * v); };
      var ramp = function (p, a, b) { return smooth((p - a) / (b - a)); };
      function paint(p) {
        var focus = ramp(p, 0.02, 0.48);
        var clapper = ramp(p, 0.3, 0.5);
        var shown = p > 0.58 ? 1 : 0;
        if (!pin) return;
        pin.style.setProperty('--focus', focus.toFixed(3));
        pin.style.setProperty('--push', (1.14 - focus * 0.1).toFixed(3));
        pin.style.setProperty('--clapper', clapper.toFixed(3));
        pin.style.setProperty('--next', String(shown));
        pin.style.setProperty('--bars', (8 - focus * 3.5).toFixed(2) + 'vh');
        pin.classList.toggle('is-next', shown === 1);
        if (next) next.setAttribute('aria-hidden', shown ? 'false' : 'true');
      }
      if (reduced.matches) { paint(1); return; }
      shot.classList.add('has-motion');
      var ticking = false;
      var playing = false;
      function update() {
        ticking = false;
        var distance = shot.offsetHeight - (pin ? pin.offsetHeight : 0);
        var p = distance > 0 ? clamp(-shot.getBoundingClientRect().top / distance) : 1;
        paint(p);
      }
      function schedule() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      if (roll) roll.addEventListener('click', function (event) {
        event.preventDefault();
        if (playing) return;
        var distance = shot.offsetHeight - (pin ? pin.offsetHeight : 0);
        var from = window.scrollY;
        var to = shot.offsetTop + distance * 0.92;
        if (from >= to - 4) return;
        playing = true;
        var t0 = performance.now();
        function step(now) {
          var t = clamp((now - t0) / 1400);
          var e = t * t * (3 - 2 * t);
          window.scrollTo(0, from + (to - from) * e);
          if (t < 1) requestAnimationFrame(step);
          else playing = false;
        }
        requestAnimationFrame(step);
      });
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    })();
  </script>
</Base>

<style>
  .shot { position: relative; height: 165svh; background: #07090d; color: #f4efe6; }
  .shot-pin {
    --focus: 0; --push: 1.14; --clapper: 0; --next: 0; --bars: 8vh;
    position: sticky; top: 64px; height: calc(100svh - 64px); min-height: 560px; overflow: hidden;
  }
  .shot-frame { position: absolute; inset: 0; }
  .shot-still {
    width: 100%; height: 100%; object-fit: cover; object-position: 68% 42%;
    transform: scale(var(--push)); transform-origin: 70% 40%;
    filter: blur(calc((1 - var(--focus)) * 8px)) saturate(.62) contrast(1.08);
  }
  .shot-grade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(7,9,13,.88) 0%, rgba(7,9,13,.62) 34%, rgba(7,9,13,.18) 58%, rgba(7,9,13,.28) 100%),
      linear-gradient(180deg, rgba(7,9,13,.45), transparent 22% 70%, rgba(7,9,13,.55));
  }
  .shot-bar { position: absolute; left: 0; right: 0; height: var(--bars); background: #07090d; z-index: 2; }
  .shot-bar-top { top: 0; }
  .shot-bar-bottom { bottom: 0; }
  .shot-safe {
    position: absolute; z-index: 3;
    left: clamp(24px, 7vw, 108px); right: clamp(24px, 8vw, 120px);
    top: 50%; transform: translateY(-54%);
    width: min(760px, 62vw);
  }
  .slate-kicker {
    display: flex; align-items: center; gap: 12px; margin: 0 0 18px;
    font-size: 13px; letter-spacing: .18em; color: rgba(244,239,230,.78);
  }
  .slate-kicker i { width: 28px; height: 2px; background: #d4532c; }
  .slate-kicker.ink { color: var(--color-text-muted); }
  .scene-title {
    margin: 0; font-weight: 500; color: #f7f1e8;
    font-size: clamp(42px, 5.4vw, 84px); line-height: 1.22; letter-spacing: .02em;
    text-shadow: 0 10px 30px rgba(0,0,0,.35);
  }
  .title-line { display: block; }
  .clapper { width: min(460px, 78%); height: 3px; margin: 22px 0 18px; background: rgba(244,239,230,.2); }
  .clapper i { display: block; height: 100%; width: calc(var(--clapper) * 100%); background: #d4532c; }
  .shot-next {
    margin: 0; max-width: 12em; opacity: var(--next);
    font-family: var(--font-serif); font-size: clamp(26px, 2.8vw, 40px); line-height: 1.35; color: #f7f1e8;
  }
  .shot-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 28px; }
  .shot-typing { margin: 0; min-height: 1.5em; color: rgba(244,239,230,.72); font-size: 15px; }
  .typing-cursor { display: inline-block; width: 1px; height: .9em; margin-left: 4px; background: currentColor; animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .shot-link, .shot-roll, .text-link { color: #f7f1e8; border-bottom: 1px solid #d4532c; padding-bottom: 3px; letter-spacing: .08em; }
  .text-link { color: var(--color-text-strong); }
  .shot-roll { background: #d4532c; color: #140e0c; border: 0; padding: 8px 16px 7px; }
  .shot-link:hover, .text-link:hover { color: #d4532c; }
  .shot-roll:hover { background: #e06a42; color: #140e0c; }
  .shot-take {
    position: absolute; z-index: 3; right: clamp(20px, 4vw, 48px); bottom: calc(var(--bars) + 16px);
    margin: 0; font-variant-numeric: tabular-nums; letter-spacing: .14em; color: rgba(244,239,230,.7); font-size: 13px;
  }
  .shot-pin.is-next .take-now { color: rgba(244,239,230,.35); }
  .shot-pin.is-next .take-next { color: #d4532c; }
  .take-now::after { content: ' / '; }

  .journal { background: var(--color-bg); color: var(--color-text); }
  .opening, .series, .latest, .interlude, .colophon { max-width: 980px; margin-left: auto; margin-right: auto; padding-left: clamp(22px, 5vw, 40px); padding-right: clamp(22px, 5vw, 40px); }
  .opening { padding-top: 88px; padding-bottom: 28px; }
  .opening-text { margin: 0; max-width: 16em; font-family: var(--font-serif); font-size: clamp(26px, 3vw, 40px); line-height: 1.7; color: var(--color-text-strong); }
  .opening-text span { box-shadow: inset 0 -.28em 0 color-mix(in srgb, var(--color-accent) 45%, transparent); }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .section-head h2, .colophon h2, .interlude h2 { margin: 0; font-weight: 500; letter-spacing: .02em; color: var(--color-text-strong); }
  .section-head h2 { font-size: clamp(32px, 3.4vw, 48px); }
  .series, .latest { padding-bottom: 64px; }
  .serial-list { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .serial-row {
    display: grid; grid-template-columns: 44px minmax(0, 1.5fr) auto minmax(0, 1fr);
    gap: 12px 18px; align-items: baseline; padding: 18px 8px 18px 0;
    border-bottom: 1px solid var(--color-card-border); color: var(--color-text-strong);
    border-left: 0 solid #d4532c; transition: border-left-width .35s var(--ease-shot), padding-left .35s var(--ease-shot);
  }
  .serial-row:hover { border-left-width: 3px; padding-left: 12px; color: var(--color-text-strong); }
  .serial-no { color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .serial-name { font-family: var(--font-serif); font-size: 22px; line-height: 1.45; }
  .serial-count, .serial-next { color: var(--color-text-muted); font-size: 14px; }
  .interlude { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 36px; align-items: center; padding-bottom: 72px; }
  .film-gate { background: #0c1016; padding: 12px 14px 14px; border-left: 3px solid #d4532c; }
  .interlude h2 { font-size: clamp(26px, 2.6vw, 36px); line-height: 1.35; }
  .interlude h2 a { color: var(--color-text-strong); }
  .interlude p { color: var(--color-text-muted); line-height: 1.85; }
  .colophon { display: grid; grid-template-columns: minmax(0, 1.4fr) 280px; gap: 32px; align-items: center; padding-top: 20px; padding-bottom: 80px; border-top: 1px solid var(--color-card-border); }
  .colophon h2 { font-size: clamp(28px, 3vw, 42px); line-height: 1.4; }
  .colophon p { color: var(--color-text-muted); line-height: 1.85; }
  .colophon-links { display: flex; gap: 22px; }
  .colophon-tags { display: flex; flex-wrap: wrap; gap: 10px 16px; margin-top: 18px; }
  .colophon-tags a { color: var(--color-text-muted); }
  .colophon-tags a:hover { color: var(--color-accent); }

  @media (max-width: 800px) {
    .shot { height: auto; }
    .shot-pin { position: relative; top: 0; height: auto; min-height: 100svh; }
    .shot-safe { position: relative; top: auto; transform: none; width: auto; padding: 18vh 22px 12vh; }
    .scene-title { font-size: clamp(34px, 9.2vw, 46px); }
    .shot-next { opacity: 1; font-size: 24px; }
    .shot-actions { flex-direction: column; align-items: flex-start; }
    .shot-take { display: none; }
    .interlude, .colophon, .serial-row { grid-template-columns: 1fr; }
    .serial-count, .serial-next { display: none; }
    .opening { padding-top: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot { height: auto; }
    .shot-pin { position: relative; top: 0; height: auto; min-height: 88svh; --focus: 1; --push: 1; --clapper: 1; --next: 1; --bars: 5vh; }
    .shot-still { filter: saturate(.7) contrast(1.05); transform: none; }
    .shot-next { opacity: 1; }
    .clapper i { width: 100%; }
    .typing-cursor { animation: none; }
    .serial-row { transition: none; }
  }
</style>
