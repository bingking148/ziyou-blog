---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Comments from '../components/Comments.astro';
import { FRIENDS } from '../data/friends.ts';
import { SITE_TITLE, AUTHOR, SINCE } from '../consts.ts';
---

<Base title="友情链接" description="友情链接与交换方式">
  <div class="ed-wrap">
    <PageHero
      index="03"
      label="FRIENDS"
      title="友情链接"
      lede="独立写作者之间，互相留一盏灯。"
      meta={[
        { value: String(FRIENDS.length), label: '位朋友' },
        { value: String(SINCE), label: '本站创立于' },
      ]}
    />

    <!-- 本站信息 -->
    <section class="friend-section" data-reveal>
      <h2 class="section-title"><span class="ed-label">THIS SITE</span>本站信息</h2>
      <dl class="site-info">
        <div class="info-item"><dt>站名</dt><dd>{SITE_TITLE}</dd></div>
        <div class="info-item"><dt>站长</dt><dd>{AUTHOR}</dd></div>
        <div class="info-item"><dt>网址</dt><dd>https://ziyou814.top</dd></div>
      </dl>
    </section>

    <!-- 小伙伴们 -->
    <section class="friend-section" data-reveal>
      <h2 class="section-title"><span class="ed-label">BLOGROLL</span>小伙伴们</h2>
      <div class="friend-list">
        {FRIENDS.map((f, i) => (
          <a class="friend-row" href={f.url} target="_blank" rel="noopener">
            <span class="friend-no">{String(i + 1).padStart(2, '0')}</span>
            <img class="friend-avatar" src={f.image} alt={f.name} loading="lazy" />
            <span class="friend-info">
              <strong>{f.name}</strong>
              <span class="friend-desc">{f.desc}</span>
            </span>
            <span class="friend-url">{new URL(f.url).hostname}</span>
            <span class="friend-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 申请 -->
    <section class="friend-section" data-reveal>
      <h2 class="section-title"><span class="ed-label">EXCHANGE</span>交换友链</h2>
      <p class="apply-note">先添加本站，然后在本页留言，按下面的格式留下你的信息。</p>
      <div class="apply-code">
        <pre><code>- name: # 您的名字
  url: # 您的网址
  desc: # 简短描述
  image: # 一张图片</code></pre>
      </div>
    </section>

    <div class="friend-comments" data-reveal>
      <Comments path="/friend/" />
    </div>
  </div>
</Base>

<style>
  .friend-section { margin-bottom: 72px; }
  .section-title { display: flex; align-items: baseline; gap: 18px; margin: 0 0 28px; font-size: 26px; font-weight: 500; letter-spacing: .04em; }
  .section-title .ed-label { flex-shrink: 0; }

  .site-info { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 24px; margin: 0; padding: 28px 0; border-top: 1px solid var(--color-card-border); border-bottom: 1px solid var(--color-card-border); }
  .info-item dt { font-size: 11px; letter-spacing: .2em; color: var(--color-text-muted); margin-bottom: 10px; }
  .info-item dd { margin: 0; font-family: var(--font-serif); font-size: 20px; color: var(--color-text-strong); overflow-wrap: anywhere; }

  .friend-list { border-top: 1px solid var(--color-card-border); }
  .friend-row {
    display: flex; align-items: center; gap: clamp(16px, 3vw, 32px);
    padding: 24px 8px;
    border-bottom: 1px solid var(--color-card-border);
    color: var(--color-text-strong);
    transition: background .3s ease;
  }
  .friend-row:hover { background: var(--red-5-5); }
  .friend-no { font-size: 11px; color: var(--red-2); }
  .friend-avatar {
    width: 84px; height: 84px; object-fit: cover; flex-shrink: 0;
    border: 1px solid var(--color-card-border);
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .friend-row:hover .friend-avatar { transform: scale(1.05); }
  .friend-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .friend-info strong { font-family: var(--font-serif); font-size: 22px; font-weight: 500; letter-spacing: .04em; }
  .friend-desc { font-size: 13px; color: var(--color-text-muted); }
  .friend-url { flex-shrink: 0; font-size: 12px; color: var(--color-text-muted); letter-spacing: .04em; }
  .friend-arrow { flex-shrink: 0; font-size: 20px; color: var(--red-2); transition: transform .3s ease; }
  .friend-row:hover .friend-arrow { transform: translate(4px,-4px); }

  .apply-note { margin: 0 0 20px; font-size: 14px; color: var(--color-text-muted); }
  .apply-code { background: #17202c; padding: 24px 28px; }
  .apply-code pre { margin: 0; overflow-x: auto; }
  .apply-code code { font-family: var(--font-code); font-size: 13.5px; line-height: 1.9; color: #c9d6e8; }

  .friend-comments { padding-top: 8px; border-top: 1px solid var(--color-card-border); }

  @media (max-width: 760px) {
    .friend-section { margin-bottom: 56px; }
    .section-title { font-size: 22px; gap: 12px; }
    .site-info { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
    .info-item:last-child { grid-column: 1 / -1; }
    .friend-avatar { width: 64px; height: 64px; }
    .friend-url { display: none; }
    .friend-info strong { font-size: 19px; }
  }
</style>
