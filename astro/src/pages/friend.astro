---
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';

const friends = [
  {
    name: '+7',
    url: 'https://seven-blog.pages.dev',
    image: 'https://seven-blog.pages.dev/images/avatar.jpg',
    desc: '记录技术成长之路',
  },
];
---

<Base title="友情链接" description="友情链接">
  <div class="page-wrap" data-reveal>
    <div class="page-inner card prose">
      <h1>友情链接</h1>

      <h2>本站信息</h2>
      <ul>
        <li>站名：My Blog</li>
        <li>站长：Blog Owner</li>
      </ul>

      <h2>申请方法</h2>
      <p>添加本站后，在本页留言，格式如下</p>
      <pre><code>- name: #您的名字
  url: #您的网址
  desc: #简短描述
  image: #一张图片</code></pre>

      <h2>小伙伴们</h2>
      <div class="friend-grid">
        {friends.map((f) => (
          <a class="friend-card" href={f.url} target="_blank" rel="noopener">
            <img src={f.image} alt={f.name} loading="lazy" />
            <div class="friend-info">
              <strong>{f.name}</strong>
              <p>{f.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
    <Comments path="/friend/" />
  </div>
</Base>

<style>
  .page-wrap { max-width: 820px; margin: 0 auto; padding: 40px 0; }
  .page-inner { padding: 36px 44px; }
  .page-inner h1 { margin: 0 0 1em; font-size: 32px; letter-spacing: 3px; }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin: 20px 0;
  }
  .friend-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    background: var(--color-surface-muted);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .friend-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .friend-card img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .friend-info strong { display: block; font-size: 15px; color: var(--color-text-strong); }
  .friend-info p { margin: 4px 0 0; font-size: 13px; color: var(--color-text-muted); }
  @media (max-width: 767px) {
    .page-inner { padding: 24px 20px; }
  }
</style>
