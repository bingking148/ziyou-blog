---
import Base from '../layouts/Base.astro';
import ChapterRule from '../components/ChapterRule.astro';
import Comments from '../components/Comments.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { FRIENDS } from '../data/friends.ts';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SINCE } from '../consts.ts';
---

<Base title="友情链接" description="友情链接与交换方式">
  <link slot="head" rel="stylesheet" href="/resources/waline/waline.css" />
  <div class="ed-wrap ed-wrap--wide friend-page">
    <ChapterRule no="03" label="友链" en="LAMPS" value={`${FRIENDS.length} LIT · EST. ${SINCE}`} />

    <div class="lamp-lede" data-reveal>
      <h1>互相留<em>一盏灯</em>。</h1>
      <span>EVERY CARD KEEPS A LIGHT ON</span>
    </div>

    <!-- 名片阵列 -->
    <div class="deck">
      <div class="bizcard mine" data-reveal style="--i:1">
        <i class="lamp on" aria-hidden="true"></i>
        <span class="bc-tag">THIS SITE / 本站</span>
        <b class="bc-name">{SITE_TITLE}</b>
        <span class="bc-desc">{SITE_DESCRIPTION}。</span>
        <div class="bc-meta">
          <span>ziyou814.top</span>
          <span>EST. {SINCE} · {AUTHOR}</span>
        </div>
        <button
          class="bc-copy"
          type="button"
          data-copy={`- name: ${SITE_TITLE}\n  url: https://ziyou814.top\n  desc: ${SITE_DESCRIPTION}。\n  image: https://ziyou814.top/images/hero-bg-1280.jpg`}
        >复制本站信息</button>
        <span class="seal" aria-hidden="true">留灯</span>
      </div>

      {FRIENDS.map((f, i) => (
        <a
          class="bizcard fr"
          href={f.url}
          target="_blank"
          rel="noopener"
          data-name={f.name}
          data-reveal
          style={`--i:${i + 2}`}
        >
          <i class="lamp on" aria-hidden="true"></i>
          <ResponsiveImage class="fr-avatar" src={f.image} alt={f.name} sizes="84px" loading="lazy" />
          <span class="fr-info">
            <b>{f.name}</b>
            <small>{f.desc}</small>
            <u>{new URL(f.url).hostname}</u>
          </span>
          <span class="fr-arrow" aria-hidden="true">↗</span>
        </a>
      ))}

      <div class="bizcard slot" data-reveal style={`--i:${FRIENDS.length + 2}`}>
        <i class="lamp off" aria-hidden="true"></i>
        <div class="slot-copy">
          <b>你的名片留在这里</b>
          <small>申请交换 · EXCHANGE</small>
        </div>
      </div>
    </div>

    <!-- 交换 -->
    <div class="exchange" data-reveal>
      <p class="ex-note">
        先添加本站，然后<b>在本页留言</b>，按右边格式留下你的信息。<br />
        审核通过后，你的灯也会亮在这里。
      </p>
      <pre class="ex-code"><code>- name: <em># 您的名字</em>
  url: <em># 您的网址</em>
  desc: <em># 简短描述</em>
  image: <em># 一张图片</em></code></pre>
    </div>

    <div class="friend-comments" data-reveal>
      <div class="comments-head" aria-hidden="true">
        <span>留言 · 交换记录</span>
        <b>WALINE / OPEN</b>
      </div>
      <Comments path="/friend/" />
    </div>
  </div>
</Base>

<script>
  (function () {
    'use strict';
    // 一键复制本站信息：留言交换前，先把本站加到对方的友链里
    var copyBtn = document.querySelector('.bc-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var text = copyBtn.getAttribute('data-copy') || '';
        var done = function (ok) {
          copyBtn.textContent = ok ? '已复制 ✓' : '复制失败，请手动复制';
          copyBtn.classList.toggle('is-done', ok);
          setTimeout(function () {
            copyBtn.textContent = '复制本站信息';
            copyBtn.classList.remove('is-done');
          }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
        } else { done(false); }
      });
    }

    // 第三方头像失败兜底：首字母方块替代破图
    document.querySelectorAll('.bizcard.fr img').forEach(function (img) {
      var swap = function () {
        var card = img.closest('.bizcard');
        var name = (card && card.getAttribute('data-name')) || '?';
        var span = document.createElement('span');
        span.className = 'fr-fallback';
        span.setAttribute('aria-hidden', 'true');
        span.textContent = name.slice(0, 1).toUpperCase();
        img.replaceWith(span);
      };
      if (img.complete && img.naturalWidth === 0) swap();
      else img.addEventListener('error', swap, { once: true });
    });
  })();
</script>

<style>
  .friend-page { --hard: #111; }
  :global([data-theme="dark"]) .friend-page { --hard: #e10600; }

  .lamp-lede { display: flex; align-items: baseline; gap: clamp(16px, 3vw, 36px); flex-wrap: wrap; margin-top: 40px; }
  .lamp-lede h1 { margin: 0; font-size: clamp(30px, 3.4vw, 46px); font-weight: 500; letter-spacing: .05em; color: var(--color-text-strong); }
  .lamp-lede h1 em { font-style: normal; color: var(--color-accent); }
  .lamp-lede span { font-family: var(--font-code); font-size: 10px; letter-spacing: .24em; color: var(--color-text-muted); }

  /* 灯：本页唯一的循环动效 */
  .lamp { position: absolute; left: 16px; top: 16px; width: 12px; height: 12px; border-radius: 0; transform: rotate(45deg); }
  .lamp.on { background: var(--color-accent); box-shadow: 4px 4px 0 #111; animation: lamp-breathe 3.6s ease-in-out infinite; }
  .lamp.off { background: transparent; border: 1px solid color-mix(in srgb, var(--color-text-faint) 45%, transparent); }
  @keyframes lamp-breathe { 50% { box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 85%, transparent); } }

  .deck { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; margin-top: 44px; }
  .bizcard {
    position: relative;
    display: flex; flex-direction: column; gap: 11px;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    box-shadow: 11px 13px 0 var(--hard);
    padding: 24px;
    transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s ease;
  }
  .bizcard:hover { transform: translate(-4px, -4px); box-shadow: 16px 16px 0 var(--hard); }
  .mine { transform: none; border: 3px solid #111; }
  .mine:hover { transform: translate(-4px, -4px); }
  .fr { transform: none; flex-direction: row; align-items: center; gap: 18px; border: 3px solid #111; box-shadow: 10px 10px 0 #c41e3a; }
  .fr:hover { transform: translate(-3px, -3px); }
  .slot { border: 3px solid #111; box-shadow: none; background: transparent; display: grid; place-items: center; text-align: center; padding: 28px 22px; }
  .slot .lamp { position: static; margin: 0 auto 12px; }

  .bc-tag { font-family: var(--font-code); font-size: 10px; letter-spacing: .22em; color: var(--color-accent); padding-left: 26px; }
  .bc-name { font-family: var(--font-article); font-weight: 800; font-size: clamp(28px, 2.6vw, 36px); letter-spacing: -.01em; line-height: 1; color: var(--color-text-strong); padding-left: 26px; }
  .bc-desc { font-family: var(--font-serif); font-size: 13.5px; color: var(--color-text-muted); padding-left: 26px; }
  .bc-meta { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--color-card-border); padding-top: 13px; font-family: var(--font-code); font-size: 11px; color: var(--color-text-muted); }
  .bc-copy {
    align-self: flex-start; margin-left: 26px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: transparent; color: var(--color-accent);
    padding: 5px 12px; cursor: pointer;
    font-family: var(--font-code); font-size: 11px; letter-spacing: .08em;
    transition: background .25s ease, color .25s ease;
  }
  .bc-copy:hover, .bc-copy.is-done { background: var(--color-accent); color: #fff; }
  .seal {
    position: absolute; right: 15px; top: 15px;
    width: 46px; aspect-ratio: 1;
    border: 1px solid var(--color-accent); color: var(--color-accent);
    display: grid; place-items: center;
    font-family: var(--font-serif); font-size: 15px; line-height: 1.2;
    writing-mode: vertical-rl; letter-spacing: .12em;
    transform: rotate(8deg); opacity: .9;
  }

  .fr-avatar { width: 84px; height: 84px; object-fit: cover; flex-shrink: 0; margin-left: 12px; border: 1px solid var(--color-card-border); }
  .fr-fallback {
    width: 84px; height: 84px; flex-shrink: 0; margin-left: 12px;
    display: grid; place-items: center;
    background: linear-gradient(140deg, var(--red-2), var(--red-0));
    color: #fff; font-family: var(--font-article); font-weight: 800; font-size: 30px;
  }
  .fr-info { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .fr-info b { font-family: var(--font-serif); font-size: 22px; font-weight: 500; letter-spacing: .04em; color: var(--color-text-strong); }
  .fr-info small { font-size: 13px; color: var(--color-text-muted); }
  .fr-info u { font-family: var(--font-code); font-size: 10.5px; color: var(--red-2); text-decoration: none; letter-spacing: .04em; }
  .fr-arrow { margin-left: auto; align-self: flex-start; color: var(--red-2); font-size: 18px; padding-right: 4px; }

  .slot-copy b { display: block; font-family: var(--font-serif); font-size: 17px; font-weight: 500; color: var(--color-text); }
  .slot-copy small { display: block; margin-top: 8px; font-family: var(--font-code); font-size: 10px; letter-spacing: .2em; color: var(--color-text-muted); }

  .exchange { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 30px; align-items: start; margin-top: 64px; }
  .ex-note { margin: 0; font-family: var(--font-serif); font-size: 16.5px; line-height: 2.1; color: var(--color-text); }
  .ex-note b { color: var(--color-accent); font-weight: 500; }
  .ex-code { margin: 0; background: var(--color-text-strong); padding: 22px 26px; }
  .ex-code code { font-family: var(--font-code); font-size: 13.5px; line-height: 2.05; color: color-mix(in srgb, var(--color-bg) 88%, transparent); }
  .ex-code em { font-style: normal; color: color-mix(in srgb, var(--color-accent) 80%, #e8b7a8); }

  .friend-comments { margin-top: 64px; border-top: 1px dashed var(--color-card-border); padding-top: 24px; }
  .comments-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22px; font-size: 11px; letter-spacing: .22em; color: var(--color-text-muted); }
  .comments-head b { font-family: var(--font-code); color: var(--color-accent); font-weight: 700; }

  @media (min-width: 1440px) {
    .lamp-lede { margin-top: 52px; }
    .lamp-lede h1 { font-size: clamp(36px, 3vw, 52px); }
    .deck { gap: var(--wide-gap); margin-top: 56px; }
    .exchange { gap: var(--wide-gap); margin-top: 84px; }
    .fr-avatar { width: 96px; height: 96px; }
    .friend-comments { margin-top: 84px; max-width: 1180px; }
  }
  @media (max-width: 760px) {
    .lamp-lede { margin-top: 28px; }
    .lamp-lede h1 { font-size: 27px; }
    .deck { grid-template-columns: 1fr; gap: 26px; margin-top: 34px; }
    .bizcard { box-shadow: 6px 7px 0 var(--hard); padding: 20px; }
    .fr { box-shadow: 6px 7px 0 color-mix(in srgb, var(--hard) 85%, transparent); }
    .fr-avatar { width: 66px; height: 66px; }
    .fr-info b { font-size: 19px; }
    .exchange { grid-template-columns: 1fr; margin-top: 52px; }
    .friend-comments { margin-top: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp.on { animation: none; }
    .bizcard, .bizcard:hover { transition: none; }
  }
</style>
