---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChapterRule from '../../components/ChapterRule.astro';
import { slugifyTaxonomy } from '../../utils/columns.ts';

const posts = await getCollection('post');
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const max = Math.max(...tags.map(([, c]) => c));
---

<Base title="标签" description="文章标签">
  <div class="ed-wrap ed-wrap--wide">
    <ChapterRule no="07" label="标签" en="TAGS" value={`${tags.length} 个标签`} title="标签" lede="按关键词，找到同一主题的文字。" />
    <div class="tag-cloud" data-reveal>
      {tags.map(([name, count]) => (
        <a
          class="ed-tag cloud-tag"
          href={`/tags/${slugifyTaxonomy(name)}/`}
          style={`font-size: ${14 + (count / max) * 8}px`}
        >
          {name}<sup>{count}</sup>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 18px 26px; align-items: baseline; }
  .cloud-tag { font-weight: 400; }
  .cloud-tag sup { margin-left: 5px; font-size: 10px; opacity: .6; }
  @media (min-width: 1440px) {
    .tag-cloud { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--wide-gap); align-items: start; border-top: 1px solid var(--color-card-border); }
    .cloud-tag { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; min-width: 0; padding: 22px 10px 22px 0; border-bottom-color: var(--color-card-border); overflow-wrap: anywhere; }
    .cloud-tag sup { flex-shrink: 0; font-size: 11px; }
  }
</style>
