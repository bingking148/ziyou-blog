---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifyTaxonomy } from '../../utils/columns.ts';

const posts = await getCollection('post');
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const max = Math.max(...tags.map(([, c]) => c));
---

<Base title="标签" description="文章标签">
  <div class="tax-wrap" data-reveal>
    <h1 class="page-title">标签</h1>
    <div class="tag-cloud">
      {tags.map(([name, count]) => (
        <a
          class="cloud-tag"
          href={`/tags/${slugifyTaxonomy(name)}/`}
          style={`font-size: ${13 + (count / max) * 8}px`}
        >
          {name}<sup>{count}</sup>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .tax-wrap { max-width: 860px; margin: 0 auto; padding: 40px 0; }
  .page-title { margin: 0 0 28px; font-size: 34px; letter-spacing: 4px; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: baseline; }
  .cloud-tag {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    color: var(--red-1);
    transition: all 0.25s ease;
  }
  .cloud-tag:hover {
    background: var(--red-1);
    color: #fff;
    transform: translateY(-2px);
  }
  .cloud-tag sup { margin-left: 4px; font-size: 10px; opacity: 0.7; }
</style>
