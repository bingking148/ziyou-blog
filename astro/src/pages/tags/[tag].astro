---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { postUrl, slugifyTaxonomy } from '../../utils/columns.ts';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  const names = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) names.add(t);
  return [...names].map((name) => ({
    params: { tag: slugifyTaxonomy(name) },
    props: { name },
  }));
}

const { name } = Astro.props;
const posts = (await getCollection('post'))
  .filter((p) => p.data.tags.includes(name))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={`标签：${name}`} description={`标签「${name}」下的文章`}>
  <div class="ed-wrap">
    <PageHero index="07" label="TAG" title={`#${name}`} meta={[{ value: String(posts.length), label: '篇文章' }]} />
    <ol class="ed-list" data-reveal>
      {posts.map((p, i) => (
        <li>
          <a class="ed-row" href={postUrl(p)}>
            <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-title">{p.data.title}</span>
            <time class="row-meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  @media (max-width: 760px) {
    .ed-row .row-meta { display: none; }
  }
</style>
