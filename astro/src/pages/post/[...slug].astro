---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import PostNav from '../../components/PostNav.astro';
import Toc from '../../components/Toc.astro';
import AccentColor from '../../components/AccentColor.astro';
import MoodKnob from '../../components/MoodKnob.astro';
import { columnOf, columnPosts, postUrl, slugifyTaxonomy } from '../../utils/columns.ts';
import { AUTHOR, OUTDATE_DAYS, DEFAULT_COVER } from '../../consts.ts';

type Post = CollectionEntry<'post'>;

export async function getStaticPaths() {
  const posts = await getCollection('post');
  const columns = await getCollection('columns');
  const byDate = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return posts.map((post) => {
    // 前后篇导航：专栏文章只在专栏内按 weight 走；非专栏按全局日期
    const column = columnOf(post, columns);
    let prev: Post | undefined, next: Post | undefined;
    if (column) {
      const siblings = columnPosts(column, posts);
      const i = siblings.findIndex((p) => p.id === post.id);
      prev = siblings[i - 1];
      next = siblings[i + 1];
    } else {
      const i = byDate.findIndex((p) => p.id === post.id);
      prev = byDate[i + 1]; // 日期倒序：i+1 是更早的一篇
      next = byDate[i - 1];
    }
    return { params: { slug: post.id }, props: { post, column, prev, next } };
  });
}

const { post, column, prev, next } = Astro.props;
const { Content, headings } = await render(post);
// KaTeX 是否加载只看「正文里是否真有 $...$ 公式」，不再信任 frontmatter 的 math 开关
// —— 之前有文章标了 math:false 但正文里有 $-CH_3$，结果公式不渲染。
const bodyText = post.body ?? '';
const needsKatex =
  post.data.math ||
  /\$\$[\s\S]+?\$\$/.test(bodyText) ||
  /(^|[^\\$\d])\$[^$\n]+\$(?!\d)/m.test(bodyText);

const cover = post.data.cover || DEFAULT_COVER;
const url = postUrl(post);
const updated = post.data.updatedDate;
const isOutdated =
  Date.now() - (updated ?? post.data.date).getTime() > OUTDATE_DAYS * 86400_000;

// CJK 字数：非空白字符数；阅读时长按 300 字/分钟
const wordCount = (post.body ?? '').replace(/\s/g, '').length;
const readingMinutes = Math.max(1, Math.round(wordCount / 300));

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  cover={cover}
  pageClass="is-post"
  type="article"
  publishedTime={post.data.date}
  modifiedTime={updated}
  tags={post.data.tags}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: new URL(cover, Astro.site).href,
    datePublished: post.data.date.toISOString(),
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    author: { '@type': 'Person', name: AUTHOR },
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(url, Astro.site).href },
    keywords: post.data.tags.join(', '),
    wordCount: wordCount,
    inLanguage: 'zh-CN',
  }}
>
  {needsKatex && <link slot="head" rel="stylesheet" href="/resources/katex/katex.min.css" />}
  {post.data.comments && <link slot="head" rel="stylesheet" href="/resources/waline/waline.css" />}

  <!-- 移动端顶部细进度条（页边标尺在窄屏隐藏，这个是它的替代） -->
  <div class="mobile-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="mobile-progress-fill"></span>
  </div>

  <!-- 页边阅读标尺：只负责进度，章节跳转交给左侧目录 -->
  <div class="reading-ruler is-on-hero" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="ruler-readout"><output class="ruler-percent">00</output><span class="ruler-unit">%</span></div>
    <span class="ruler-caption">READ</span>
    <div class="ruler-scale" aria-hidden="true">
      <span class="ruler-fill"></span>
      <ol class="ruler-ticks">
        {Array.from({ length: 21 }, (_, i) => (
          <li class:list={{ 'is-major': i % 5 === 0 }}>
            {i % 5 === 0 && <span>{String(i * 5).padStart(2, '0')}</span>}
          </li>
        ))}
      </ol>
      <span class="ruler-cursor"></span>
    </div>
    <span class="ruler-end" aria-hidden="true">100 / END</span>
  </div>

  <article class="post-layout">
    <header id="header" class="post-hero">
      <div class="post-hero-media">
        <img class="post-cover" src={cover} alt={post.data.title} crossorigin="anonymous" fetchpriority="high" />
      </div>
      <div class="post-hero-shade" aria-hidden="true"></div>
      <div class="post-hero-content">
        <div class="post-kicker">
          <span>ZIYOU / {column ? 'SERIES' : 'ESSAY'}</span>
          <i></i>
          <span>{fmt(post.data.date).replaceAll('-', '.')}</span>
        </div>
        {column && (
          <a class="post-column-badge" href={`/categories/${slugifyTaxonomy(column.data.category)}/`}>
            {column.data.title}
          </a>
        )}
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-meta">
          <span>文 / {AUTHOR}</span>
          <span>{wordCount} 字</span>
          <span>约 {readingMinutes} 分钟</span>
          <span><span class="waline-pageview-count" data-path={url}>0</span> 次阅读</span>
          {updated && updated.getTime() !== post.data.date.getTime() && <span>更新于 {fmt(updated)}</span>}
        </div>
      </div>
      <div class="post-hero-foot" aria-hidden="true">
        <span>READING NOTES</span>
        <span class="hero-foot-line"></span>
        <span>SCROLL TO EXPLORE ↓</span>
      </div>
    </header>

    <div class="post-body-grid">
      <aside class="post-toc-aside">
        <div class="toc-sticky">
          <span class="sidebar-label">IN THIS ARTICLE</span>
          {post.data.toc && <Toc headings={headings} />}
        </div>
      </aside>

      <div class="post-main">
        {/* 移动端原生折叠目录：桌面 sticky 侧边栏在窄屏隐藏，这个是替代。
            details/summary 不需要 JS 也能开合；挂载时把内容从 aside 里的 ul 克隆过来。 */}
        {post.data.toc && headings.length > 0 && (
          <details class="mobile-toc">
            <summary>
              <span class="mobile-toc-label">目录</span>
              <span class="mobile-toc-caret" aria-hidden="true"></span>
            </summary>
            <ul class="mobile-toc-list">
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class={`mobile-toc-item mobile-toc-depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
            </ul>
          </details>
        )}

        {isOutdated && (
          <p class="outdate-warn">
            本文最后更新于 {fmt(updated ?? post.data.date)}，距今已超过 {OUTDATE_DAYS} 天，内容可能与现状有所出入。
          </p>
        )}

        <div class="post-inner">
          <div class="prose">
            <Content />
          </div>

          <script is:inline>
            /* 代码块包装：杂志式编辑排版 —— 顶部语言小标 + 行号 + 文字化复制按钮。
               无 JS 时仍是干净的代码卡片。 */
            (function () {
              var pres = document.querySelectorAll('.prose pre.astro-code');
              for (var i = 0; i < pres.length; i++) {
                var pre = pres[i];
                if (pre.closest('.code-shell')) continue;

                var shell = document.createElement('figure');
                shell.className = 'code-shell';

                /* 顶部：语言名（letter-spaced 小标） + 复制 */
                var bar = document.createElement('figcaption');
                bar.className = 'code-bar';
                var lang = document.createElement('span');
                lang.className = 'code-lang';
                lang.textContent = (pre.getAttribute('data-language') || 'CODE').toUpperCase();
                var copy = document.createElement('button');
                copy.className = 'code-copy';
                copy.type = 'button';
                copy.innerHTML = '<span class="copy-mark" aria-hidden="true">⧉</span><span class="copy-text">复制</span>';
                copy.setAttribute('aria-label', '复制代码');
                copy.addEventListener('click', function () {
                  var button = this;
                  var text = button.querySelector('.copy-text');
                  var code = button.closest('.code-shell').querySelector('pre code');
                  var done = function () {
                    text.textContent = '已复制';
                    button.classList.add('is-copied');
                    setTimeout(function () {
                      text.textContent = '复制';
                      button.classList.remove('is-copied');
                    }, 1600);
                  };
                  var fail = function () { text.textContent = '复制失败'; };
                  if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(code.innerText).then(done).catch(fail);
                  } else {
                    var helper = document.createElement('textarea');
                    helper.value = code.innerText;
                    helper.setAttribute('readonly', '');
                    helper.style.position = 'fixed';
                    helper.style.left = '-9999px';
                    document.body.appendChild(helper);
                    helper.select();
                    try {
                      if (!document.execCommand('copy')) throw new Error('copy failed');
                      done();
                    } catch (e) { fail(); }
                    document.body.removeChild(helper);
                  }
                });
                bar.appendChild(lang);
                bar.appendChild(copy);

                /* 行号：按物理行数生成 */
                var codeEl = pre.querySelector('code');
                var raw = codeEl ? codeEl.textContent : '';
                var lineCount = raw.replace(/\n$/, '').split('\n').length;
                if (lineCount > 1) {
                  var gutter = document.createElement('span');
                  gutter.className = 'code-gutter';
                  gutter.setAttribute('aria-hidden', 'true');
                  var nums = '';
                  for (var n = 1; n <= lineCount; n++) nums += n + '\n';
                  gutter.textContent = nums;
                  pre.insertBefore(gutter, pre.firstChild);
                  pre.classList.add('has-gutter');
                }

                pre.parentNode.insertBefore(shell, pre);
                shell.appendChild(bar);
                shell.appendChild(pre);
              }
            })();
          </script>

          <footer class="article-footer">
            <div class="post-tags">
              {post.data.tags.map((t) => (
                <a class="tag-chip" href={`/tags/${slugifyTaxonomy(t)}/`}>#{t}</a>
              ))}
            </div>
            <div class="article-copyright">
              <span class="copyright-mark" aria-hidden="true">©</span>
              <div>
                <p><strong>{post.data.title}</strong></p>
                <p>作者：{AUTHOR} · 发布于 {fmt(post.data.date)}</p>
                <p>本文链接：<a href={url}>{new URL(url, Astro.site)}</a></p>
                <p>采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" rel="license noopener">BY-NC-SA 4.0</a> 许可协议，转载请注明出处。</p>
              </div>
            </div>
          </footer>
        </div>

        <PostNav prev={prev} next={next} />

        {post.data.comments && <Comments path={url} />}
      </div>

      <aside class="post-mood-aside">
        <div class="mood-sticky">
          <span class="sidebar-label">SET THE MOOD</span>
          <MoodKnob />
        </div>
      </aside>
    </div>
  </article>

  <AccentColor />

  <script>
    (function () {
      'use strict';
      var article = document.querySelector('.post-main');
      var ruler = document.querySelector('.reading-ruler');
      var mprogress = document.querySelector('.mobile-progress');
      var hero = document.querySelector('.post-hero');
      if (!article) return;

      var fill = ruler && ruler.querySelector('.ruler-fill');
      var cursor = ruler && ruler.querySelector('.ruler-cursor');
      var percent = ruler && ruler.querySelector('.ruler-percent');
      var ticks = ruler ? Array.from(ruler.querySelectorAll('.ruler-ticks li')) : [];
      var mfill = mprogress && mprogress.querySelector('.mobile-progress-fill');
      var lastPct = -1;
      var ticking = false;
      var heroVisible = true;
      // 正文容器尺寸/位置缓存：图片异步加载会撑开高度，用 ResizeObserver 重新校准
      var articleTop = 0, articleHeight = 1;
      function measure() {
        var r = article.getBoundingClientRect();
        articleTop = r.top + window.scrollY;
        articleHeight = article.offsetHeight;
      }
      measure();

      // 封面是否还在视口里：决定标尺走白（hero 上）还是走墨（正文上）
      if (hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          heroVisible = entries[0].isIntersecting;
          if (ruler) ruler.classList.toggle('is-on-hero', heroVisible);
        }, { rootMargin: '-15% 0px 0px 0px' }).observe(hero);
      }

      function update() {
        ticking = false;
        var length = Math.max(1, articleHeight - window.innerHeight);
        var progress = Math.max(0, Math.min(1, (window.scrollY - articleTop) / length));
        var pct = Math.round(progress * 100);
        if (fill) {
          fill.style.height = (progress * 100) + '%';
          cursor.style.top = (progress * 100) + '%';
        }
        if (mfill) mfill.style.transform = 'scaleX(' + progress + ')';
        if (pct !== lastPct) {
          if (percent) percent.textContent = String(pct).padStart(2, '0');
          if (ruler) ruler.setAttribute('aria-valuenow', String(pct));
          if (mprogress) mprogress.setAttribute('aria-valuenow', String(pct));
          for (var i = 0; i < ticks.length; i++) {
            ticks[i].classList.toggle('is-read', i <= progress * (ticks.length - 1));
          }
          lastPct = pct;
        }
      }

      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      window.addEventListener('resize', function () { measure(); update(); });
      window.addEventListener('load', function () { measure(); update(); });
      if ('ResizeObserver' in window) {
        new ResizeObserver(function () { measure(); update(); }).observe(article);
      }
      update();
    })();
  </script>

  {/* SMIL/SVG 动画控制：
      1. prefers-reduced-motion 时直接 pauseAnimations()，让第一帧成为静止画面；
      2. 视口外的 SVG 暂停，回视口再恢复——既不烧 CPU 也不让用户看到「半路启动」的错乱；
      3. 没有 <title> 的 <svg> 补一个「动画示意图」 role/description，给屏幕阅读器一个最低限度的名字。 */}
  <script is:inline>
    (function () {
      'use strict';
      var svgs = document.querySelectorAll('.prose svg');
      if (!svgs.length) return;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      function hasAnimation(svg) {
        return !!(svg.querySelector('animate, animateTransform, animateMotion, set'));
      }
      function applyState(svg) {
        if (typeof svg.pauseAnimations !== 'function') return;
        if (reduced.matches) {
          svg.pauseAnimations();
          svg.setCurrentTime(0);
        } else if (svg.__inView !== false) {
          svg.unpauseAnimations();
        }
      }
      svgs.forEach(function (svg) {
        if (!hasAnimation(svg)) return;
        // a11y：没写 <title> 的动画 SVG 给一个通用名字，比沉默强
        if (!svg.querySelector('title')) {
          var t = document.createElementNS('http://www.w3.org/2000/svg', 'title');
          t.textContent = svg.getAttribute('aria-label') || '动画示意图';
          svg.insertBefore(t, svg.firstChild);
        }
        if (!svg.hasAttribute('role')) svg.setAttribute('role', 'img');
        svg.__inView = true;
        applyState(svg);
      });
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            var svg = en.target;
            svg.__inView = en.isIntersecting;
            if (typeof svg.pauseAnimations !== 'function') return;
            if (en.isIntersecting) {
              if (!reduced.matches) svg.unpauseAnimations();
            } else {
              svg.pauseAnimations();
            }
          });
        }, { rootMargin: '0px' });
        svgs.forEach(function (svg) { if (hasAnimation(svg)) io.observe(svg); });
      }
      reduced.addEventListener && reduced.addEventListener('change', function () {
        svgs.forEach(function (svg) { if (hasAnimation(svg)) applyState(svg); });
      });
    })();
  </script>

  {post.data.mermaid && (
    <script type="module">
      import mermaid from '/resources/mermaid/mermaid.min.js';
      const run = () => {
        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
        });
        mermaid.run({ querySelector: 'pre.mermaid:not([data-processed])' }).catch(function (err) {
          console.warn('Mermaid 渲染失败：', err);
          document.querySelectorAll('pre.mermaid:not([data-processed])').forEach(function (el) {
            el.setAttribute('data-mermaid-error', '图表渲染失败，已保留源代码');
          });
        });
      };
      run();
      new MutationObserver(run).observe(document.documentElement, {
        attributes: true, attributeFilter: ['data-theme'],
      });
    </script>
  )}
</Base>

<style>
  /* ============ 移动端顶部细进度条 ============ */
  .mobile-progress {
    display: none;
    position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 200;
    background: transparent;
    pointer-events: none;
  }
  .mobile-progress-fill {
    display: block; height: 100%; width: 100%;
    background: var(--color-accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @media (max-width: 1100px) { .mobile-progress { display: block; } }

  /* ============ 移动端原生折叠目录 ============ */
  .mobile-toc {
    display: none;
    margin: 0 0 32px;
    border: 1px solid var(--color-card-border);
    border-radius: 10px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .mobile-toc summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px; min-height: 44px;
    cursor: pointer; user-select: none;
    font-size: 13px; letter-spacing: .12em; color: var(--color-text-strong);
    list-style: none;
  }
  .mobile-toc summary::-webkit-details-marker { display: none; }
  .mobile-toc-caret {
    width: 8px; height: 8px;
    border-right: 1.5px solid var(--color-text-muted);
    border-bottom: 1.5px solid var(--color-text-muted);
    transform: rotate(45deg);
    transition: transform .25s ease;
  }
  .mobile-toc[open] .mobile-toc-caret { transform: rotate(225deg); }
  .mobile-toc-list {
    list-style: none; margin: 0; padding: 4px 16px 14px;
    max-height: 50vh; overflow-y: auto;
    border-top: 1px solid var(--color-card-border);
  }
  .mobile-toc-item { padding: 4px 0; }
  .mobile-toc-item a {
    display: block; padding: 6px 0;
    color: var(--color-text-muted); font-size: 13.5px; line-height: 1.55;
  }
  .mobile-toc-item a:hover { color: var(--color-link); }
  .mobile-toc-depth-3 a { padding-left: 16px; font-size: 13px; }
  @media (max-width: 1100px) { .mobile-toc { display: block; } }

  /* ============ 页边阅读标尺 ============
     像杂志页边的计量刻度，而不是悬浮的发光进度条。
     左侧走墨线、右侧读数；阅读时指针与数字同步，完成后翻成 FIN。 */
  .reading-ruler {
    --ruler-ink: var(--color-text-muted);
    --ruler-faint: color-mix(in srgb, var(--color-text-muted) 28%, transparent);
    position: fixed; z-index: 110;
    right: clamp(16px, 2.5vw, 40px); top: 50%;
    display: flex; flex-direction: column; align-items: flex-end; gap: 15px;
    color: var(--ruler-ink); pointer-events: none;
    transform: translateY(-50%);
  }
  .reading-ruler.is-on-hero { --ruler-ink: rgba(255,255,255,.72); --ruler-faint: rgba(255,255,255,.28); }
  .ruler-readout { display: flex; align-items: baseline; margin-right: -5px; color: var(--color-accent); font-family: var(--font-code); font-variant-numeric: tabular-nums; }
  .is-on-hero .ruler-readout { color: rgba(255,255,255,.94); }
  .ruler-percent { font-size: 25px; font-weight: 400; line-height: 1; letter-spacing: -.08em; }
  .ruler-unit { margin-left: 6px; font-size: 9px; }
  .ruler-caption { position: absolute; top: 12px; left: -25px; font-size: 7px; letter-spacing: .25em; writing-mode: vertical-rl; }
  .ruler-scale { position: relative; width: 38px; height: min(48vh, 430px); margin-right: 4px; }
  .ruler-scale::before, .ruler-fill { content: ''; position: absolute; top: 0; right: 0; width: 1px; height: 100%; background: var(--ruler-faint); }
  .ruler-fill { height: 0; background: var(--color-accent); }
  .is-on-hero .ruler-fill { background: rgba(255,255,255,.8); }
  .ruler-ticks { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .ruler-ticks li { position: absolute; right: 0; height: 1px; width: 4px; background: var(--ruler-faint); transition: width .2s, background .2s; }
  .ruler-ticks li:nth-child(1) { top: 0; } .ruler-ticks li:nth-child(2) { top: 5%; }
  .ruler-ticks li:nth-child(3) { top: 10%; } .ruler-ticks li:nth-child(4) { top: 15%; }
  .ruler-ticks li:nth-child(5) { top: 20%; } .ruler-ticks li:nth-child(6) { top: 25%; }
  .ruler-ticks li:nth-child(7) { top: 30%; } .ruler-ticks li:nth-child(8) { top: 35%; }
  .ruler-ticks li:nth-child(9) { top: 40%; } .ruler-ticks li:nth-child(10) { top: 45%; }
  .ruler-ticks li:nth-child(11) { top: 50%; } .ruler-ticks li:nth-child(12) { top: 55%; }
  .ruler-ticks li:nth-child(13) { top: 60%; } .ruler-ticks li:nth-child(14) { top: 65%; }
  .ruler-ticks li:nth-child(15) { top: 70%; } .ruler-ticks li:nth-child(16) { top: 75%; }
  .ruler-ticks li:nth-child(17) { top: 80%; } .ruler-ticks li:nth-child(18) { top: 85%; }
  .ruler-ticks li:nth-child(19) { top: 90%; } .ruler-ticks li:nth-child(20) { top: 95%; }
