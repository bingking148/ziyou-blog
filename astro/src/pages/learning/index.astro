---
import Base from '../../layouts/Base.astro';
import { UDL_CHAPTERS, UDL_META } from '../../data/udl/index.ts';

const main = UDL_CHAPTERS.filter((c) => c.num <= 21);
const appendix = UDL_CHAPTERS.filter((c) => c.num >= 22);
---

<Base title={`学习资料 · ${UDL_META.bookZh} 中英对照`} description={`${UDL_META.bookEn} 中英对照学习笔记`} pageClass="is-learning">
  <div class="learn">
    <div class="learn-wrap">
      <header class="hero">
        <span class="k">学 习 资 料</span>
        <h1>{UDL_META.bookZh}</h1>
        <p class="sub">{UDL_META.bookEn} · {UDL_META.author}</p>
        <p class="desc">边读边译的对照学习笔记：电脑端左右对照、手机端逐段上下对照，公式与插图按原书样式嵌入。</p>
        <div class="meta">
          <span>{UDL_CHAPTERS.length} 章</span>
          <span>中英对照</span>
          <span>CC BY-NC-ND · 学习笔记</span>
        </div>
        <hr />
      </header>

      <div class="chapters">
        <h3>正 文</h3>
        {main.map((c) => (
          <a class="row" href={`/learning/udl/${c.id}/`}>
            <span class="no">{String(c.num).padStart(2, '0')}</span>
            <span class="title">{c.zhTitle}<i>{c.enTitle}</i></span>
            <span class="meta2">{c.pages.length} 页</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}

        <h3>附 录</h3>
        {appendix.map((c) => (
          <a class="row" href={`/learning/udl/${c.id}/`}>
            <span class="no">{String(c.num).padStart(2, '0')}</span>
            <span class="title">{c.zhTitle}<i>{c.enTitle}</i></span>
            <span class="meta2">{c.pages.length} 页</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <style>
    .learn {
      --paper: var(--color-bg);
      --paper-deep: var(--color-surface-muted);
      --ink: var(--color-text-strong);
      --ink-soft: var(--color-text-muted);
      --ink-faint: var(--color-text-faint);
      --line: var(--color-card-border);
      --accent: var(--color-accent);
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-serif);
      min-height: 75vh;
    }
    .learn-wrap {
      max-width: 1440px; margin: 0 auto;
      padding: 44px clamp(20px, 4vw, 64px) 90px;
    }
    .hero { text-align: center; margin-bottom: 8px; }
    .k { font-size: 11px; letter-spacing: .35em; color: var(--ink-faint); }
    .hero h1 { font-size: clamp(26px, 3vw, 34px); margin: 12px 0 6px; letter-spacing: .1em; }
    .hero .sub { font-size: 13px; color: var(--ink-faint); font-style: italic; }
    .hero .desc { font-size: 13.5px; line-height: 2; color: var(--ink-soft); max-width: 640px; margin: 16px auto 0; }
    .meta { display: flex; justify-content: center; gap: 20px; margin-top: 16px; font-size: 12px; color: var(--ink-faint); flex-wrap: wrap; }
    .meta span { border: 1px solid var(--line); border-radius: 999px; padding: 4px 14px; }
    .hero hr { border: 0; border-top: 2px solid var(--ink); margin: 30px 0 6px; }
    .chapters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(36px, 4vw, 64px); margin-top: 14px; }
    .chapters h3 { grid-column: 1 / -1; font-size: 11px; letter-spacing: .3em; color: var(--ink-faint); margin: 26px 0 4px; font-weight: 400; }
    .row {
      display: flex; align-items: baseline; gap: 18px;
      padding: 20px 6px; border-bottom: 1px solid var(--line);
      color: var(--ink);
    }
    .row:hover { background: var(--paper-deep); }
    .no { font-size: 11px; color: var(--accent); letter-spacing: .1em; flex-shrink: 0; }
    .title { font-size: 17px; letter-spacing: .04em; color: var(--ink); }
    .title i { display: block; font-size: 12px; font-style: italic; color: var(--ink-faint); margin-top: 2px; }
    .meta2 { margin-left: auto; flex-shrink: 0; font-size: 12px; color: var(--ink-faint); }
    .arrow { color: var(--ink-faint); font-size: 14px; margin-left: 6px; transition: transform .25s; }
    .row:hover .arrow { transform: translateX(3px); color: var(--accent); }
    @media (max-width: 760px) {
      .learn-wrap { padding: 30px 18px 60px; }
      .chapters { grid-template-columns: 1fr; }
      .row { padding: 16px 2px; gap: 12px; flex-wrap: wrap; }
      .title { font-size: 16px; }
      .meta2 { margin-left: 0; width: 100%; font-size: 11.5px; }
      .meta { gap: 10px; }
      .meta span { font-size: 11px; padding: 3px 10px; }
    }
  </style>
</Base>
