---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { columnPosts, postUrl, slugifyTaxonomy } from '../utils/columns.ts';

const posts = await getCollection('post');
const columns = (await getCollection('columns')).sort((a, b) => a.data.order - b.data.order);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const num = (w?: number) => String(w ?? 0).padStart(2, '0');

// 专栏卡片统一形态：无论收录多少篇，都只展示前 5 行，缺的补空行占位，
// 保证每个专栏块高度一致，列表页节奏不被长专栏拉散。
const MAX_VISIBLE = 5;
---

<Base title="专栏" description="成系列的专题文章合集">
  <div class="ed-wrap ed-wrap--wide">
    <PageHero
      index="05"
      label="SERIES"
      title="专栏"
      lede="成系列的专题，按学习顺序编排，慢慢读完。"
      meta={[{ value: String(columns.length), label: '个专栏' }]}
    />

    {columns.map((c, ci) => {
      const list = columnPosts(c, posts);
      const visible = list.slice(0, MAX_VISIBLE);
      const rest = list.length - visible.length;
      const blanks = Math.max(0, MAX_VISIBLE - visible.length);
      const url = `/categories/${slugifyTaxonomy(c.data.category)}/`;
      return (
        <section class={`column-block column-block-${ci % 2}`} data-reveal>
          <a class="column-cover" href={url}>
            <ResponsiveImage src={c.data.cover} alt={c.data.title} sizes="(max-width: 760px) 100vw, 480px" loading="lazy" />
            <span class="column-badge">SERIES {num(ci + 1)}</span>
          </a>
          <div class="column-body">
            <h2 class="column-title"><a href={url}>{c.data.title}</a></h2>
            <p class="column-desc">{c.data.description}</p>
            <ol class="column-list">
              {visible.map((p) => (
                <li>
                  <a class="ed-row" href={postUrl(p)}>
                    <span class="row-no">{num(p.data.weight)}</span>
                    <span class="row-title">{p.data.title}</span>
                    <time class="row-meta" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                  </a>
                </li>
              ))}
              {Array.from({ length: blanks }).map(() => (
                <li class="row-blank" aria-hidden="true"></li>
              ))}
            </ol>
            <a class="column-more" href={url}>{rest > 0 ? `进入专栏 · 还有 ${rest} 篇` : '进入专栏'} <span>↗</span></a>
          </div>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .column-block {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    margin-bottom: 88px;
  }
  /* 手机端 1fr 轨道会被封面图固有宽度（响应式变体 ~548px）顶开造成横向溢出，
     grid 子项 min-width 归零后轨道才能收到视口内；图片自身也兜一层 max-width */
  .column-block > * { min-width: 0; }
  .column-cover img { max-width: 100%; }
  .column-block-1 { margin-left: 6%; }
  .column-cover { position: relative; display: block; overflow: hidden; aspect-ratio: 1.1; background: var(--red-4); }
  .column-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .column-cover:hover img { transform: scale(1.05); }
  .column-badge { position: absolute; left: 16px; bottom: 14px; font-size: 9px; letter-spacing: .3em; color: rgba(255,255,255,.9); text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  /* 标题/简介/列表都按固定行数占位：专栏之间只有内容差异，没有高度差异 */
  .column-title { margin: 0 0 12px; font-size: clamp(24px, 2.6vw, 32px); font-weight: 500; letter-spacing: .04em; line-height: 1.5; min-height: calc(2 * 1.5em); }
  .column-title a { color: var(--color-text-strong); }
  .column-title a:hover { color: var(--red-1); }
  .column-desc {
    margin: 0 0 24px; font-size: 14px; line-height: 1.9; color: var(--color-text-muted);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    min-height: calc(2 * 1.9em);
  }
  .column-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-card-border); }
  .column-list .ed-row { height: 54px; align-items: center; padding: 0 4px; }
  .column-list .row-title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-blank { height: 54px; border-bottom: 1px solid var(--color-card-border); }
  .column-more { display: inline-flex; align-items: center; gap: 12px; margin-top: 22px; padding-bottom: 6px; border-bottom: 1px solid var(--red-3); font-size: 13px; letter-spacing: .1em; color: var(--red-1); }
  .column-more:hover { border-color: var(--red-1); }
  .column-more span { transition: transform .3s ease; }
  .column-more:hover span { transform: translate(3px,-3px); }
  @media (min-width: 1440px) {
    /* 宽屏两列错峰：右列整体下沉一行距，随行距自然形成波浪，不再挤四列 */
    .ed-wrap--wide { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(40px, 4.5vw, 84px); row-gap: 112px; align-items: start; }
    .ed-wrap--wide > :global(.page-hero) { grid-column: 1 / -1; margin-bottom: 56px; }
    .column-block { display: flex; flex-direction: column; gap: 0; margin: 0; }
    .column-block-1 { margin-left: 0; margin-top: 112px; }
    .column-cover { aspect-ratio: 1.4; }
    .column-block:nth-child(3) .column-cover { aspect-ratio: 1.52; }
    .column-block:nth-child(4) .column-cover { aspect-ratio: 1.26; }
    .column-block:nth-child(5) .column-cover { aspect-ratio: 1.45; }
    .column-body { display: flex; flex: 1; flex-direction: column; padding-top: 28px; }
    .column-title { font-size: clamp(24px, 1.8vw, 32px); line-height: 1.5; min-height: calc(2 * 1.5em); }
    .column-desc { font-size: 14.5px; }
    .column-list { border-top: 1px solid var(--color-card-border); }
    .column-list .ed-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 14px; align-items: center; height: 58px; padding: 0; }
    .column-list .row-title { font-size: 15px; line-height: 1.7; }
    .column-list .row-meta { font-size: 10.5px; }
    .row-blank { height: 58px; }
    .column-more { align-self: flex-start; margin-top: auto; padding-top: 28px; }
  }
  @media (max-width: 900px) {
    .column-block { grid-template-columns: 1fr; gap: 24px; margin-bottom: 64px; }
    .column-block-1 { margin-left: 0; }
    .column-cover { aspect-ratio: 1.8; }
    .column-list .row-meta { display: none; }
  }
</style>
