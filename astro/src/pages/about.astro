---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChapterRule from '../components/ChapterRule.astro';
import { AUTHOR, SITE_DESCRIPTION, SINCE, SOCIAL } from '../consts.ts';

const posts = await getCollection('post');
const columns = await getCollection('columns');

// 与文章页同算法：非空白字符数
const totalWords = posts.reduce((n, p) => n + (p.body ?? '').replace(/\s/g, '').length, 0);
const sorted = [...posts].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const first = sorted[0].data.date;
const last = sorted[sorted.length - 1].data.date;
const monthSpan = (last.getFullYear() - first.getFullYear()) * 12 + (last.getMonth() - first.getMonth()) + 1;

// 月度节奏：从最早一篇所在月到最新一篇所在月逐月分桶，空月保留
const buckets: { key: string; label: string; count: number }[] = [];
for (let i = 0; i < monthSpan; i++) {
  const d = new Date(first.getFullYear(), first.getMonth() + i, 1);
  buckets.push({
    key: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`,
    label: `${String(d.getFullYear()).slice(2)}.${String(d.getMonth() + 1).padStart(2, '0')}`,
    count: 0,
  });
}
for (const p of posts) {
  const key = `${p.data.date.getFullYear()}-${String(p.data.date.getMonth() + 1).padStart(2, '0')}`;
  const b = buckets.find((x) => x.key === key);
  if (b) b.count++;
}
const maxCount = Math.max(...buckets.map((b) => b.count));
const peakMonth = buckets.find((b) => b.count === maxCount);

const techGroups = [
  { name: '编程语言', en: 'LANGUAGES', items: [
    { name: 'Python', color: '#3776ab' },
    { name: 'JavaScript', color: '#d4b106' },
    { name: 'TypeScript', color: '#3178c6' },
    { name: 'Java', color: '#b07219' },
    { name: 'C++', color: '#00599c' },
  ]},
  { name: '前端', en: 'FRONTEND', items: [
    { name: 'HTML', color: '#e34c26' },
    { name: 'CSS', color: '#1572b6' },
    { name: 'React', color: '#61daf7' },
    { name: 'Vue', color: '#42b883' },
  ]},
  { name: '后端与数据库', en: 'BACKEND', items: [
    { name: 'Spring Boot', color: '#6db33f' },
    { name: 'MySQL', color: '#4479a1' },
    { name: 'Redis', color: '#dc382d' },
  ]},
  { name: '工具与平台', en: 'TOOLS', items: [
    { name: 'Git', color: '#f05032' },
    { name: 'Docker', color: '#2496ed' },
    { name: 'Linux', color: '#8a94a6' },
  ]},
];

const hobbies = ['写代码，也写那些代码解释不了的问题', '折腾各种技术，踩坑然后记下来', '把学到的东西讲清楚'];
---

<Base title="关于" description={`关于 ${AUTHOR}：${SITE_DESCRIPTION}`}>
  <div class="ed-wrap ed-wrap--wide about-page">
    <ChapterRule no="01" label="档案" en="DOSSIER" value={`EST. ${SINCE}`} />

    <!-- 档案卷宗 -->
    <section class="dossier" data-reveal style="--i:1" aria-label="站主档案">
      <span class="dos-tab">FILE NO. 001 · OPEN</span>
      <span class="dos-seal" aria-hidden="true">自由</span>

      <dl class="dos-form">
        <div><dt>姓名 NAME</dt><dd>{AUTHOR}</dd></div>
        <div><dt>坐标 SITE</dt><dd>ziyou814.top<small>EST. {SINCE}</small></dd></div>
        <div class="wide"><dt>站训 MOTTO</dt><dd>在键盘上，<em>写下又一行注释</em>。</dd></div>
        <div class="wide"><dt>导语 NOTE</dt><dd>不追热点，只记录真正想明白的事——技术笔记、学习心得，和代码解释不了的问题。</dd></div>
      </dl>

      <dl class="dos-metrics" aria-label="写作数据">
        <div class="metric"><dt>文章</dt><dd>{posts.length}</dd></div>
        <div class="metric"><dt>总字数</dt><dd>{(totalWords / 10000).toFixed(1)}<small>万</small></dd></div>
        <div class="metric"><dt>专栏</dt><dd>{columns.length}</dd></div>
        <div class="metric"><dt>写作月</dt><dd>{monthSpan}</dd></div>
      </dl>

      <div class="dos-rhythm">
        <div
          class="rhythm-chart"
          role="img"
          aria-label={`月度写作篇数：${buckets.map((b) => `${b.label} 月 ${b.count} 篇`).join('，')}`}
        >
          {buckets.map((b) => (
            <div class:list={['rhythm-col', { 'is-peak': b.count === maxCount, 'is-empty': b.count === 0 }]}>
              <span class="rhythm-count">{b.count > 0 ? b.count : ''}</span>
              <span class="rhythm-bar" style={`height:${b.count === 0 ? 2 : Math.max(6, (b.count / maxCount) * 100)}%`}></span>
              <span class="rhythm-month">{b.label}</span>
            </div>
          ))}
        </div>
        <p class="rhythm-note">写作节奏 · 空白月是<b>真实的停笔</b><br />{peakMonth.label} 最多 {maxCount} 篇</p>
      </div>
    </section>

    <!-- 技术栈 -->
    <section class="about-section" data-reveal>
      <h2 class="sec-k"><b>TOOLBOX</b>趁手的工具 · FILE ENTRIES</h2>
      <div class="tech-grid">
        {techGroups.map((g) => (
          <div class="tech-group">
            <h3>{g.name}<span>{g.en}</span></h3>
            <ul>
              {g.items.map((t) => (
                <li><span class="tech-dot" style={`--tech-color:${t.color}`}></span>{t.name}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 兴趣与联系 -->
    <div class="about-lower">
      <section class="about-section" data-reveal>
        <h2 class="sec-k"><b>INTERESTS</b>平时在做</h2>
        <ol class="ledger">
          {hobbies.map((h, i) => (
            <li><span class="no">0{i + 1}</span>{h}</li>
          ))}
        </ol>
      </section>

      <section class="about-section" data-reveal>
        <h2 class="sec-k"><b>CONTACT</b>找到我</h2>
        <div class="contact">
          <span><span class="k">QQ</span><span class="v">1605726649</span></span>
          <span><span class="k">WECHAT</span><span class="v">18239772567</span></span>
          <a href={SOCIAL.github} target="_blank" rel="noopener"><span class="k">GITHUB</span><span class="v">github.com/bingking148 ↗</span></a>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .about-page { --hard: #102434; --band: #102434; --band-text: #eef5f7; --band-muted: #9db4cf; --band-line: rgba(216, 236, 242, .16); }
  :global([data-theme="dark"]) .about-page { --hard: rgba(0, 0, 0, .55); --band: #0c1520; }

  /* 卷宗卡 */
  .dossier {
    position: relative;
    margin-top: 46px;
    background: var(--color-surface);
    border: 1px solid var(--color-card-border);
    box-shadow: 13px 15px 0 var(--hard);
    transform: rotate(-.35deg);
    padding: 34px 0 0;
  }
  .dos-tab {
    position: absolute; left: -1px; top: -30px;
    padding: 8px 16px 7px;
    background: var(--color-text-strong); color: var(--color-bg);
    font-family: var(--font-code); font-size: 10px; letter-spacing: .22em;
  }
  .dos-seal {
    position: absolute; right: 22px; top: 22px;
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: 10px 0 8px; width: 52px;
    border: 1.5px solid var(--color-accent); color: var(--color-accent);
    font-family: var(--font-serif); font-size: 21px; line-height: 1.15;
    writing-mode: vertical-rl; letter-spacing: .1em;
    transform: rotate(-7deg); opacity: .9;
    animation: seal-in .5s cubic-bezier(.2, .8, .3, 1.4) .7s both;
  }
  @keyframes seal-in { from { transform: rotate(-7deg) scale(1.55); opacity: 0; } }

  /* 登记表 */
  .dos-form { margin: 0; padding: 0 34px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 34px; }
  .dos-form > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 15px 0; border-top: 1px solid var(--color-card-border); }
  .dos-form > div:nth-child(-n + 2) { border-top: 0; }
  .dos-form > div.wide { grid-column: 1 / -1; }
  .dos-form dt { margin: 0; font-family: var(--font-code); font-size: 10px; letter-spacing: .18em; color: var(--color-text-muted); }
  .dos-form dd { margin: 0; font-family: var(--font-serif); font-size: 22px; line-height: 1.5; color: var(--color-text-strong); }
  .dos-form dd small { font-size: .45em; color: var(--color-text-muted); margin-left: 12px; letter-spacing: .08em; }
  .dos-form dd em { font-style: normal; color: var(--color-accent); box-shadow: inset 0 -.24em 0 color-mix(in srgb, var(--color-accent) 16%, transparent); }

  /* 指标带 */
  .dos-metrics {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    margin: 20px 0 0; padding: 20px 34px;
    border-top: 1px solid var(--color-text-strong);
    background: var(--band); color: var(--band-text);
  }
  .metric dt { font-size: 10px; letter-spacing: .22em; color: var(--band-muted); margin-bottom: 8px; }
  .metric dd { margin: 0; font-family: var(--font-article); font-weight: 800; font-size: clamp(30px, 3vw, 44px); line-height: 1; }
  .metric dd small { font-size: .4em; font-weight: 600; opacity: .7; margin-left: 4px; }

  /* 写作节奏 */
  .dos-rhythm { display: flex; align-items: flex-end; gap: 28px; padding: 22px 34px 26px; }
  .rhythm-chart { flex: 1; display: flex; align-items: stretch; gap: 12px; height: 132px; }
  .rhythm-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8px; min-width: 0; }
  .rhythm-count { font-family: var(--font-code); font-size: 11px; color: var(--color-text-muted); height: 14px; }
  .rhythm-bar { width: 9px; max-width: 100%; background: var(--red-2); }
  .rhythm-col.is-peak .rhythm-bar { background: var(--color-accent); }
  .is-empty .rhythm-bar { width: 100%; max-width: 26px; background: color-mix(in srgb, var(--color-text-faint) 22%, transparent); }
  .rhythm-month { font-family: var(--font-code); font-size: 9.5px; letter-spacing: .04em; color: var(--color-text-faint); }
  .rhythm-note { margin: 0; font-size: 12px; line-height: 1.9; color: var(--color-text-muted); max-width: 168px; }
  .rhythm-note b { color: var(--color-accent); font-weight: 500; }

  /* 其余区块 */
  .about-section { margin: 72px 0 0; }
  .sec-k { display: flex; align-items: baseline; gap: 14px; margin: 0 0 26px; font-family: var(--font-serif); font-size: 25px; font-weight: 500; letter-spacing: .04em; color: var(--color-text-strong); }
  .sec-k b { font-family: var(--font-code); font-size: 10px; letter-spacing: .26em; color: var(--color-accent); font-weight: 700; }

  .tech-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .tech-group { padding-left: 20px; border-left: 1px solid var(--color-card-border); }
  .tech-group:first-child { padding-left: 0; border-left: none; }
  .tech-group h3 { display: flex; flex-direction: column; gap: 6px; margin: 0 0 16px; font-size: 15px; font-weight: 500; color: var(--color-text-strong); }
  .tech-group h3 span { font-family: var(--font-code); font-size: 9px; letter-spacing: .24em; color: var(--color-text-muted); }
  .tech-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tech-group li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--color-text); }
  .tech-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: var(--tech-color, var(--red-1)); }

  .about-lower { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: 40px; }
  .ledger { list-style: none; margin: 0; padding: 0; }
  .ledger li { display: flex; gap: 18px; align-items: baseline; padding: 15px 0; border-top: 1px solid var(--color-card-border); font-family: var(--font-serif); font-size: 17px; color: var(--color-text-strong); }
  .ledger li:first-child { border-top: 0; padding-top: 0; }
  .ledger .no { font-family: var(--font-code); font-size: 11px; color: var(--color-accent); }

  .contact { display: flex; flex-direction: column; gap: 8px; }
  .contact span, .contact a {
    display: flex; align-items: baseline; gap: 14px;
    padding: 13px 0; border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 32%, transparent);
  }
  .contact .k { font-family: var(--font-code); font-size: 10px; letter-spacing: .16em; color: var(--color-accent); min-width: 72px; }
  .contact .v { font-family: var(--font-code); font-size: 17px; letter-spacing: .02em; color: var(--color-text-strong); }
  .contact a:hover .v { color: var(--color-accent); }

  @media (min-width: 1440px) {
    .dossier { margin-top: 58px; padding-top: 40px; }
    .dos-form { padding: 0 44px; column-gap: 44px; }
    .dos-form dd { font-size: 25px; }
    .dos-metrics { padding: 24px 44px; margin-top: 24px; }
    .dos-rhythm { padding: 26px 44px 30px; }
    .rhythm-chart { height: 148px; }
    .about-lower { gap: var(--wide-gap); }
    .tech-grid { gap: var(--wide-gap); }
  }
  @media (max-width: 760px) {
    .dossier { margin-top: 34px; padding-top: 26px; box-shadow: 7px 8px 0 var(--hard); transform: rotate(-.5deg); }
    .dos-tab { top: -27px; padding: 7px 12px 6px; }
    .dos-seal { width: 44px; font-size: 18px; right: 14px; top: 14px; padding: 8px 0 6px; }
    .dos-form { grid-template-columns: 1fr; padding: 0 20px; }
    .dos-form > div, .dos-form > div.wide { grid-column: 1; }
    .dos-form > div:nth-child(2) { border-top: 1px solid var(--color-card-border); }
    .dos-form > div { grid-template-columns: 80px minmax(0, 1fr); gap: 12px; padding: 12px 0; }
    .dos-form dd { font-size: 19px; }
    .dos-metrics { grid-template-columns: 1fr 1fr; gap: 16px 12px; padding: 18px 20px; }
    .metric dd { font-size: 26px; }
    .dos-rhythm { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px 20px 20px; }
    .rhythm-chart { gap: 6px; height: 104px; }
    .rhythm-month { font-size: 8.5px; }
    .rhythm-note { max-width: none; }
    .about-section { margin-top: 56px; }
    .sec-k { font-size: 21px; }
    .tech-grid { grid-template-columns: 1fr 1fr; gap: 30px 18px; }
    .tech-group:nth-child(3) { padding-left: 0; border-left: none; }
    .about-lower { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dos-seal { animation: none; }
  }
</style>
