---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts.ts';

const posts = await getCollection('post');
const columns = await getCollection('columns');

// 与文章页同算法：非空白字符数
const totalWords = posts.reduce((n, p) => n + (p.body ?? '').replace(/\s/g, '').length, 0);
const sorted = [...posts].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const first = sorted[0].data.date;
const last = sorted[sorted.length - 1].data.date;
const monthSpan = (last.getFullYear() - first.getFullYear()) * 12 + (last.getMonth() - first.getMonth()) + 1;

// 月度节奏：从最早一篇所在月到最新一篇所在月逐月分桶，空月保留
const buckets: { key: string; label: string; count: number }[] = [];
for (let i = 0; i < monthSpan; i++) {
  const d = new Date(first.getFullYear(), first.getMonth() + i, 1);
  buckets.push({
    key: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`,
    label: `${String(d.getFullYear()).slice(2)}.${String(d.getMonth() + 1).padStart(2, '0')}`,
    count: 0,
  });
}
for (const p of posts) {
  const key = `${p.data.date.getFullYear()}-${String(p.data.date.getMonth() + 1).padStart(2, '0')}`;
  const b = buckets.find((x) => x.key === key);
  if (b) b.count++;
}
const maxCount = Math.max(...buckets.map((b) => b.count));

const techGroups = [
  { name: '编程语言', en: 'LANGUAGES', items: [
    { name: 'Python', color: '#3776ab' },
    { name: 'JavaScript', color: '#d4b106' },
    { name: 'TypeScript', color: '#3178c6' },
    { name: 'Java', color: '#b07219' },
    { name: 'C++', color: '#00599c' },
  ]},
  { name: '前端', en: 'FRONTEND', items: [
    { name: 'HTML', color: '#e34c26' },
    { name: 'CSS', color: '#1572b6' },
    { name: 'React', color: '#61daf7' },
    { name: 'Vue', color: '#42b883' },
  ]},
  { name: '后端与数据库', en: 'BACKEND', items: [
    { name: 'Spring Boot', color: '#6db33f' },
    { name: 'MySQL', color: '#4479a1' },
    { name: 'Redis', color: '#dc382d' },
  ]},
  { name: '工具与平台', en: 'TOOLS', items: [
    { name: 'Git', color: '#f05032' },
    { name: 'Docker', color: '#2496ed' },
    { name: 'Linux', color: '#8a94a6' },
  ]},
];

const hobbies = ['写代码，也写那些代码解释不了的问题', '折腾各种技术，踩坑然后记下来', '把学到的东西讲清楚'];
---

<Base title="关于" description={`关于 ${AUTHOR}：${SITE_DESCRIPTION}`}>
  <div class="ed-wrap">
    <PageHero index="01" label="ABOUT" title="关于" lede="一个仍在学习的人，和一块留给好奇心的地方。" />

    <!-- 自述 -->
    <section class="about-intro" data-reveal>
      <p class="about-lead">
        我是 {AUTHOR}。这里不追热点，只记录那些<span>真正想明白的事</span>——
        技术笔记、学习心得，和一些代码解释不了的问题。
      </p>
      <p class="about-sub">写代码出 BUG，折腾各种技术，再把踩过的坑讲清楚。如果这些文字对你有用，欢迎常来。</p>
    </section>

    <!-- 写作数据 -->
    <section class="stats-band" data-reveal aria-label="写作数据">
      <div class="stats-grid">
        <div class="stat"><span class="stat-num">{posts.length}</span><span class="stat-label">ARTICLES / 文章</span></div>
        <div class="stat"><span class="stat-num">{(totalWords / 10000).toFixed(1)}<small>万</small></span><span class="stat-label">WORDS / 总字数</span></div>
        <div class="stat"><span class="stat-num">{columns.length}</span><span class="stat-label">SERIES / 专栏</span></div>
        <div class="stat"><span class="stat-num">{monthSpan}</span><span class="stat-label">MONTHS / 写作月</span></div>
      </div>
      <div class="rhythm">
        <div class="rhythm-head">
          <span class="rhythm-title">写作节奏</span>
          <span class="rhythm-note">按月统计 · 空白月份是真实的停笔</span>
        </div>
        <div class="rhythm-chart" role="img" aria-label={`月度写作篇数：${buckets.map((b) => `${b.label} 月 ${b.count} 篇`).join('，')}`}>
          {buckets.map((b) => (
            <div class="rhythm-col">
              <span class="rhythm-count">{b.count > 0 ? b.count : ''}</span>
              <span
                class:list={['rhythm-bar', { 'is-peak': b.count === maxCount, 'is-empty': b.count === 0 }]}
                style={`height:${b.count === 0 ? 2 : Math.max(6, (b.count / maxCount) * 100)}%`}
              ></span>
              <span class="rhythm-month">{b.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 技术栈 -->
    <section class="about-section" data-reveal>
      <h2 class="section-title"><span class="ed-label">TOOLBOX</span>趁手的工具</h2>
      <div class="tech-grid">
        {techGroups.map((g) => (
          <div class="tech-group">
            <h3>{g.name}<span>{g.en}</span></h3>
            <ul>
              {g.items.map((t) => (
                <li><span class="tech-dot" style={`--tech-color:${t.color}`}></span>{t.name}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 兴趣 -->
    <section class="about-section" data-reveal>
      <h2 class="section-title"><span class="ed-label">INTERESTS</span>平时在做</h2>
      <ol class="ed-list">
        {hobbies.map((h, i) => (
          <li class="ed-row">
            <span class="row-no">0{i + 1}</span>
            <span class="row-title">{h}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 联系 -->
    <section class="about-section about-contact" data-reveal>
      <h2 class="section-title"><span class="ed-label">CONTACT</span>找到我</h2>
      <div class="contact-links">
        <span class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.003 2c-2.265 0-6.29 1.364-6.29 7.325v1.195S3.55 14.96 3.55 17.474c0 .665.17 1.025.281 1.025.114 0 .902-.484 1.748-2.072 0 0-.18 2.197 1.904 3.967 0 0-1.77.495-1.77 1.182 0 .686 4.078.43 6.29.43 2.21 0 6.287.257 6.287-.43 0-.687-1.768-1.182-1.768-1.182 2.085-1.77 1.905-3.967 1.905-3.967.845 1.588 1.634 2.072 1.746 2.072.111 0 .283-.36.283-1.025 0-2.514-2.166-6.954-2.166-6.954V9.325C18.29 3.364 14.268 2 12.003 2z"/></svg>
          <span class="contact-name">QQ</span>
          <span class="contact-value">1605726649</span>
        </span>
        <span class="contact-item">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.032zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.969-.982z"/></svg>
          <span class="contact-name">微信</span>
          <span class="contact-value">18239772567</span>
        </span>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-intro { padding: 40px 0 64px; }
  .about-lead {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.95;
    letter-spacing: .03em;
    color: var(--color-text-strong);
  }
  .about-lead span { color: var(--red-1); box-shadow: inset 0 -.3em 0 var(--red-4); }
  .about-sub { max-width: 560px; margin: 0; font-size: 14px; line-height: 1.95; color: var(--color-text-muted); }

  /* 写作数据带 */
  .stats-band {
    background: #17202c;
    color: #fff;
    padding: 48px clamp(24px, 4vw, 56px) 36px;
    margin-bottom: 80px;
  }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { display: flex; flex-direction: column; gap: 12px; padding-left: 24px; border-left: 1px solid rgba(255,255,255,.16); }
  .stat:first-child { padding-left: 0; border-left: none; }
  .stat-num { font-family: var(--font-serif); font-size: clamp(34px, 4vw, 52px); line-height: 1; }
  .stat-num small { font-size: .4em; margin-left: 4px; opacity: .7; }
  .stat-label { font-size: 9px; letter-spacing: .22em; color: rgba(255,255,255,.55); }
  .rhythm { margin-top: 44px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,.14); }
  .rhythm-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .rhythm-title { font-size: 13px; letter-spacing: .2em; }
  .rhythm-note { font-size: 11px; color: rgba(255,255,255,.45); }
  .rhythm-chart { display: flex; align-items: stretch; gap: 10px; height: 120px; }
  .rhythm-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8px; min-width: 0; }
  .rhythm-count { font-size: 11px; color: rgba(255,255,255,.65); height: 14px; }
  .rhythm-bar { width: 8px; max-width: 100%; background: var(--red-2); }
  .rhythm-bar.is-peak { background: #d98063; }
  .rhythm-bar.is-empty { width: 100%; max-width: 28px; background: rgba(255,255,255,.18); }
  .rhythm-month { font-size: 10px; letter-spacing: .08em; color: rgba(255,255,255,.5); }

  .about-section { margin-bottom: 72px; }
  .section-title { display: flex; align-items: baseline; gap: 18px; margin: 0 0 28px; font-size: 26px; font-weight: 500; letter-spacing: .04em; }
  .section-title .ed-label { flex-shrink: 0; }

  .tech-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .tech-group { padding-left: 20px; border-left: 1px solid var(--color-card-border); }
  .tech-group:first-child { padding-left: 0; border-left: none; }
  .tech-group h3 { display: flex; flex-direction: column; gap: 6px; margin: 0 0 16px; font-size: 15px; font-weight: 500; color: var(--color-text-strong); }
  .tech-group h3 span { font-size: 9px; letter-spacing: .24em; color: var(--color-text-muted); }
  .tech-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tech-group li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--color-text); }
  .tech-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: var(--tech-color, var(--red-1)); }

  .about-contact { margin-bottom: 0; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 24px 48px; }
  .contact-item {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--red-3);
    color: var(--red-1);
  }
  .contact-item svg { align-self: center; flex-shrink: 0; }
  .contact-name { font-size: 13px; letter-spacing: .1em; color: var(--color-text-muted); }
  .contact-value { font-family: var(--font-code); font-size: 20px; letter-spacing: .04em; color: var(--color-text-strong); }

  @media (max-width: 760px) {
    .about-intro { padding: 24px 0 48px; }
    .stats-band { padding: 32px 24px 24px; margin-bottom: 56px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 24px 0; }
    .stat:nth-child(3) { padding-left: 0; border-left: none; }
    .rhythm-chart { gap: 6px; height: 100px; }
    .rhythm-note { display: none; }
    .tech-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 20px; }
    .tech-group:nth-child(3) { padding-left: 0; border-left: none; }
    .about-section { margin-bottom: 56px; }
    .section-title { font-size: 22px; gap: 12px; }
  }
</style>
