---
import Base from '../layouts/Base.astro';
---

<Base title="页面走丢了" noindex>
  <div class="ed-wrap ed-wrap--wide nf-wrap" data-reveal>
    <span class="ed-label">找不到这一页</span>
    <p class="nf-code">404</p>
    <h1 class="nf-title">这一页不存在</h1>
    <p class="nf-desc">链接可能已过期，或者内容被移动了。不如换个地方继续读。</p>
    <div class="nf-actions">
      <a class="ed-tag" href="/">回到首页 ↗</a>
      <a class="ed-tag" href="/archives/">看看归档 ↗</a>
      <a class="ed-tag" href="/search/">试试搜索 ↗</a>
    </div>
  </div>
</Base>

<style>
  .nf-wrap { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; padding-top: 40px; }
  .nf-code {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(96px, 18vw, 180px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: .04em;
    background: linear-gradient(135deg, var(--red-1), var(--red-2) 60%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf-title { margin: 16px 0 10px; font-size: 26px; font-weight: 500; }
  .nf-desc { margin: 0 0 32px; font-size: 14px; color: var(--color-text-muted); }
  .nf-actions { display: flex; gap: 28px; flex-wrap: wrap; }
  @media (min-width: 1440px) {
    .nf-wrap { display: grid; grid-template-columns: minmax(180px, .55fr) minmax(0, 1.3fr); grid-template-rows: auto auto auto auto; gap: 0 var(--wide-gap); align-content: center; min-height: 78vh; }
    .nf-wrap > .ed-label { grid-column: 1; grid-row: 1; align-self: start; margin-top: 26px; }
    .nf-code { grid-column: 1; grid-row: 2 / 5; align-self: start; margin-top: 40px; font-size: clamp(150px, 16vw, 300px); }
    .nf-title { grid-column: 2; grid-row: 2; margin: 30px 0 20px; font-size: clamp(38px, 4vw, 64px); }
    .nf-desc { grid-column: 2; grid-row: 3; max-width: 540px; font-size: 16px; line-height: 1.95; }
    .nf-actions { grid-column: 2; grid-row: 4; }
  }
</style>
