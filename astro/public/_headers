# Cloudflare Pages 响应头
# 语法见 https://developers.cloudflare.com/pages/configuration/headers/
# 原则：带内容哈希的静态资产长期 immutable；HTML、固定名资源走短缓存便于快速更新。

# Astro 打包产物：文件名带 hash，可永久缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 图片优化产物：脚本生成、文件名带内容哈希
/images/optimized/*
  Cache-Control: public, max-age=31536000, immutable

# 原图（cover/hero 等固定名）：内容会随文章更新替换，1 小时缓存 + 后台 stale-while-revalidate
/images/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# vendored 第三方资源：路径里带版本号（如 waline@3.x），长期缓存但不 immutable
# —— 因为同一路径将来可能替换成新版本；让用户每年回源一次足够
/resources/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# HTML：必须每次回源校验，否则用户拿不到新文章
# （Pages 默认就是 no-cache，但显式声明防止意外）
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 站点根路径（首页）
/
  Cache-Control: public, max-age=0, must-revalidate

# 搜索索引、RSS、站点地图：常更新但允许短缓存
/search.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/index.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/sitemap-*.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
