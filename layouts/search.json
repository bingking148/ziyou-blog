{{- /* 本地搜索索引：标题/简介/标签/正文（截断），供 /search 页面的 fuse.js + 子串匹配使用 */ -}}
{{- $pages := where site.RegularPages "Type" "in" site.Params.mainSections -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "title": {{ $p.Title | jsonify }},
    "permalink": {{ $p.RelPermalink | jsonify }},
    "description": {{ $p.Params.description | default "" | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
    "tags": {{ $p.Params.tags | default slice | jsonify }},
    "categories": {{ $p.Params.categories | default slice | jsonify }},
    "content": {{ $p.Plain | chomp | truncate 4000 | jsonify }}
  }
{{- end -}}
]
